+void frond_rfcomm_stream_enable(struct bthost *bthost, uint8_t channel,
+				void (*disc)(uint16_t handle, uint16_t cid))
+{
+	bthost->stream_channel = channel;
+	bthost->stream_disc = disc;
+}
+
+static struct l2conn *rfcomm_stream_link(struct bthost *bthost,
+					uint16_t handle, uint16_t cid)
+{
+	struct btconn *conn = bthost_find_conn(bthost, handle);
+	struct l2conn *link = conn ? btconn_find_l2cap_conn_by_scid(conn, cid) : NULL;
+
+	return link && link->psm == 3 && link->rfcomm_stream.open ? link : NULL;
+}
+
+size_t frond_rfcomm_stream_space(struct bthost *bthost, uint16_t handle, uint16_t cid)
+{
+	struct l2conn *link = rfcomm_stream_link(bthost, handle, cid);
+
+	if (!link || (link->rfcomm_stream.credit_mode && !link->rfcomm_stream.credits))
+		return 0;
+	return link->rfcomm_stream.mtu ? link->rfcomm_stream.mtu : 127;
+}
+
+static void rfcomm_stream_frame(struct bthost *bthost, uint16_t handle,
+				struct l2conn *link, const void *data,
+				uint16_t len, bool grant_credit)
+{
+	uint8_t frame[FROND_RFCOMM_MAX_FRAME + 5];
+	size_t pos = 0;
+
+	frame[pos++] = RFCOMM_ADDR(0, bthost->stream_channel * 2);
+	frame[pos++] = RFCOMM_CTRL(RFCOMM_UIH, grant_credit);
+	frame[pos++] = len > 127 ? RFCOMM_LEN16(len) : RFCOMM_LEN8(len);
+	if (len > 127)
+		frame[pos++] = len >> 7;
+	if (grant_credit)
+		frame[pos++] = 1;
+	else {
+		memcpy(frame + pos, data, len);
+		pos += len;
+	}
+	frame[pos++] = rfcomm_fcs(frame);
+	send_acl(bthost, handle, link->dcid, 0, frame, pos);
+}
+
+bool frond_rfcomm_stream_send(struct bthost *bthost, uint16_t handle, uint16_t cid,
+				const void *data, uint16_t len)
+{
+	struct l2conn *link = rfcomm_stream_link(bthost, handle, cid);
+
+	if (!len || len > frond_rfcomm_stream_space(bthost, handle, cid))
+		return false;
+	if (link->rfcomm_stream.credit_mode)
+		link->rfcomm_stream.credits--;
+	rfcomm_stream_frame(bthost, handle, link, data, len, false);
+	return true;
 }
 
