+
+static bool client_flush(struct client *client)
+{
+	while (client->tx_offset < client->tx_size) {
+		ssize_t written;
+
+		written = send(client->fd, client->tx_data + client->tx_offset,
+				client->tx_size - client->tx_offset,
+				MSG_DONTWAIT | MSG_NOSIGNAL);
+		if (written < 0) {
+			if (errno == EINTR)
+				continue;
+
+			if (errno == EAGAIN || errno == EWOULDBLOCK) {
+				mainloop_modify_fd(client->fd, EPOLLIN | EPOLLOUT);
+				return true;
+			}
+
+			client_fail(client);
+			return false;
+		}
+
+		if (!written) {
+			client_fail(client);
+			return false;
+		}
+
+		client->tx_offset += written;
+	}
+
+	client->tx_offset = client->tx_size = 0;
+	mainloop_modify_fd(client->fd, EPOLLIN);
+	return true;
+}
