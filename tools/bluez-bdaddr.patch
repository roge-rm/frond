+/*
+ * A disappearing virtual controller cannot complete a link handshake. Tell
+ * surviving hosts before removing their linked handles; otherwise their HCI
+ * stacks retain a live connection to a controller which no longer exists.
+ */
+static void disconnect_complete(struct btdev *dev, uint16_t handle,
+					uint8_t status, uint8_t reason);
+
+static void conn_notify_peer_lost(void *data, void *user_data)
+{
+	struct btdev_conn *conn = data;
+
+	if (conn->link)
+		disconnect_complete(conn->link->dev, conn->link->handle,
+				BT_HCI_ERR_SUCCESS, HCI_CONNECTION_TIMEOUT);
+
+	queue_foreach(conn->links, conn_notify_peer_lost, NULL);
+}
+
+static void conn_peer_lost(void *data)
+{
+	conn_notify_peer_lost(data, NULL);
+	conn_remove(data);
+}
