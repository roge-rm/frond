+/*
+ * Each connection is a new controller epoch. Avoid reassigning a departed
+ * controller's identity to another peer in Palm's saved discovery/trust cache.
+ * A random process base also separates independently restarted virtual radios.
+ * The TX may later program its original factory identity with Write_BD_ADDR.
+ */
+static bool assign_controller_address(struct btdev *btdev)
+{
+	uint8_t address[6] = { 0, 0, 0, 0, 0, 0x02 };
+	unsigned int i;
+
+	if (!controller_serial_ready) {
+		uint8_t seed[5];
+
+		if (getrandom(seed, sizeof(seed), GRND_NONBLOCK) !=
+						(ssize_t) sizeof(seed))
+			return false;
+
+		for (i = 0; i < sizeof(seed); i++)
+			controller_serial |= (uint64_t) seed[i] << (i * 8);
+
+		controller_serial_ready = true;
+	}
+
+	if (controller_serial == UINT64_C(0xffffffffff))
+		return false;
+
+	controller_serial++;
+
+	for (i = 0; i < 5; i++)
+		address[i] = controller_serial >> (i * 8);
+
+	return btdev_set_bdaddr(btdev, address);
+}
