--- /dev/null
+++ b/src/uarm/MenuTrace.h
@@ -0,0 +1,14 @@
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include "cputil.h"
+inline const bool menuTraceEnabled = std::getenv("FROND_MENU_TRACE") != nullptr;
+inline bool menuTraceActive = false;
+inline uint64_t menuTraceStart = 0;
+inline void menuTracePen(int x, int y) {
+    if (!menuTraceEnabled) return;
+    if (x == 274 && y == 8) {
+        menuTraceStart = timestampUsec(); menuTraceActive = true;
+    }
+    if (menuTraceActive) fprintf(stderr,"MENU INPUT %llu %d %d\n",(unsigned long long)timestampUsec(),x,y);
+}
