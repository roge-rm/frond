+#include "cost_profile.h"
+// Called before each interpreted instruction runs; thumb is the CPU's state before it.
+static void costProfileInstr(const struct ArmCpu *cpu, uint32_t instr, bool thumb) {
+    CostProfile& p = costProfile();
+    p.arm920 = cpu->model == ArmCpuModel::arm920t;
+    unsigned count;
+    bool load;
+    const unsigned cls = costClassify(instr, count, load);
+    p.cls[cls]++;
+    p.hist[cpu->curInstrPC >> 24]++;
+    CostBucket& bucket = p.bucketOf(cpu->curInstrPC);
+    p.cur = &bucket;
+    bucket.n++;
+    bucket.cls[cls]++;
+    if (thumb) { p.thumb++; p.clsThumb[cls]++; }
+    else p.arm++;
+    if (cls != cc_thumb_raw && cls != cc_peephole && (instr >> 28) != 0xe && (instr >> 28) != 0xf && cpuPrvConditionFails(cpu, instr)) {
+        p.failed++;
+        bucket.failed++;
+    } else if (count) {
+        (load ? p.ldmWords : p.stmWords) += count;
+        (load ? bucket.ldmw : bucket.stmw) += count;
+    }
+    if (cls == cc_peephole && (instr & 0xf) == 4) p.memcpyBytes += cpu->regs[2];
+    costProfileTick(p);
+}
