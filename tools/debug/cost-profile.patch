diff --git a/core/src/uarm/uarm/cost_profile.h b/core/src/uarm/uarm/cost_profile.h
new file mode 100644
index 00000000..8e5a004c
--- /dev/null
+++ b/core/src/uarm/uarm/cost_profile.h
@@ -0,0 +1,286 @@
+// Debug only (tools/debug/cost-profile.patch, never applied by the build): counts what the
+// interpreter runs, per cost class, and loads and stores per memory region. Exact engine only
+// (FROND_JIT=0). FROND_COST_PROFILE=file writes a cumulative line every 1M cycles and a final
+// line, then the hot code address histogram.
+#ifndef _COST_PROFILE_H_
+#define _COST_PROFILE_H_
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "dcache_cost.h"
+
+enum CostClass {
+    cc_dp, cc_dp_regshift, cc_dp_pc, cc_mul, cc_mul_long, cc_dsp_mul, cc_clz_sat,
+    cc_ldr, cc_str, cc_ldr_pc, cc_ldrh, cc_strh, cc_ldm, cc_stm, cc_swp,
+    cc_b, cc_bl, cc_bx, cc_mrs_msr, cc_cp15, cc_cp14, cc_cp_other, cc_ldc_stc, cc_swi,
+    cc_peephole, cc_thumb_raw, cc_undef, cc_count
+};
+static const char* const costClassNames[cc_count] = {
+    "dp", "dp_regshift", "dp_pc", "mul", "mul_long", "dsp_mul", "clz_sat",
+    "ldr", "str", "ldr_pc", "ldrh", "strh", "ldm", "stm", "swp",
+    "b", "bl", "bx", "mrs_msr", "cp15", "cp14", "cp_other", "ldc_stc", "swi",
+    "peephole", "thumb_raw", "undef"
+};
+enum CostRegion { cr_sdram, cr_sram, cr_flash, cr_device, cr_static, cr_count };
+static const char* const costRegionNames[cr_count] = {"sdram", "sram", "flash", "device", "static"};
+
+// Counts per 256 bytes of code address, to take the guest's idle loops out of a run afterwards.
+struct CostBucket {
+    uint64_t n = 0, cls[cc_count] = {}, failed = 0, ldmw = 0, stmw = 0, regL[cr_count] = {}, regS[cr_count] = {};
+};
+
+struct CostProfile {
+    CostBucket* regions[256] = {};  // by address >> 24, 65536 buckets each
+    CostBucket* cur = nullptr;
+    CostBucket& bucketOf(uint32_t pc) {
+        CostBucket*& r = regions[pc >> 24];
+        if (!r) r = new CostBucket[65536];
+        return r[(pc >> 8) & 0xffff];
+    }
+    uint64_t cls[cc_count] = {}, clsThumb[cc_count] = {};
+    uint64_t failed = 0, thumb = 0, arm = 0, ldmWords = 0, stmWords = 0, paceOps = 0, memcpyBytes = 0;
+    uint64_t loads[cr_count][3] = {}, stores[cr_count][3] = {};  // by size 1, 2, 4 or more
+    uint64_t paceAcc[cr_count][2] = {};  // accesses made while PACE runs a 68k op, by region and load/store
+    bool inPace = false;
+    uint64_t hist[256] = {};
+    // Cache model (dcache_cost.h): events per region, ARM and PACE accesses apart; accesses per policy;
+    // the static cost classes (xscale_cost.h) of passed instructions, ARM and Thumb apart, and LDM/STM
+    // word counts per class; I-cache line fetches and misses.
+    cost::DataCacheState dc, ic;
+    bool cacheReset = false;
+    uint64_t ev[cr_count][6] = {}, pev[cr_count][6] = {}, pol[cr_count][5] = {};
+    uint64_t kA[cost::classCount] = {}, kT[cost::classCount] = {}, words[3][17] = {};
+    uint64_t peepholes = 0, iLines = 0, iMisses = 0, cacheOps[4] = {};
+    uint32_t lastILine = 0xffffffffu;
+    // The cost model's clock at the device's clocks (FROND_COST_CLOCKS tx, e2, tg50 or zodiac): static
+    // costs (table, PACE op, failed conditions, static bus and device region charges) in sclk, the data
+    // cache model's stalls (cacheStall, PACE's own accesses update the cache but aren't charged) in mst.
+    cost::Clocks clocks = cost::kClocksTx;
+    uint64_t staticClock = 0, stall = 0;
+    uint64_t nextSnapshot = 1000000;
+    bool arm920 = false;
+    FILE* out = nullptr;
+    CostProfile() {
+        if (const char* path = std::getenv("FROND_COST_PROFILE")) out = std::fopen(path, "w");
+        if (const char* c = std::getenv("FROND_COST_CLOCKS")) {
+            const std::string n = c;
+            clocks = n == "e2" ? cost::kClocksE2 : n == "tg50" ? cost::kClocksTg50 : n == "zodiac" ? cost::kClocksZodiac : cost::kClocksTx;
+        }
+        std::atexit([] { costProfileFinal(); });
+    }
+    static void costProfileFinal();
+};
+
+inline CostProfile& costProfile() {
+    static CostProfile p;
+    return p;
+}
+
+static inline void costProfileDump(CostProfile& p, const char* tag) {
+    if (!p.out) return;
+    std::fprintf(p.out, "%s busy=%llu arm=%llu thumb=%llu failed=%llu pace=%llu ldmw=%llu stmw=%llu memcpy=%llu",
+                 tag, (unsigned long long)(p.arm + p.thumb + 20 * p.paceOps), (unsigned long long)p.arm,
+                 (unsigned long long)p.thumb, (unsigned long long)p.failed, (unsigned long long)p.paceOps,
+                 (unsigned long long)p.ldmWords, (unsigned long long)p.stmWords, (unsigned long long)p.memcpyBytes);
+    for (int i = 0; i < cc_count; i++) std::fprintf(p.out, " c.%s=%llu", costClassNames[i], (unsigned long long)p.cls[i]);
+    for (int r = 0; r < cr_count; r++) {
+        for (int s = 0; s < 3; s++)
+            std::fprintf(p.out, " r.%s.l%d=%llu r.%s.s%d=%llu", costRegionNames[r], s, (unsigned long long)p.loads[r][s],
+                         costRegionNames[r], s, (unsigned long long)p.stores[r][s]);
+    }
+    for (int r = 0; r < cr_count; r++)
+        std::fprintf(p.out, " pace.%s.l=%llu pace.%s.s=%llu", costRegionNames[r], (unsigned long long)p.paceAcc[r][0],
+                     costRegionNames[r], (unsigned long long)p.paceAcc[r][1]);
+    static const char* const evNames[6] = {"hit", "fill", "wb", "buf", "ul", "us"};
+    for (int r = 0; r < cr_count; r++)
+        for (int e = 0; e < 6; e++)
+            std::fprintf(p.out, " e.%s.%s=%llu pe.%s.%s=%llu", costRegionNames[r], evNames[e], (unsigned long long)p.ev[r][e],
+                         costRegionNames[r], evNames[e], (unsigned long long)p.pev[r][e]);
+    for (int r = 0; r < cr_count; r++)
+        for (int q = 0; q < 5; q++) std::fprintf(p.out, " pol.%s.%d=%llu", costRegionNames[r], q, (unsigned long long)p.pol[r][q]);
+    for (int c = 0; c < cost::classCount; c++)
+        std::fprintf(p.out, " kA.%d=%llu kT.%d=%llu", c, (unsigned long long)p.kA[c], c, (unsigned long long)p.kT[c]);
+    for (int k = 0; k < 3; k++)
+        for (int n = 0; n < 17; n++)
+            if (p.words[k][n]) std::fprintf(p.out, " w.%d.%d=%llu", k, n, (unsigned long long)p.words[k][n]);
+    std::fprintf(p.out, " mst=%llu", (unsigned long long)p.stall);
+    std::fprintf(p.out, " sclk=%llu", (unsigned long long)p.staticClock);
+    std::fprintf(p.out, " peep=%llu iline=%llu imiss=%llu cop.inv=%llu cop.line=%llu cop.alloc=%llu cop.wb=%llu",
+                 (unsigned long long)p.peepholes, (unsigned long long)p.iLines, (unsigned long long)p.iMisses,
+                 (unsigned long long)p.cacheOps[0], (unsigned long long)p.cacheOps[1], (unsigned long long)p.cacheOps[2],
+                 (unsigned long long)p.cacheOps[3]);
+    std::fprintf(p.out, "\n");
+    std::fflush(p.out);
+}
+
+inline void CostProfile::costProfileFinal() {
+    CostProfile& p = costProfile();
+    costProfileDump(p, "FINAL");
+    if (!p.out) return;
+    uint64_t total = p.arm + p.thumb;
+    for (int r = 0; r < 256; r++) {
+        if (!p.regions[r]) continue;
+        for (uint32_t i = 0; i < 65536; i++) {
+            const CostBucket& b = p.regions[r][i];
+            if (b.n < 1000 || b.n * 2000 < total) continue;
+            std::fprintf(p.out, "BUCKET 0x%08x n=%llu failed=%llu ldmw=%llu stmw=%llu", (unsigned)(r << 24 | i << 8),
+                         (unsigned long long)b.n, (unsigned long long)b.failed, (unsigned long long)b.ldmw,
+                         (unsigned long long)b.stmw);
+            for (int c = 0; c < cc_count; c++) std::fprintf(p.out, " c.%s=%llu", costClassNames[c], (unsigned long long)b.cls[c]);
+            for (int g = 0; g < cr_count; g++)
+                std::fprintf(p.out, " r.%s.l=%llu r.%s.s=%llu", costRegionNames[g], (unsigned long long)b.regL[g],
+                             costRegionNames[g], (unsigned long long)b.regS[g]);
+            std::fprintf(p.out, "\n");
+        }
+    }
+    for (int i = 0; i < 256; i++)
+        if (p.hist[i]) std::fprintf(p.out, "PCHIST 0x%02x000000 %llu\n", i, (unsigned long long)p.hist[i]);
+    std::fclose(p.out);
+    p.out = nullptr;
+}
+
+static inline unsigned costRegionOf(bool arm920, uint32_t pa) {
+    if (arm920) {  // i.MX1: SRAM at 0x00300000, SDRAM at 0x08000000, flash from 0x10000000
+        if (pa >= 0x08000000 && pa < 0x10000000) return cr_sdram;
+        if (pa >= 0x00300000 && pa < 0x00320000) return cr_sram;
+        if (pa >= 0x10000000 && pa < 0x14000000) return cr_flash;
+        return cr_device;
+    }
+    if (pa >= 0xA0000000u && pa < 0xB0000000u) return cr_sdram;
+    if (pa >= 0x5C000000u && pa < 0x5C040000u) return cr_sram;  // PXA27x internal memory
+    if (pa < 0x04000000u) return cr_flash;                      // static chip select 0
+    if (pa < 0x40000000u) return cr_static;                     // static chip selects 1-5, PCMCIA
+    return cr_device;
+}
+
+// A PACE 68k op charges 20 cycles.
+static inline void costProfileTick(CostProfile& p) {
+    if (p.arm + p.thumb + 20 * p.paceOps >= p.nextSnapshot) {
+        p.nextSnapshot += 1000000;
+        costProfileDump(p, "SNAP");
+    }
+}
+
+static inline cost::Core costProfileCore(const CostProfile& p) { return p.arm920 ? cost::Core::arm920t : cost::Core::pxa27x; }
+
+static inline void costProfileCacheInit(CostProfile& p) {
+    if (p.cacheReset) return;
+    p.cacheReset = true;
+    cost::dataCacheReset(p.dc, costProfileCore(p));
+    cost::dataCacheReset(p.ic, costProfileCore(p));
+}
+
+// mmuOn, cacheOn (control register C), c, b, x from the translation; roundRobin the ARM920T RR bit.
+static inline void costProfileAccess(bool arm920, uint32_t va, uint32_t pa, unsigned size, bool write, bool mmuOn,
+                                     bool cacheOn, bool c, bool b, bool x, bool roundRobin) {
+    CostProfile& p = costProfile();
+    p.arm920 = arm920;
+    costProfileCacheInit(p);
+    const unsigned s = size == 1 ? 0 : size == 2 ? 1 : 2;
+    const unsigned r = costRegionOf(arm920, pa);
+    const cost::Core core = costProfileCore(p);
+    const cost::Policy pol = cost::policyOf(core, mmuOn, cacheOn, c, b, x);
+    if (r == cr_sdram || r == cr_sram || r == cr_flash) {
+        p.pol[r][unsigned(pol)]++;
+        const cost::CacheEvents e = cost::dataCacheAccess(p.dc, core, va, pol, write, roundRobin);
+        uint64_t* ev = p.inPace ? p.pev[r] : p.ev[r];
+        ev[0] += e.hits; ev[1] += e.fills; ev[2] += e.writebacks; ev[3] += e.buffered;
+        ev[4] += e.uncachedLoads; ev[5] += e.uncachedStores;
+        const cost::Region cr = r == cr_sram ? cost::sram : r == cr_flash ? cost::flash : cost::sdram;
+        const uint32_t st = cost::cacheStall(p.dc, core, e, cost::cacheCosts(core, cr, p.clocks), p.staticClock + p.stall);
+        if (!p.inPace) p.stall += st;
+    } else if (!p.inPace) {
+        p.staticClock += cost::regionCost(core, r == cr_static ? cost::staticBus : cost::device, write, p.clocks);
+    }
+    if (!p.inPace && p.cur) (write ? p.cur->regS : p.cur->regL)[r]++;
+    if (p.inPace) { p.paceAcc[r][write]++; return; }
+    (write ? p.stores : p.loads)[r][s]++;
+}
+
+// CP15 c7 on the XScale: invalidate all (c6/c7 op2 0), invalidate line (c6 op2 1), clean line (c10 op2 1),
+// clean and invalidate line (c14 op2 1 on the ARM920T), line allocate (c2 op2 5), drain (c10 op2 4).
+static inline void costProfileCacheOp(unsigned CRm, unsigned op2, uint32_t val) {
+    CostProfile& p = costProfile();
+    costProfileCacheInit(p);
+    const cost::Core core = costProfileCore(p);
+    cost::CacheEvents e;
+    if ((CRm == 6 || CRm == 7) && op2 == 0) { cost::dataCacheInvalidateAll(p.dc); p.cacheOps[0]++; }
+    else if (CRm == 6 && op2 == 1) { e = cost::dataCacheLineOp(p.dc, core, val, false, true); p.cacheOps[1]++; }
+    else if (CRm == 10 && op2 == 1) { e = cost::dataCacheLineOp(p.dc, core, val, true, false); p.cacheOps[1]++; }
+    else if (CRm == 14 && op2 == 1) { e = cost::dataCacheLineOp(p.dc, core, val, true, true); p.cacheOps[1]++; }
+    else if (CRm == 2 && op2 == 5) { e = cost::dataCacheAllocateLine(p.dc, core, val); p.cacheOps[2]++; }
+    else if (CRm == 10 && op2 == 4) cost::dataCacheDrain(p.dc);
+    if ((CRm == 5 || CRm == 7) && op2 == 0) cost::dataCacheInvalidateAll(p.ic);
+    p.cacheOps[3] += e.writebacks;
+    p.stall += cost::cacheStall(p.dc, core, e, cost::cacheCosts(core, cost::sdram, p.clocks), p.staticClock + p.stall);
+}
+
+// Static cost class of a passed instruction, and the I-cache line its fetch reads.
+static inline void costProfileStatic(CostProfile& p, uint32_t instr, bool thumb, uint32_t pc, bool failed) {
+    costProfileCacheInit(p);
+    const uint32_t iline = pc >> 5;
+    if (iline != p.lastILine) {
+        p.lastILine = iline;
+        p.iLines++;
+        if (cost::dataCacheAccess(p.ic, costProfileCore(p), pc, cost::Policy::writeBack, false).fills) p.iMisses++;
+    }
+    if (failed) { p.staticClock += 1; return; }
+    if ((instr & 0xfffffff0u) == 0xfff9ee90u) { p.peepholes++; p.staticClock += 1; return; }
+    unsigned words = 0;
+    const cost::Class c = (instr >> 16) == 0 ? cost::thumbClass(instr, costProfileCore(p), words)
+                                             : cost::armClass(instr, costProfileCore(p), words);
+    (thumb ? p.kT : p.kA)[c]++;
+    p.staticClock += cost::classCost(cost::tableFor(costProfileCore(p)), c, words) + (thumb ? cost::thumbPenalty(c, costProfileCore(p)) : 0);
+    const int k = c == cost::ldm ? 0 : c == cost::ldmPc ? 1 : c == cost::stm ? 2 : -1;
+    if (k >= 0) p.words[k][words > 16 ? 16 : words]++;
+}
+
+// instr is the ARM word, or the raw Thumb halfword for a Thumb instruction with no ARM form.
+static inline unsigned costClassify(uint32_t w, unsigned& ldmCount, bool& isLoadMulti) {
+    ldmCount = 0;
+    isLoadMulti = false;
+    if ((w >> 16) == 0) return cc_thumb_raw;
+    if ((w & 0xfffffff0u) == 0xfff9ee90u) return cc_peephole;
+    if ((w >> 28) == 0xf) return ((w >> 25) & 7) == 5 ? cc_bl : cc_dp;  // BLX imm, else PLD
+    switch ((w >> 26) & 3) {
+        case 0: {
+            if ((w & 0x0ffffff0u) == 0x012fff10u || (w & 0x0ffffff0u) == 0x012fff30u) return cc_bx;
+            if ((w & 0x0fc000f0u) == 0x00000090u) return cc_mul;
+            if ((w & 0x0f8000f0u) == 0x00800090u) return cc_mul_long;
+            if ((w & 0x0fb00ff0u) == 0x01000090u) return cc_swp;
+            if ((w & 0x0e000090u) == 0x00000090u && (w & 0x60)) return ((w & (1 << 20)) || ((w >> 5) & 3) == 2) ? cc_ldrh : cc_strh;
+            if ((w & 0x0f900090u) == 0x01000080u) return cc_dsp_mul;
+            if ((w & 0x0f900ff0u) == 0x01000050u) return cc_clz_sat;
+            if ((w & 0x0fff0ff0u) == 0x016f0f10u) return cc_clz_sat;
+            if ((w & 0x0fbf0fffu) == 0x010f0000u) return cc_mrs_msr;
+            if ((w & 0x0db0f000u) == 0x0120f000u) return cc_mrs_msr;
+            const unsigned op = (w >> 21) & 15;
+            const bool test = op >= 8 && op <= 11;
+            if (!test && ((w >> 12) & 15) == 15) return cc_dp_pc;
+            if (!(w & (1 << 25)) && (w & (1 << 4))) return cc_dp_regshift;
+            return cc_dp;
+        }
+        case 1:
+            if ((w & (1 << 25)) && (w & (1 << 4))) return cc_undef;
+            if (w & (1 << 20)) return ((w >> 12) & 15) == 15 ? cc_ldr_pc : cc_ldr;
+            return cc_str;
+        case 2:
+            if (w & (1 << 25)) return (w & (1 << 24)) ? cc_bl : cc_b;
+            ldmCount = __builtin_popcount(w & 0xffff);
+            isLoadMulti = w & (1 << 20);
+            return isLoadMulti ? cc_ldm : cc_stm;
+        default:
+            if (((w >> 24) & 15) == 15) return cc_swi;
+            if (!(w & (1 << 25))) return cc_ldc_stc;
+            if (w & (1 << 4)) {
+                const unsigned cp = (w >> 8) & 15;
+                return cp == 15 ? cc_cp15 : cp == 14 ? cc_cp14 : cc_cp_other;
+            }
+            return cc_cp_other;
+    }
+}
+
+#endif
