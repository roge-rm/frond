+        case 0x20087764: case 0x200877b0: case 0x20087980:
+        case 0x20087884: case 0x20087888:
+        case 0x2004b69c: case 0x2004b6a0: case 0x2004b6b0: case 0x2004b6b4:
+        case 0x2009d5b8: case 0x2009d6c0: case 0x2009d72c: break;
+        default: return;
+    }
+    bool failed=false;
+    auto word = [&](uint32_t addr) {
+        uint32_t v=0;
+        if (!cpuMemOpExternal(cpu,&v,addr,4,false)) failed=true;
+        return v;
+    };
+    if (!audioTraceProfileChecked) {
+        audioTraceProfileChecked=true;
+        audioTraceProfileSupported =
+            word(0x200873e8)==0xe92d41f0 && word(0x20087764)==0xe92d4df0 &&
+            word(0x200877b0)==0xe3500000 && word(0x20087884)==0xeb0013ba &&
+            word(0x2009d5b8)==0xe3500000 && word(0x2009d6c0)==0xe59d3004 &&
+            word(0x2009d72c)==0xe59d1000 && word(0x2004b69c)==0xf8d2f01b && !failed;
+        fprintf(stderr,"GUESTPROFILE supported=%d\n",audioTraceProfileSupported);
+    }
+    if (!audioTraceProfileSupported) return;
+    uint32_t r[16];
+    for(unsigned i=0;i<16;++i) r[i]=cpuGetRegExternal(cpu,i);
+    uint32_t obj=pc<0x200873e8 ? 0 : pc==0x200873e8 || pc==0x20087764 ? r[0] :
+        pc<0x20087764 ? r[4] : pc<=0x20087980 ? r[6] : 0;
+    const uint32_t free=obj?word(obj+16):0, size=obj?word(obj+32):0,
+        buf=obj?word(obj+36):0, need=obj?word(obj+68):0,
+        out=pc>=0x2009d5a8?word(r[13]+4):0, token=pc>=0x2009d5a8?word(r[13]):0;
+    fprintf(stderr,"GUEST time=%llu pc=%x r0=%x r1=%x r2=%x r3=%x r4=%x r5=%x r6=%x r7=%x lr=%x obj=%x free=%u size=%u buf=%x need=%u out=%x token=%x failed=%d\n",
+        (unsigned long long)audioGapTraceTime(),pc,r[0],r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[14],obj,
