+static uint32_t stageRead(struct ArmCpu* cpu, uint32_t addr, unsigned count, bool big=false) {
+    uint32_t result = 0;
+    for (unsigned i = 0; i < count; ++i) {
+        uint8_t b = 0;
+        if (!cpuMemOpExternal(cpu, &b, addr+i, 1, false)) return 0;
+        if (big) result = (result << 8) | b;
+        else result |= uint32_t(b) << (i*8);
+    }
+    return result;
+}
+void traceGuestBoundary(struct ArmCpu* cpu, uint32_t pc, uint32_t from) {
+    auto r = cpuGetRegisters(cpu);
+    static uint32_t event = 0, callbackBuffer = 0, callbackFrames = 0;
+    static uint32_t eventReturn = 0x6b7584, renderEntry = 0x6939f8, renderReturn = 0x2004b6a1;
+    if (pc == 0x202cc02c && r[1] == 0x45b) {
+        uint32_t args = r[2];
+        renderEntry = stageRead(cpu, args+14, 4, true);
+        fprintf(stderr, "STAGE CREATE %llu %u %x %u %x %u\n", (unsigned long long)timestampUsec(),
+            stageRead(cpu,args+6,4,true), renderEntry, stageRead(cpu,args+22,4,true), args, r[3]);
+
+    }
+    if (pc == 0x202cc02c && r[1] == 0x11d) {
+        event = stageRead(cpu, r[2], 4, true);
+        eventReturn = r[14];
+        fprintf(stderr, "STAGE EVTENTER %llu %x %u\n", (unsigned long long)timestampUsec(),
+            event, stageRead(cpu, r[2]+4, 4, true));
+    }
+    if (pc == eventReturn && event) {
+        fprintf(stderr, "STAGE EVTRET %llu %x %u %u %d %d\n", (unsigned long long)timestampUsec(),
+            event, stageRead(cpu,event,2,true), stageRead(cpu,event+2,1),
+            (int16_t)stageRead(cpu,event+4,2,true), (int16_t)stageRead(cpu,event+6,2,true));
+        event = 0;
+    }
+    if (pc == renderEntry) {
+        callbackBuffer = r[2]; callbackFrames = r[3]; renderReturn = r[14];
+        fprintf(stderr, "STAGE RENDERIN %llu %x %u\n", (unsigned long long)timestampUsec(),r[2],r[3]);
+    }
+    if (pc == renderReturn && callbackBuffer && callbackFrames <= 8192) {
+        unsigned peak = 0;
+        for (unsigned i = 0; i < callbackFrames; i += 8) {
+            int16_t sample = stageRead(cpu, callbackBuffer+i*4, 2);
+            unsigned mag = sample < 0 ? -int(sample) : sample;
+            if (mag > peak) peak = mag;
+        }
+        fprintf(stderr, "STAGE RENDEROUT %llu %x %u %u\n", (unsigned long long)timestampUsec(),
+            callbackBuffer, callbackFrames, peak);
+        callbackBuffer = 0;
+    }
+}
