 static void wm9712LprvNewAudioPlaybackSample(struct WM9712L *wm, uint32_t samp) {
+    static const bool enabled = getenv("FROND_PCM_TRACE") != nullptr;
+    static uint64_t frames = 0, zeros = 0, run = 0, longest = 0, previousEmpty = 0;
+    if (enabled) {
+        ++frames;
+        if (!samp) { ++zeros; ++run; if (run > longest) longest = run; }
+        else run = 0;
+        if (frames % 44100 == 0) {
+            uint64_t empty = pxaAC97TraceEmptySamples(wm->ac97);
+            fprintf(stderr, "GUESTPCM frames=%llu zeros=%llu longest=%llu fifo_empty=%llu rate=%u\n",
+                (unsigned long long)frames, (unsigned long long)zeros,
+                (unsigned long long)longest, (unsigned long long)(empty-previousEmpty), wm->dacRate);
+            zeros = 0; longest = 0; previousEmpty = empty;
+        }
+    }
+    static const bool trace = getenv("FROND_LATENCY_PCM") != nullptr;
+    static bool silent = true;
+    if (trace && samp && silent) fprintf(stderr, "LAT GUEST %llu %zu\n", (unsigned long long)timestampUsec(), wm->audioQueue ? audioQueuePendingSamples(wm->audioQueue) : 0);
+    silent = !samp;
     if (wm->audioQueue) audioQueuePush(wm->audioQueue, samp);
 }
 
