 uint32_t *cpuGetRegisters(struct ArmCpu *cpu) { return cpu->regs; }
 
+// Optional diagnostic build only: instruction attempts and 1/1021 PC samples.
+// These are execution counts, not host-time or hardware instruction-cost shares.
+struct ExecutionProfile {
+    bool enabled = std::getenv("FROND_EXECUTION_PROFILE") != nullptr;
+    uint64_t counts[3]{};
+    std::unordered_map<uint64_t,uint64_t> bins;
+    std::unordered_map<uint16_t,uint64_t> traps;
+    void Tick(unsigned kind, uint32_t pc, unsigned mode) {
+        if (!enabled) return;
+        if (++counts[kind] % 1021 == 0)
+            ++bins[(uint64_t(kind)<<40) | (uint64_t(mode)<<32) | (pc & ~255u)];
+    }
+    ~ExecutionProfile() {
+        if (!enabled) return;
+        for (unsigned i=0;i<3;++i)
+            fprintf(stderr,"EXEC_COUNT %u %llu\n",i,(unsigned long long)counts[i]);
+        for (const auto& b:bins)
+            fprintf(stderr,"EXEC_PC %u %u %08x %llu\n",unsigned(b.first>>40),
+                    unsigned((b.first>>32)&255),unsigned(b.first), (unsigned long long)b.second);
+        for (const auto& t:traps)
+            fprintf(stderr,"EXEC_TRAP %04x %llu\n",t.first,(unsigned long long)t.second);
+    }
+};
+static ExecutionProfile executionProfile;
