+static void rfcomm_start_configured(struct bthost *bthost,
+                        struct btconn *conn, struct l2conn *l2conn)
+{
+    if (l2conn->psm != 0x0003 || l2conn->config_failed ||
+            !l2conn->config_local_done || !l2conn->config_remote_done ||
+            l2conn->rfcomm_started || !bthost->rfcomm_conn_data ||
+            bthost->rfcomm_conn_data->conn != conn ||
+            bthost->rfcomm_conn_data->scid != l2conn->scid)
+        return;
+
+    /* RFCOMM starts after both L2CAP configuration exchanges complete. */
+    l2conn->rfcomm_started = true;
+    rfcomm_sabm_send(bthost, conn, l2conn, 1, 0);
+}
