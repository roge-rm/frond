+static void btconn_drop_cid_hooks(struct btconn *conn, struct l2conn *l2conn)
+{
+	struct cid_hook **hook = &conn->cid_hooks;
+
+	/* A hook belongs to one channel: the next channel can reuse its CID. */
+	while (*hook) {
+		struct cid_hook *old = *hook;
+
+		if (old->cid != l2conn->scid && old->cid != l2conn->dcid) {
+			hook = &old->next;
+			continue;
+		}
+
+		*hook = old->next;
+		free(old);
+	}
+}
