include $(dir $(lastword $(MAKEFILE_LIST)))Makefile.host
ifeq ($(HOST_OS),windows)
# Stand-ins for the POSIX headers (common/winshim) come first on the include path.
FROND_WINSHIM := $(shell cygpath -m $(abspath $(dir $(lastword $(MAKEFILE_LIST)))common/winshim))
export CPATH := $(FROND_WINSHIM)$(if $(CPATH),;$(CPATH))
endif

# The variables below most likely have to be defined

SOURCE_C_NATIVE ?= 
SOURCE_CXX_NATIVE ?= 

BINARY_NATIVE ?=
LIBRARY_NATIVE ?=

INCLUDE ?=

EXE_SUFFIX ?=

# The variables below should be defined as necessary

CFLAGS_COMMON ?= -Wextra -Wall
ifeq ($(HOST_OS),windows)
# MinGW selects the stat ABI when the headers are first read.
CFLAGS_COMMON += -D_FILE_OFFSET_BITS=64
endif
CXXFLAGS_COMMON ?= $(CFLAGS_COMMON)

STD_C ?= -std=c99
STD_CXX ?= -std=c++17

CFLAGS_NATIVE_EXTRA ?=
CXXFLAGS_NATIVE_EXTRA ?= $(CFLAGS_NATIVE_EXTRA)
LDFLAGS_NATIVE_EXTRA ?=

OBJECTS_EXTRA_NATIVE ?=

GARBAGE_EXTRA ?=

EXTRA_OBJECT_DEPS ?=

# The stuff below can be overridden if necessary, but there shouldn't be any need

CC_NATIVE ?= gcc
CXX_NATIVE ?= g++
LD_NATIVE ?= g++
AR_NATIVE ?= ar
RANLIB_NATIVE ?= ranlib

CFLAGS_NATIVE ?= -O2  -g $(shell sdl2-config --cflags) $(READLINE_CFLAGS)
CXXFLAGS_NATIVE ?= $(CFLAGS_NATIVE)
LDFLAGS_NATIVE ?=  $(shell sdl2-config --libs) -lSDL2_image $(READLINE_LIBS) -lpthread $(PLATFORM_LIBS)

# FROND_CORE_OBJ=/abs/path puts this folder's objects and depfiles in FROND_CORE_OBJ/<folder>/.
FROND_CORE_OBJ_DIR = $(if $(FROND_CORE_OBJ),$(FROND_CORE_OBJ)/$(notdir $(CURDIR))/)
# Where common's libcommon archives are, for the folders that link them.
COMMON_LIB_DIR = $(if $(FROND_CORE_OBJ),$(FROND_CORE_OBJ)/common/,../common/)
BUILDDIR_NATIVE ?= $(FROND_CORE_OBJ_DIR).build
DEPDIR_NATIVE ?= $(FROND_CORE_OBJ_DIR).deps

DEPFLAGS_NATIVE = -MT $@ -MMD -MP -MF $(DEPDIR_NATIVE)/$*.d

MKDIR_NATIVE = mkdir -p $(dir $@) && mkdir -p $(DEPDIR_NATIVE)/$(dir $<)

OBJECTS_NATIVE = $(SOURCE_C_NATIVE:%.c=$(BUILDDIR_NATIVE)/%.o) $(SOURCE_CXX_NATIVE:%.cpp=$(BUILDDIR_NATIVE)/%.o) $(OBJECTS_EXTRA_NATIVE)

GARBAGE ?= 								\
	$(BUILDDIR_NATIVE) 					\
	$(BINARY_NATIVE) 					\
	$(LIBRARY_NATIVE)					\
	$(DEPDIR_NATIVE) 					\
	$(GARBAGE_EXTRA)

$(BINARY_NATIVE): $(OBJECTS_NATIVE)
	$(LD_NATIVE) -o $@ $^ $(LDFLAGS_NATIVE) $(LDFLAGS_NATIVE_EXTRA)

$(LIBRARY_NATIVE): $(OBJECTS_NATIVE)
	$(AR_NATIVE) cru $@ $^
	$(RANLIB_NATIVE) $@

$(BUILDDIR_NATIVE)/%.o : %.c $(EXTRA_OBJECT_DEPS)
	$(MKDIR_NATIVE) && $(CC_NATIVE) $(DEPFLAGS_NATIVE) $(STD_C) $(CFLAGS_COMMON) $(CFLAGS_NATIVE) $(CFLAGS_NATIVE_EXTRA) $(INCLUDE) $(INCLUDE_EXTRA)  -c -o $@ $<

$(BUILDDIR_NATIVE)/%.o : %.cpp $(EXTRA_OBJECT_DEPS)
	$(MKDIR_NATIVE) && $(CXX_NATIVE) $(DEPFLAGS_NATIVE) $(STD_CXX) $(CXXFLAGS_COMMON) $(CXXFLAGS_NATIVE) $(CXXFLAGS_NATIVE_EXTRA) $(INCLUDE) $(INCLUDE_EXTRA) -c -o $@ $<

clean:
	-rm -fr $(GARBAGE)

.SUFFIXES:

include $(shell test -e $(DEPDIR_NATIVE) && find $(DEPDIR_NATIVE) -type f)
