+bool EmRegsVZDana::DispatchDanaInput(const std::vector<DanaTransition5>& batch) {
+    if(batch.size()>24) return false;
+    std::vector<uint8> next(heldScan,heldScan+heldCount);
+    unsigned queued=queueCount;
+    for(auto event:batch) {
+        auto code=event.scan.Code();
+        if(!danaScanValid5(code)) return false;
+        auto it=std::find(next.begin(),next.end(),code);
+        if(event.down ? it!=next.end() : it==next.end()) continue;
+        if(event.down) next.push_back(code); else next.erase(it);
+        if(next.size()>8 || ++queued+next.size()>32) return false;
     }
+    hostPaced=true;
+    for(auto event:batch) DispatchScanCode(event.scan.Code(),event.down);
+    return true;
+}
+void EmRegsVZDana::ReleaseDanaInput(bool cancel) {
+    if(!cancel) {
+        if(!heldCount) return;
+        heldCount=0; std::memset(heldScan,0,8);
+        if(queueCount==32) std::memset(packets[(queueHead+31)%32],0,8);
+        else QueueKeys();
+        UpdateStIrq(); return;
+    }
+    // Preserve a reply already being clocked; replace all later input with release.
+    if(packetIndex) { queueCount=1; }
+    else { queueHead=queueCount=0; }
+    heldCount=0; std::memset(heldScan,0,8);
+    QueueKeys(); UpdateStIrq();
+}
