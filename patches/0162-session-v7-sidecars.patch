diff --git a/src/uarm/native/MachineSession.h b/src/uarm/native/MachineSession.h
new file mode 100644
index 0000000..3c7c64d
--- /dev/null
+++ b/src/uarm/native/MachineSession.h
@@ -0,0 +1,125 @@
+#ifndef FROND_MACHINE_SESSION_H
+#define FROND_MACHINE_SESSION_H
+
+#include "SessionIo.h"
+#include "SoC.h"
+#include "device_profile5.h"
+#include "mmiodev_MemoryStickController.h"
+#include "sdcard.h"
+#include "soc_PXA.h"
+
+#include <algorithm>
+#include <cstring>
+#include <filesystem>
+#include <iostream>
+#include <string>
+
+// Native save/load of a machine folder. A lone v6 .frond extracts into <stem>/.
+namespace frondNative {
+
+inline std::filesystem::path machineFolderForSave(const std::filesystem::path& path) {
+    std::error_code ec;
+    if (std::filesystem::is_directory(path, ec) ||
+        (!std::filesystem::exists(path, ec) && !frondMachine::endsWith(path.filename().string(), ".frond"))) {
+        std::filesystem::create_directories(path, ec);
+        return path;
+    }
+    if (frondMachine::endsWith(path.filename().string(), ".frond")) {
+        if (frondSession::frondInFolder(path) || frondSession::isMachineFolder(path.parent_path()))
+            return path.parent_path();
+        const auto folder = path.parent_path() / path.stem();
+        std::filesystem::create_directories(folder, ec);
+        return folder;
+    }
+    std::filesystem::create_directories(path, ec);
+    return path;
+}
+
+inline void fillState(SoC& soc, frondSession::Contents& contents) {
+    const auto* profile = deviceProfile5(soc.GetDeviceType());
+    contents.deviceName = profile ? profile->name : "";
+    contents.displayMode = int32_t(soc.GetDisplayMode());
+    contents.ramSize = soc.GetRamSize();
+    auto copy = [](const Buffer& b) {
+        auto* p = static_cast<const uint8_t*>(b.data);
+        return b.size && p ? std::vector<uint8_t>(p, p + b.size) : std::vector<uint8_t>{};
+    };
+    contents.nor = copy(soc.GetRomData());
+    contents.nand = copy(soc.GetNandData());
+    contents.memory = copy(soc.GetMemoryData());
+    contents.savestate = copy(soc.GetSavestate());
+}
+
+inline bool publishSd(const std::filesystem::path& folder, frondMachine::Media& media, bool inserted) {
+    media.kind = frondMachine::kindSd;
+    media.name = frondMachine::sdSibling;
+    media.inserted = inserted;
+    media.writeProtected = false;
+    const uint64_t bytes = uint64_t(sdCardSectorCount()) * SD_SECTOR_SIZE;
+    media.logicalSize = bytes;
+    media.physicalSize = bytes;
+    const char* id = sdCardGetId();
+    media.identity.fill(0);
+    if (id && *id) std::memcpy(media.identity.data(), id, std::min(size_t(32), std::strlen(id)));
+    if (sdCardFileBacked()) return sdCardCommit();
+    return frondSession::writeSdFromReader(
+        folder / frondMachine::sdSibling, bytes,
+        [](uint64_t off, uint64_t n, void* dest) {
+            if (n != SD_SECTOR_SIZE || off % SD_SECTOR_SIZE) return false;
+            return sdCardRead(uint32_t(off / SD_SECTOR_SIZE), dest);
+        },
+        media.identity);
+}
+
+inline bool publishMs(const std::filesystem::path& folder, MemoryStickController* ms,
+                      frondMachine::Media& media) {
+    media.kind = frondMachine::kindMs;
+    media.name = frondMachine::msSibling;
+    media.inserted = msCtrlrInserted(ms);
+    media.writeProtected = msCtrlrReadOnly(ms);
+    media.logicalSize = frondMachine::msLogicalBytes;
+    media.physicalSize = frondMachine::msPhysicalBytes;
+    const auto path = folder / frondMachine::msSibling;
+    std::error_code ec;
+    if (std::filesystem::is_regular_file(path, ec)) return true;
+    std::vector<uint8_t> physical;
+    if (!msCtrlrExport(ms, physical)) return false;
+    return frondSession::writeMsFile(path, physical.data(), physical.size());
+}
+
+inline bool saveMachine(const std::filesystem::path& path, SoC& soc) {
+    if (!soc.Save()) return false;
+    const auto folder = machineFolderForSave(path);
+    frondSession::Contents contents;
+    fillState(soc, contents);
+    if (sdCardInitialized()) {
+        frondMachine::Media media;
+        if (!publishSd(folder, media, soc.SdInserted())) return false;
+        contents.media.push_back(std::move(media));
+    }
+    if (auto* pxa = dynamic_cast<SocPXA*>(&soc)) {
+        if (auto* ms = pxa->GetMemoryStick(); ms && msCtrlrPresent(ms)) {
+            frondMachine::Media media;
+            if (!publishMs(folder, ms, media)) return false;
+            contents.media.push_back(std::move(media));
+        }
+    }
+    return frondSession::saveFolder(folder, contents);
+}
+
+inline bool attachFolderMedia(const frondSession::Contents& contents, const std::filesystem::path& folder) {
+    for (const auto& media : contents.media) {
+        if (media.kind == frondMachine::kindSd) {
+            char id[SD_CARD_ID_MAX_LEN + 1]{};
+            std::memcpy(id, media.identity.data(), SD_CARD_ID_MAX_LEN);
+            if (!sdCardInitializeFromFile((folder / frondMachine::sdSibling).c_str(), media.physicalSize,
+                                          frondSdFile::headerBytes, id))
+                return false;
+        }
+    }
+    return true;
+}
+
+}  // namespace frondNative
+
+#endif
