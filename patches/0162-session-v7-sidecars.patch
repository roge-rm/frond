+#ifndef FROND_SESSION_IO_H
+#define FROND_SESSION_IO_H
+
+#include "MachineFolder.h"
+#include "md5.h"
+#include "session/session_file5.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <limits>
