+++ b/src/uarm/uarm/NetworkSimulation.cpp
@@ -0,0 +1,163 @@
+#include "NetworkSimulation.h"
+#ifndef __EMSCRIPTEN__
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+#include "CPU.h"
+#include "pace.h"
+namespace {
+constexpr uint16_t param=0x1204, notOpen=0x1202, noSockets=0x1205, badSocket=0x1208,
+    notConnected=0x120b, noInterfaces=0x120c, unimplemented=0x120e, timedOut=0x1212,
+    alreadyConnected=0x1213, wouldBlock=0x122f, noName=0x123e;
+// Read packed 68k arguments bytewise: pointers may only be two-byte aligned.
+class Guest {
+ public:
+    ArmCpu* cpu;
+    uint32_t sp;
+    void bytes(uint32_t address, void* data, size_t size, bool write=false) {
+        if ((!address && size) || size > UINT32_MAX-address) throw std::runtime_error("guest address");
+        for (size_t i=0;i<size;i++)
+            if (!cpuMemOpExternal(cpu, static_cast<uint8_t*>(data)+i, address+i, 1, write))
+                throw std::runtime_error("guest memory");
+    }
+    uint32_t read(uint32_t address, unsigned size) {
+        uint8_t b[4]{}; bytes(address,b,size); uint32_t v=0;
+        for(unsigned i=0;i<size;i++) v=(v<<8)|b[i];
+        return v;
+    }
+    void put(uint32_t address,uint32_t value,unsigned size) {
+        uint8_t b[4]{}; for(unsigned i=0;i<size;i++) b[size-1-i]=value>>(i*8); bytes(address,b,size,true);
+    }
+    uint32_t arg(unsigned offset,unsigned size=4) { if(sp>UINT32_MAX-offset) throw std::runtime_error("stack"); return read(sp+offset,size); }
+    std::string text(uint32_t address) {
+        std::string value;
+        for(unsigned i=0;i<256;i++) { auto c=read(address+i,1); if(!c) return value; value+=char(c); }
+        throw std::runtime_error("guest string");
+    }
+};
+}
+const char* NetworkSimulation::GetModeName() const {
+    static const char* names[]={"disabled","connected","timeout","disconnected"}; return names[mode];
+}
+bool NetworkSimulation::SetMode(const std::string& name) {
+    for(uint32_t i=0;i<4;i++) { static const char* names[]={"disabled","connected","timeout","disconnected"};
+        if(name==names[i]) { if(mode!=i) { Reset(); mode=i; } return true; } }
+    return false;
+}
+void NetworkSimulation::Reset() { opens=0; sockets={}; }
+void NetworkSimulation::Load(SavestateLoader<ChunkType>& loader) {
+    mode=disabled; Reset();
+    if(!loader.HasChunk(ChunkType::networkSimulation)) return;
+    auto* chunk=loader.GetChunkOrFail(ChunkType::networkSimulation,0,"simulated network");
+    if(!chunk) return;
+    LoadChunkHelper helper(*chunk); Transfer(helper);
+    bool valid=mode<=disconnected && opens<=65535;
+    for(const auto& s:sockets) {
+        valid &= s.used<=1 && s.connected<=1 && s.size<=s.bytes.size() && (s.used || (!s.connected && !s.size));
+        if (!opens || mode==disabled || mode==disconnected) valid &= !s.used;
+    }
+    if(!valid) { mode=disabled; Reset(); loader.NotifyError(); }
+}
+bool NetworkSimulation::Handle(ArmCpu* cpu,uint16_t trap) {
+    Guest g{cpu,paceGetAreg(7)};
+    uint32_t errPtr=0;
+    bool pointerResult=trap==0xa81b;
+    auto result=[&](int32_t value,uint16_t error=0) {
+        if(errPtr) g.put(errPtr,error,2);
+        paceSetDreg(0,value); if(pointerResult) paceSetAreg(0,error?0:uint32_t(value));
+        return true;
+    };
+    try {
+        if(trap==0xa0ba) { // SysLibFind
+            if(mode==disabled || g.text(g.arg(0))!="Net.lib") return false;
+            g.put(g.arg(4),refnum,2); return result(0);
+        }
+        // Never pass our synthetic library reference to the real library table.
+        if(trap==0xa0b8 && g.arg(0,2)==refnum) return result(0);
+        if(trap==0xa0b9 && g.arg(0,2)==refnum) { paceSetAreg(0,0); return result(0); }
+        if(trap<0xa800 || trap>0xa8ff || g.arg(0,2)!=refnum) return false;
+        if(trap==0xa801) {
+            errPtr=g.arg(2);
+            if(mode==disabled || mode==disconnected) return result(noInterfaces,noInterfaces);
+            if(opens==65535) return result(0x1206,0x1206);
+            const auto previous=opens; result(previous?0x1201:0); ++opens; return true;
+        }
+        if(trap==0xa802) { if(!opens) return result(notOpen); if(--opens) return result(0x1203); Reset(); return result(0); }
+        if(trap==0xa82e) { g.put(g.arg(2),opens,2); return result(0); }
+        if(trap==0xa803 || trap==0xa804) return result(0);
+        switch(trap) {
+            case 0xa807: errPtr=g.arg(12); break;
+            case 0xa808: errPtr=g.arg(8); break;
+            case 0xa80c: errPtr=g.arg(14); break;
+            case 0xa811: errPtr=g.arg(22); break;
+            case 0xa813: errPtr=g.arg(24); break;
+            case 0xa815: errPtr=g.arg(20); break;
+            case 0xa81b: errPtr=g.arg(14); break;
+            default: return result(-1,unimplemented);
+        }
+        // Validate the error output before changing model state.
+        if(errPtr) { auto v=g.read(errPtr,2); g.put(errPtr,v,2); }
+        if(!opens || mode==disabled || mode==disconnected) return result(pointerResult?0:-1,notOpen);
+        if(trap==0xa81b) {
+            const auto name=g.text(g.arg(2));
+            if(name!="frond.test" && name!="10.0.0.2") return result(0,noName);
+            const auto b=g.arg(6);
+            // Pointers stay within the SDK's caller-owned NetHostInfoBufType.
+            uint8_t data[96]{}; g.bytes(b,data,sizeof(data),true);
+            g.put(b,b+64,4); g.put(b+4,b+32,4); g.put(b+8,2,2); g.put(b+10,4,2);
+            g.put(b+12,b+40,4); g.put(b+40,b+48,4); g.put(b+48,0x0a000002,4);
+            char hostname[]="frond.test"; g.bytes(b+64,hostname,sizeof(hostname),true);
+            return result(b);
+        }
+        if(trap==0xa807) {
+            // Palm SDK short enums occupy the high byte of a two-byte stack slot.
+            if(g.arg(2,1)!=2 || g.arg(4,1)!=1 || (g.arg(6,2)!=0 && g.arg(6,2)!=6)) return result(-1,param);
+            for(unsigned i=0;i<sockets.size();i++) if(!sockets[i].used) { result(i+4); sockets[i].used=1; return true; }
+            return result(-1,noSockets);
+        }
+        if(trap==0xa815) {
+            const auto width=g.arg(2,2); if(width>32) return result(-1,param);
+            uint32_t ptr[3], masks[3]{}; unsigned ready=0;
+            for(unsigned j=0;j<3;j++) { ptr[j]=g.arg(4+j*4); const auto wanted=ptr[j]?g.read(ptr[j],4):0;
+                for(unsigned i=0;i<sockets.size();i++) { const auto bit=1u<<(i+4); if(i+4>=width || !(wanted&bit)) continue;
+                    const auto& s=sockets[i]; if(!s.used) return result(-1,badSocket);
+                    if((j==0 && s.size) || (j==1 && s.connected && s.size<s.bytes.size())) { masks[j]|=bit; ++ready; }
+                }
+            }
+            for(unsigned j=0;j<3;j++) if(ptr[j]) g.put(ptr[j],masks[j],4);
+            return result(ready);
+        }
+        const auto id=g.arg(2,2); if(id<4 || id>=20 || !sockets[id-4].used) return result(-1,badSocket);
+        auto& s=sockets[id-4];
+        if(trap==0xa808) { result(0); s={}; return true; }
+        if(trap==0xa80c) {
+            if(s.connected) return result(-1,alreadyConnected);
+            const auto address=g.arg(4);
+            if(g.arg(8,2)<8 || g.read(address,2)!=2) return result(-1,param);
+            if(mode==timeout) return result(-1,timedOut);
+            if(g.read(address+2,2)!=7 || g.read(address+4,4)!=0x0a000002) return result(-1,noInterfaces);
+            result(0); s.connected=1; return true;
+        }
+        if(!s.connected) return result(-1,notConnected);
+        const auto buffer=g.arg(4), length=g.arg(8,2);
+        if(g.arg(10,2) || g.arg(12)) return result(-1,unimplemented); // flags / peer-address forms
+        if(!length) return result(0);
+        if(trap==0xa811) {
+            const auto count=std::min<size_t>(length,s.bytes.size()-s.size);
+            if(!count) return result(-1,g.arg(18)?timedOut:wouldBlock);
+            std::array<uint8_t,4096> incoming{}; g.bytes(buffer,incoming.data(),count);
+            result(count); std::copy_n(incoming.data(),count,s.bytes.data()+s.size); s.size+=count; return true;
+        }
+        if(!s.size) return result(-1,g.arg(20)?timedOut:wouldBlock);
+        const auto count=std::min<uint32_t>(length,s.size);
+        g.bytes(buffer,s.bytes.data(),count,true); result(count);
+        std::memmove(s.bytes.data(),s.bytes.data()+count,s.size-count); s.size-=count;
+        std::fill(s.bytes.begin()+s.size,s.bytes.end(),0); return true;
+    } catch(const std::exception&) {
+        paceSetDreg(0,pointerResult?0:UINT32_MAX); if(pointerResult) paceSetAreg(0,0);
+        try { if(errPtr) g.put(errPtr,param,2); } catch(...) {}
+        // A bad unrelated SysLibFind argument must retain Palm's normal fault handling.
+        return trap!=0xa0ba;
+    }
+}
+#endif
