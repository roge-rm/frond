+#ifndef FROND_NETWORK_SIMULATION_H
+#define FROND_NETWORK_SIMULATION_H
+#ifndef __EMSCRIPTEN__
+#include <array>
+#include <cstdint>
+#include <string>
+#include "savestate/savestateAll.h"
+struct ArmCpu;
+// Experimental 68k NetLib fixture. No host sockets or radio emulation.
+class NetworkSimulation {
+ public:
+    static constexpr uint16_t refnum = 0x7ffe;
+    enum Mode : uint32_t { disabled, connected, timeout, disconnected };
+    Mode GetMode() const { return static_cast<Mode>(mode); }
+    const char* GetModeName() const;
+    bool SetMode(const std::string& name);
+    void Reset();
+    bool Handle(ArmCpu* cpu, uint16_t trap);
+    static bool Dispatch(void* context, ArmCpu* cpu, uint16_t trap) {
+        return static_cast<NetworkSimulation*>(context)->Handle(cpu, trap);
+    }
+    template<class S> void Save(S& state) {
+        auto* chunk = state.GetChunk(ChunkType::networkSimulation, 0);
+        SaveChunkHelper helper(*chunk); Transfer(helper);
+    }
+    void Load(SavestateLoader<ChunkType>& loader);
+ private:
+    struct Socket { uint32_t used{}, connected{}, size{}; std::array<uint8_t,4096> bytes{}; };
+    uint32_t mode{}, opens{};
+    std::array<Socket,16> sockets{};
+    template<class H> void Transfer(H& h) {
+        h.Do32(mode).Do32(opens);
+        for (auto& s : sockets) h.Do32(s.used).Do32(s.connected).Do32(s.size).DoBuffer(s.bytes.data(), s.bytes.size());
+    }
+};
+#endif
+#endif
