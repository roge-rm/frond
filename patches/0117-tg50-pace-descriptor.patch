+namespace {
+constexpr size_t tg50Database = 0x0d2f68;
+constexpr size_t tg50CodeStart = 0x0d2fe8, tg50CodeEnd = 0x10b0d8;
+constexpr uint32_t tg50VirtualBase = 0x20000000;
