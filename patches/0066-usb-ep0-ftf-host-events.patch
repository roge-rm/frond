+// Host-side bus events for endpoint 0, as the UDC sees them on the wire. Call on the
+// emulator thread between guest slices. The caller owns bus timing: an IN may only
+// complete after the packet's bus time has passed since the guest set IPR.
+enum class Pxa270UdcHostResult { Ack, Nak, Stall, Disabled, Unsupported };
+// Bus reset: drops both EP0 FIFOs, endpoint status and configuration, latches IRRS.
+bool pxa270UdcHostReset(struct Pxa270Udc *udc);
+// SETUP packet: drops any ready IN packet, loads 8 bytes, sets SA/RNE/OPC and IR0[0].
+Pxa270UdcHostResult pxa270UdcHostSetup(struct Pxa270Udc *udc, const uint8_t setup[8]);
+// OUT data (0-16 bytes): NAK while OPC is set, otherwise drops any ready IN packet.
+Pxa270UdcHostResult pxa270UdcHostOut(struct Pxa270Udc *udc, const uint8_t *data, unsigned size);
+// IN token: returns the ready packet (0-16 bytes) and ACKs it, or NAK/STALL.
+Pxa270UdcHostResult pxa270UdcHostIn(struct Pxa270Udc *udc, uint8_t data[16], unsigned *size);
