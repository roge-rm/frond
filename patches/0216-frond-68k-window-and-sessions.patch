+    void Draw(bool present = true) {
+        if (!renderer) return;
+        const float s = options.windowScale;
+        lcd.Update();
+        SDL_SetRenderDrawColor(renderer, 0, 0, 0, 0xff);
+        SDL_RenderClear(renderer);
+        if (lcdTexture) {
+            SDL_UpdateTexture(lcdTexture, nullptr, lcd.Pixels(), Lcd68k::kWidth * 4);
+            const SDL_Rect dest{0, 0, int(Lcd68k::kWidth * s), int(Lcd68k::kHeight * s)};
+            SDL_RenderCopy(renderer, lcdTexture, nullptr, &dest);
+        }
+        if (silkscreenTexture) {
+            const SDL_Rect dest{0, int(Lcd68k::kHeight * s), int(Lcd68k::kWidth * s),
+                                int((kInputHeight - Lcd68k::kHeight) * s)};
+            SDL_RenderCopy(renderer, silkscreenTexture, nullptr, &dest);
+        }
+        drawDeviceControls(renderer, deviceControls(profile->art), Lcd68k::kWidth, kInputHeight, s, pressed);
+        if (present) SDL_RenderPresent(renderer);
+    }
