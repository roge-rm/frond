+    // Doubles the capacity when it runs out, so inserts stay amortised.
+    template <typename T>
+    static void grow(std::vector<T>& v, size_t need) {
+        if (v.capacity() < need) v.reserve(std::max(need, v.capacity() * 2));
+    }
