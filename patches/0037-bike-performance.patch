--- /dev/null
+++ b/src/uarm/uarm/MMU_internal.h
@@ -0,0 +1,83 @@
+// Internal decoded TLB layout shared by the native CPU fast path.
+#ifndef FROND_MMU_INTERNAL_H
+#define FROND_MMU_INTERNAL_H
+#include "MMU.h"
+#include "cputil.h"
+#define TLB_SIZE (1 << 20)
+
+struct TlbEntry {
+    uint32_t pa : 20;
+
+    uint32_t revision : 4;
+    uint32_t ap : 2;
+    uint32_t domain : 4;
+    uint32_t c : 1;
+    uint32_t section : 1;
+};
+
+struct ArmMmu {
+    struct ArmMem *mem;
+    uint32_t transTablPA;
+    uint8_t S;
+    uint8_t R;
+    uint8_t xscale;
+    uint32_t domainCfg;
+
+    struct TlbEntry tlb[TLB_SIZE];
+    uint16_t revision;
+
+    template <typename T>
+    void DoSaveLoad(T &chunkHelper);
+};
+
+static inline uint8_t checkPermissionsForWrite(struct ArmMmu *mmu, uint_fast8_t ap,
+                                               uint_fast8_t domain, bool section,
+                                               bool priviledged) {
+    switch ((mmu->domainCfg >> (domain * 2)) & 3) {
+        case 0:  // NO ACCESS:
+        case 2:  // RESERVED: unpredictable	(treat as no access)
+            return (section ? 0x08 : 0xB) | (domain << 4);  // section or page domain fault
+
+        case 1:  // CLIENT: check permissions
+            break;
+
+        case 3:  // MANAGER: allow all access
+            return 0;
+    }
+
+    // check permissions
+
+    switch (ap) {
+        case 0:
+            break;
+
+        case 1:
+        case 2:
+            if (!priviledged) break;
+            return 0;
+
+        case 3:
+            return 0;
+    }
+
+    // perm_err:
+    return (section ? 0x0D : 0x0F) | (domain << 4);  // section or subpage permission fault
+}
+
+// Match mmuTranslate's cached translations and share its write-permission check.
+// Misses keep the authoritative page walk. No new translation state.
+template <bool write>
+static FORCE_INLINE MMUTranslateResult mmuTranslateCached(ArmMmu* mmu, uint32_t addr,
+                                                        bool privileged) {
+    if (mmu->transTablPA == MMU_DISABLED_TTP) return addr;
+    const auto& entry = mmu->tlb[addr >> 12];
+    if (entry.revision != mmu->revision)
+        return mmuTranslate(mmu, addr, privileged, write);
+    if constexpr (write) {
+        const auto fsr = checkPermissionsForWrite(mmu, entry.ap, entry.domain,
+                                                  entry.section, privileged);
+        if (fsr) return (1ull << 63) | (uint64_t(fsr) << 32);
+    }
+    return uint64_t((addr & 0xfff) | (entry.pa << 12)) | (uint64_t(entry.c) << 62);
+}
+#endif
