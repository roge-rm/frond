+bool SocPXA::SetUsbTestCable(bool connected) {
+    if (GetDeviceType() != deviceTypeTX) return false;
+    // Palm TX GPIO13 is the active-low USB cable detector. Linux palmtx.h
+    // names this GPIO_NR_PALMTX_USB_DETECT_N. No transceiver or endpoint is opened.
+    pxaGpioSetState(gpio, 13, !connected);
+    return true;
+}
