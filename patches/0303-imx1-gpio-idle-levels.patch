+bool Imx1Gpio::setInput(unsigned port, uint32_t sample) {
+    if (port >= 4) return false;
+    auto& p = ports[port];
+    if (p.sampleKnown) return p.sample == sample;
+    if (p.accessed) return false;
+    p.sample = sample;
+    p.sampleKnown = true;
+    return true;
+}
