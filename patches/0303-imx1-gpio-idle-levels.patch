+uint32_t Imx1Gpio::inactiveLevels(const Port& port, unsigned index) {
+    if (!port.sampleKnown || !port.registers[12]) return 0;
+    // Sections 32.1, 32.4 and 32.5.7: only bonded GPIO inputs in level mode.
+    constexpr uint32_t usable[] = {0xffffffff, 0xffffff00, 0xfffbfff8, 0xffffffc0};
+    const auto& r = port.registers;
+    uint32_t inactive = 0;
+    for (unsigned pin = 0; pin < 32; ++pin) {
+        const unsigned mode = (r[10 + pin / 16] >> (2 * (pin % 16))) & 3;
+        const bool high = (port.sample & (1u << pin)) != 0;
+        if ((mode == 2 && !high) || (mode == 3 && high)) inactive |= 1u << pin;
+    }
+    return inactive & usable[index] & r[8] & ~r[0];
 }
 
