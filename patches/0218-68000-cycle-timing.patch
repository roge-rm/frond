-#define get_byte			EmMemGet8
+/* CPU operand accesses add their bank's wait states to gUaeAccessWait (cputiming.h); a long is
+ * two bus cycles. Instruction fetches (get_i* in newcpu.h) are counted from the timing table. */
 
-#define put_long			EmMemPut32
-#define put_word			EmMemPut16
-#define put_byte			EmMemPut8
+STATIC_INLINE uint32 uae_get_long(emuptr a) { gUaeAccessWait += 2 * EmMemGetBank(a).waitWord; return EmMemGet32(a); }
+STATIC_INLINE uint16 uae_get_word(emuptr a) { gUaeAccessWait += EmMemGetBank(a).waitWord; return EmMemGet16(a); }
+STATIC_INLINE uint8 uae_get_byte(emuptr a) { gUaeAccessWait += EmMemGetBank(a).waitByte; return EmMemGet8(a); }
+
+STATIC_INLINE void uae_put_long(emuptr a, uint32 v) { gUaeAccessWait += 2 * EmMemGetBank(a).waitWord; EmMemPut32(a, v); }
+STATIC_INLINE void uae_put_word(emuptr a, uint16 v) { gUaeAccessWait += EmMemGetBank(a).waitWord; EmMemPut16(a, v); }
+STATIC_INLINE void uae_put_byte(emuptr a, uint8 v) { gUaeAccessWait += EmMemGetBank(a).waitByte; EmMemPut8(a, v); }
+
+#define get_long			uae_get_long
+#define get_word			uae_get_word
+#define get_byte			uae_get_byte
+
+#define put_long			uae_put_long
+#define put_word			uae_put_word
+#define put_byte			uae_put_byte
 
