+void A32AddressSpace::SetCompileThread(A32::Jit::CompileThread mode) {
+    compile_thread.reset();
+    compile_sync = mode == A32::Jit::CompileThread::Sync;
+    if (mode != A32::Jit::CompileThread::Off) {
