+inline bool readAllAt(int fd, void* data, size_t n, uint64_t offset) {
+    auto* p = static_cast<uint8_t*>(data);
+    while (n) {
+        const auto r = pread(fd, p, n, off_t(offset));
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) return false;
+        p += r;
+        n -= size_t(r);
+        offset += uint64_t(r);
+    }
+    return true;
+}
