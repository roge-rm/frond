+// A sound full copy at this generation, when the sidecar isn't there yet, is renamed into place.
+// Anything else refuses the load.
+inline bool settleSdJournal(const std::filesystem::path& folder, const frondMachine::Media& card) {
+    const auto sidecar = folder / frondMachine::sdSibling;
