+// SD save journal, sd.frondsd.journal-<to generation>. Little-endian:
+// header 64 bytes: "FRONDJNL", version u32 1, zero u32, payload bytes u64, from generation u64,
+// to generation u64, record count u64, table count u64, 8 zero bytes;
+// records: payload offset u64, length u32, bytes; then the complete new chunk table;
+// trailer 16 bytes: "FRONDEND", CRC32 of everything before the trailer u32, zero u32.
+// It is written as a temp and renamed, so a journal under its own name is complete.
+constexpr size_t journalHeaderBytes = 64, journalTrailerBytes = 16, journalRecordBytes = 12;
+
+inline std::filesystem::path sdJournalPath(const std::filesystem::path& folder, uint64_t toGeneration) {
+    return folder / (std::string(frondMachine::sdJournalPrefix) + std::to_string(toGeneration));
+}
+
+// A full copy at `generation`, fsynced under this name before the .frond that describes it is
+// published, then renamed onto sd.frondsd. Shares the journal prefix so frontends leave it alone.
+inline std::filesystem::path sdFullPath(const std::filesystem::path& folder, uint64_t generation) {
+    return folder / (std::string(frondMachine::sdJournalPrefix) + std::to_string(generation) + ".full");
+}
+
+inline std::vector<std::filesystem::path> sdJournals(const std::filesystem::path& folder) {
+    std::vector<std::filesystem::path> found;
+    std::error_code ec;
+    const std::string prefix = frondMachine::sdJournalPrefix;
+    for (std::filesystem::directory_iterator it(folder, ec), end; !ec && it != end; it.increment(ec)) {
+        const auto name = it->path().filename().string();
+        if (name.compare(0, prefix.size(), prefix) == 0) found.push_back(it->path());
+    }
+    return found;
+}
+
+inline void removeSdJournals(const std::filesystem::path& folder, const std::filesystem::path& keep = {}) {
+    bool removed = false;
+    for (const auto& path : sdJournals(folder)) {
+        if (!keep.empty() && path == keep) continue;
+        removePath(path);
+        removed = true;
+    }
+    if (removed) syncDir(folder);
+}
