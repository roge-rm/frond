+void cpuSetInstructionObserverSites(ArmCpu* cpu, const uint32_t* sites, unsigned count) {
+    if (count > sizeof(cpu->instructionSites) / sizeof(cpu->instructionSites[0])) count = 0;
+    for (unsigned i = 0; i < count; ++i) cpu->instructionSites[i] = sites[i];
+    cpu->instructionSiteCount = count;
+    cpuDropTranslatedCode(cpu);
+}
+// An ARM instruction the observer may act on: one of its sites, or anywhere in its range
+// without sites.
+static bool cpuPrvObservedSite(const ArmCpu* cpu, uint32_t pc) {
+    if (!cpu->instructionObserver || pc < cpu->instructionFirst || pc > cpu->instructionLast)
+        return false;
+    if (!cpu->instructionSiteCount) return true;
+    for (unsigned i = 0; i < cpu->instructionSiteCount; ++i)
+        if (cpu->instructionSites[i] == pc) return true;
+    return false;
 }
 
