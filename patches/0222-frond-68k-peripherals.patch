diff --git a/src/cloudpilot/frond/HostLink.cpp b/src/cloudpilot/frond/HostLink.cpp
new file mode 100644
index 0000000..23c561c
--- /dev/null
+++ b/src/cloudpilot/frond/HostLink.cpp
@@ -0,0 +1,190 @@
+#include "HostLink.h"
+
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+
+bool nonblocking(int fd) {
+    const int flags = fcntl(fd, F_GETFL);
+    return flags >= 0 && fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0 && fcntl(fd, F_SETFD, FD_CLOEXEC) == 0;
+}
+
+void closeFd(int& fd) {
+    if (fd >= 0) close(fd);
+    fd = -1;
+}
+
+}  // namespace
+
+bool HostLink68k::Parse(const std::string& text, Kind& kind, uint16_t& port) {
+    port = 0;
+    if (text == "off" || text == "pty") {
+        kind = text == "off" ? Kind::off : Kind::pty;
+        return true;
+    }
+    if (text.rfind("tcp:", 0) != 0 || text.size() < 5 || text.size() > 9) return false;
+    unsigned value = 0;
+    for (size_t i = 4; i < text.size(); ++i) {
+        if (text[i] < '0' || text[i] > '9') return false;
+        value = value * 10 + unsigned(text[i] - '0');
+    }
+    if (value > 65535) return false;
+    kind = Kind::tcp;
+    port = uint16_t(value);
+    return true;
+}
+
+bool HostLink68k::Open(Kind newKind, uint16_t newPort, std::string& error) {
+    Close();
+    if (newKind == Kind::off) return true;
+    if (newKind == Kind::pty) {
+        fd = posix_openpt(O_RDWR | O_NOCTTY);
+        const char* name = fd >= 0 && grantpt(fd) == 0 && unlockpt(fd) == 0 ? ptsname(fd) : nullptr;
+        termios raw{};
+        if (!name || !nonblocking(fd) || tcgetattr(fd, &raw) != 0) {
+            error = std::string("could not open a PTY: ") + strerror(errno);
+            closeFd(fd);
+            return false;
+        }
+        cfmakeraw(&raw);
+        tcsetattr(fd, TCSANOW, &raw);
+        endpoint = name;
+        // A new PTY has no slave open yet; the first open isn't reported, so count it as there.
+        hung = false;
+    } else {
+        fd = socket(AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        const int on = 1;
+        sockaddr_in address{};
+        address.sin_family = AF_INET;
+        address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        address.sin_port = htons(newPort);
+        socklen_t length = sizeof(address);
+        if (fd < 0 || setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on)) != 0 ||
+            bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0 || listen(fd, 1) != 0 ||
+            getsockname(fd, reinterpret_cast<sockaddr*>(&address), &length) != 0) {
+            error = "could not listen on 127.0.0.1:" + std::to_string(newPort) + ": " + strerror(errno);
+            closeFd(fd);
+            return false;
+        }
+        port = ntohs(address.sin_port);
+        endpoint = "127.0.0.1:" + std::to_string(port);
+    }
+    kind = newKind;
+    return true;
+}
+
+void HostLink68k::Close() {
+    closeFd(client);
+    closeFd(fd);
+    kind = Kind::off;
+    endpoint.clear();
+    rx.clear();
+    tx.clear();
+    hung = false;
+}
+
+bool HostLink68k::Connected() const {
+    return kind == Kind::pty ? !hung : kind == Kind::tcp ? client >= 0 : false;
+}
+
+std::string HostLink68k::Describe() const {
+    if (kind == Kind::off) return "off";
+    return std::string(kind == Kind::pty ? "pty " : "tcp ") + endpoint + (Connected() ? " connected" : " waiting");
+}
+
+std::string HostLink68k::Mode() const {
+    return kind == Kind::off ? "off" : kind == Kind::pty ? "pty" : "tcp:" + std::to_string(port);
+}
+
+// What the peer sent before it went is still the guest's, like its last acknowledgement.
+void HostLink68k::Disconnect() {
+    tx.clear();
+    if (kind == Kind::tcp) closeFd(client);
+    else hung = true;
+}
+
+// Moves bytes both ways; false when the peer went away.
+bool HostLink68k::Pump(int io) {
+    uint8_t buffer[4096];
+    while (rx.size() < kQueueBytes) {
+        const ssize_t got = read(io, buffer, std::min(sizeof(buffer), kQueueBytes - rx.size()));
+        if (got > 0) {
+            rx.insert(rx.end(), buffer, buffer + got);
+            received += size_t(got);
+            continue;
+        }
+        if (got == 0) return false;
+        if (errno == EINTR) continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK) break;
+        return false;  // EIO: the PTY's last slave closed
+    }
+    while (!tx.empty()) {
+        const size_t count = std::min(tx.size(), sizeof(buffer));
+        std::copy(tx.begin(), tx.begin() + count, buffer);
+        const ssize_t done = write(io, buffer, count);
+        if (done > 0) {
+            tx.erase(tx.begin(), tx.begin() + done);
+            sent += size_t(done);
+            continue;
+        }
+        if (done < 0 && errno == EINTR) continue;
+        if (done < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) break;
+        return false;
+    }
+    return true;
+}
+
+void HostLink68k::Poll() {
+    if (kind == Kind::off) return;
+    if (kind == Kind::tcp) {
+        while (true) {
+            const int accepted = accept(fd, nullptr, nullptr);
+            if (accepted < 0) break;
+            if (client >= 0 || !nonblocking(accepted)) {
+                close(accepted);
+                continue;
+            }
+            const int on = 1;
+            setsockopt(accepted, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on));
+            client = accepted;
+            rx.clear();
+        }
+        if (client >= 0 && !Pump(client)) Disconnect();
+        return;
+    }
+    // A PTY master reports POLLHUP from when the last slave closes until a program opens it again.
+    if (hung) {
+        pollfd probe{fd, POLLIN, 0};
+        if (poll(&probe, 1, 0) < 0 || (probe.revents & POLLHUP)) return;
+        hung = false;
+    }
+    if (!Pump(fd)) {
+        Disconnect();
+        tcflush(fd, TCIFLUSH);
+    }
+}
+
+size_t HostLink68k::Take(uint8_t* out, size_t max) {
+    const size_t count = std::min(max, rx.size());
+    std::copy(rx.begin(), rx.begin() + count, out);
+    rx.erase(rx.begin(), rx.begin() + count);
+    return count;
+}
+
+void HostLink68k::Send(const uint8_t* data, size_t size) {
+    if (!Connected()) return;
+    const size_t room = kQueueBytes - std::min(kQueueBytes, tx.size());
+    tx.insert(tx.end(), data, data + std::min(size, room));
+}
diff --git a/src/cloudpilot/frond/HostLink.h b/src/cloudpilot/frond/HostLink.h
new file mode 100644
index 0000000..87a0fac
--- /dev/null
+++ b/src/cloudpilot/frond/HostLink.h
@@ -0,0 +1,63 @@
+#ifndef FROND_68K_HOST_LINK_H
+#define FROND_68K_HOST_LINK_H
+
+// A byte pipe to a host PTY or a TCP listener on 127.0.0.1 (one client at a time), for the
+// DragonBall UART's serial and infrared sides. Non-blocking, polled from the main loop; all
+// methods run on the emulator thread.
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <string>
+
+class HostLink68k {
+   public:
+    enum class Kind { off, pty, tcp };
+    // Bytes held each way. Reading from the host stops while the receive side is full; bytes
+    // the guest sends with no peer, or past this, are dropped.
+    static constexpr size_t kQueueBytes = 65536;
+
+    // off, pty or tcp:PORT (0 picks a free port).
+    static bool Parse(const std::string& text, Kind& kind, uint16_t& port);
+
+    HostLink68k() = default;
+    ~HostLink68k() { Close(); }
+    HostLink68k(const HostLink68k&) = delete;
+    HostLink68k& operator=(const HostLink68k&) = delete;
+
+    // Off closes and opens nothing.
+    bool Open(Kind kind, uint16_t port, std::string& error);
+    void Close();
+    // Accepts a client, notices a PTY peer coming and going, moves bytes both ways.
+    void Poll();
+
+    Kind GetKind() const { return kind; }
+    bool Connected() const;
+    // off, or "pty /dev/pts/N" / "tcp 127.0.0.1:PORT" and "connected" or "waiting".
+    std::string Describe() const;
+    // The mode as --serial takes it: off, pty or tcp:PORT.
+    std::string Mode() const;
+
+    size_t Available() const { return rx.size(); }
+    size_t Take(uint8_t* out, size_t max);
+    void Send(const uint8_t* data, size_t size);
+    void DropReceived() { rx.clear(); }
+
+    uint64_t Received() const { return received; }
+    uint64_t Sent() const { return sent; }
+
+   private:
+    void Disconnect();
+    bool Pump(int fd);
+
+    Kind kind{Kind::off};
+    uint16_t port{0};
+    int fd{-1};      // PTY master or TCP listener
+    int client{-1};  // TCP client
+    bool hung{false};  // PTY with no slave open
+    std::string endpoint;
+    std::deque<uint8_t> rx, tx;
+    uint64_t received{0}, sent{0};
+};
+
+#endif
diff --git a/src/cloudpilot/frond/HostTransport.h b/src/cloudpilot/frond/HostTransport.h
new file mode 100644
index 0000000..098cc92
--- /dev/null
+++ b/src/cloudpilot/frond/HostTransport.h
@@ -0,0 +1,80 @@
+#ifndef FROND_68K_HOST_TRANSPORT_H
+#define FROND_68K_HOST_TRANSPORT_H
+
+// Cloudpilot's serial transport for one side of the DragonBall UART (the cradle serial port or
+// the IR port) on a host link. Bytes from the host reach the guest no faster than the baud
+// rate the guest set, so a burst from the host doesn't overrun the UART's receive FIFO.
+
+#include <algorithm>
+
+#include "EmSession.h"
+#include "EmTransportSerial.h"
+#include "HostLink.h"
+
+class HostTransport68k : public EmTransportSerial {
+   public:
+    explicit HostTransport68k(HostLink68k& link) : link(link) {}
+
+    bool Open() override {
+        open = true;
+        link.DropReceived();
+        mark = gSession->GetSystemCycles();
+        return true;
+    }
+    bool Close() override {
+        open = false;
+        return true;
+    }
+    bool IsOpen() const { return open; }
+
+    bool Read(long& count, void* data) override {
+        count = long(link.Take(static_cast<uint8_t*>(data), size_t(std::max(0L, std::min(count, Credit())))));
+        credit -= count;
+        return true;
+    }
+    bool Write(long& count, const void* data) override {
+        if (open && count > 0) link.Send(static_cast<const uint8_t*>(data), size_t(count));
+        return true;
+    }
+    bool CanRead() override { return open && link.Available() && Credit() > 0; }
+    bool CanWrite() override { return open; }
+    size_t BytesPending() override { return open ? std::min<size_t>(link.Available(), size_t(Credit())) : 0; }
+
+    void SetRTS(RTSControl) override {}
+    void SetDTR(bool) override {}
+    void SetBreak(bool) override {}
+    bool RequiresSync() override { return false; }
+    void OnTransactionStateChange(EmUARTDragonball::TransactionState, EmUARTDragonball::TransactionState) override {}
+
+    // Called between slices. Follows the guest's line driver for this side, which a session
+    // load doesn't report; with the port closed, what the host sends is dropped.
+    void Service(bool lineDriverOn) {
+        if (lineDriverOn != open) lineDriverOn ? Open() : Close();
+        if (!open) link.DropReceived();
+    }
+
+   private:
+    // Bytes the guest could have received since the last read at its baud rate (10 bits a
+    // byte), up to a FIFO's worth when idle.
+    long Credit() {
+        const uint64_t now = gSession->GetSystemCycles();
+        const double perByte = gSession->GetClocksPerSecond() * 10.0 / std::max<long>(config.fBaud, 300);
+        if (now > mark && perByte > 0) {
+            const long more = long(double(now - mark) / perByte);
+            if (more > 0) {
+                credit = std::min<long>(credit + more, 64);
+                mark += uint64_t(more * perByte);
+            }
+        } else if (now < mark) {
+            mark = now;
+        }
+        return credit;
+    }
+
+    HostLink68k& link;
+    bool open{false};
+    long credit{0};
+    uint64_t mark{0};
+};
+
+#endif
