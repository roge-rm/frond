+    const uint32_t bigHal = Read32(big + 0x84, error);
+    const uint32_t bigLength = Read32(big + 0x6c, error);
+
+    return !error && cardName == "PalmCard" && bigName == cardName && bigCompany == companyId &&
+           bigHal == halId && big + bigLength == size;
