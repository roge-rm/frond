+        const SDL_Rect dest{0,height*scale,canvas.w,canvas.h};
+        SDL_RenderCopy(renderer,texture,nullptr,&dest);
+        SDL_DestroyTexture(texture);
+    }
+    SDL_FreeSurface(surface);
 }
