-    kTimingBitImm     /* 2 more for an immediate bit number of 16 or more */
+    kTimingBitImm,    /* 2 more for an immediate bit number of 16 or more */
+    kTimingReadFirst  /* CLR, Scc and MOVE from SR to memory: the 68000 reads the operand
