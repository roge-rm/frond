+#ifndef FROND_SONY_DAC_PREVIEW_H
+#define FROND_SONY_DAC_PREVIEW_H
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+// Emulator-thread host state. Tags follow actual DMA words through every queue;
+// portable guest samples, FIFO timing and PWM state are never changed here.
+class SonyDacPreview {
+public:
+    static constexpr unsigned maxFrames = 1024, maxGenerations = 8;
+    struct Tag { uint64_t generation{}; uint16_t frame{}; bool matches{true}; };
+    struct Identity {
+        uint32_t node{}, token{}, context{};
+        uintptr_t backing{};
+        uint32_t frames{};
+    };
+    struct Generation {
+        Identity identity{};
+        uint64_t id{};
+        uint32_t dmaNext{}, previewNext{}, references{};
+        bool completed{}, cancelled{}, preview{}, transportDiscarded{};
+        std::array<uint32_t, maxFrames> raw{};
+        // 1: preview delivered, 2: serial processed/discarded, 4: suppression spent.
+        std::array<uint8_t, maxFrames> delivered{};
+        std::array<uint32_t, maxFrames> outstanding{};
+        std::array<bool, maxFrames> read{};
+    };
+
+    uint64_t Submit(Identity identity, const uint32_t *raw, bool eligible) {
+        if (!raw || !identity.node || !identity.context || !identity.backing ||
+            identity.backing % 4 || !identity.frames || identity.frames > maxFrames ||
+            identity.backing > std::numeric_limits<uintptr_t>::max() - identity.frames * 4 || !nextId) {
+            Fence(); return 0;
+        }
+        for (const auto &g : generations) {
+            if (!g.id) continue;
+            if (g.identity.node == identity.node && !g.completed && !g.cancelled) {
+                Fence(); return 0;
+            }
+            if (g.identity.context != identity.context) { Fence(); return 0; }
+            if ((!g.completed || g.dmaNext != g.identity.frames) && identity.backing < g.identity.backing + g.identity.frames * 4 &&
+                g.identity.backing < identity.backing + identity.frames * 4) {
+                Fence(); return 0;
+            }
+        }
+        for (auto &g : generations) if (!g.id) {
+            g = {};
+            g.identity = identity; g.id = nextId++;
+            for (unsigned i = 0; i < identity.frames; ++i) g.raw[i] = raw[i];
+            g.preview = eligible && !fenced;
+            return g.id;
+        }
+        Fence(); return 0;
+    }
+
+    Tag Dma(uintptr_t backing, unsigned width, uint32_t raw) {
+        Generation *found = nullptr;
+        for (auto &g : generations) {
+            if (!g.id || g.transportDiscarded || (g.completed && g.dmaNext == g.identity.frames)) continue;
+            if (backing >= g.identity.backing &&
+                backing - g.identity.backing < uint64_t(g.identity.frames) * 4) {
+                if (found) { Fence(); return {}; }
+                found = &g;
+            }
+        }
+        if (!found) { Fence(); return {}; }
+        auto &g = *found;
+        const auto offset = backing - g.identity.backing;
+        // An unsupported width cannot enqueue in the word-only I2S target.
+        if (width != 4 || offset % 4) { Fence(); return {}; }
+        const auto frame = static_cast<uint16_t>(offset / 4);
+        if (frame != g.dmaNext || g.raw[frame] != raw) Fence();
+        // Retain known provenance after a mismatch, including earlier duplicates.
+        const Tag result{g.id, frame, g.raw[frame] == raw};
+        if (g.outstanding[frame] == std::numeric_limits<uint32_t>::max() ||
+            g.references == std::numeric_limits<uint32_t>::max()) { Fence(); return {}; }
+        ++g.outstanding[frame];
+        g.read[frame] = true;
+        while (g.dmaNext < g.identity.frames && g.read[g.dmaNext]) ++g.dmaNext;
+        ++g.references;
+        return result;
+    }
+
+    void Complete(uint32_t node, uint32_t token, bool cancelled = false) {
+        for (auto &g : generations) if (g.id && !g.completed && !g.cancelled &&
+            g.identity.node == node && g.identity.token == token) {
+            g.completed = !cancelled; g.cancelled = cancelled;
+            if (cancelled) { g.preview = false; Fence(); }
+            if (!cancelled && g.dmaNext != g.identity.frames) Fence();
+            Retire(g); return;
+        }
+        Fence();
+    }
+
+    // Every actual word reaches this once, including discarded FIFO/mixer words.
+    void Discard(Tag tag) {
+        auto *g = Find(tag);
+        if (!g) { if (tag.generation) Fence(); return; }
+        if (!g->outstanding[tag.frame]) { Fence(); return; }
+        --g->outstanding[tag.frame];
+        g->delivered[tag.frame] |= 2;
+        if (!g->references) { Fence(); return; }
+        --g->references; Retire(*g);
+    }
+
+    // Called once on the ordinary mixer cadence, after portable DAC consumption.
+    uint32_t Render(uint32_t ordinary, Tag actual, const uint32_t gain[2]) {
+        if (gain[0] > 65536 || gain[1] > 65536) Fence();
+        uint32_t result = Serial(actual) ? 0 : ordinary;
+
+        if (!fenced) {
+            Generation *earliest = nullptr;
+            for (auto &g : generations) if (g.id && g.preview) {
+                while (g.previewNext < g.identity.frames && g.delivered[g.previewNext])
+                    ++g.previewNext;
+                if (g.previewNext < g.identity.frames && (!earliest || g.id < earliest->id))
+                    earliest = &g;
+            }
+            if (earliest) {
+                // Unpreviewed ordinary audio must never be overwritten.
+                if (result) Fence();
+                else {
+                    auto &g = *earliest;
+                    const auto word = g.raw[g.previewNext];
+                    const auto left = int16_t(int64_t(int16_t(word)) * gain[0] / 65536);
+                    const auto right = int16_t(int64_t(int16_t(word >> 16)) * gain[1] / 65536);
+                    result = uint16_t(left) | (uint32_t(uint16_t(right)) << 16);
+                    g.delivered[g.previewNext++] |= 1;
+                }
+            }
+        }
+        return result;
+    }
+
+    // Decide once at actual serial consumption, before gain/resampling. Marking
+    // processed here prevents a later preview of a word already in the DAC path.
+    bool Serial(Tag tag) {
+        bool suppress = false;
+        if (auto *g = Find(tag)) {
+            if (!g->outstanding[tag.frame]) { Fence(); return false; }
+            auto &status = g->delivered[tag.frame];
+            suppress = tag.matches && (status & 1) && !(status & 4);
+            status |= 2 | (suppress ? 4 : 0);
+        } else if (tag.generation) Fence();
+        Discard(tag);
+        return suppress;
+    }
+
+    // Pause/control loss stops future preview, retaining heard-word suppression.
+    void Fence() { fenced = true; for (auto &g : generations) g.preview = false; }
+    bool Start() {
+        // Restart within a silent edge only when every retained raw word is zero.
+        // The owner must also establish silence in untagged pipeline entries.
+        for (const auto &g : generations) if (g.id)
+            for (unsigned i = 0; i < g.identity.frames; ++i)
+                if (g.raw[i]) return false;
+        for (auto &g : generations) if (g.id && !g.cancelled) g.preview = true;
+        fenced = false; return true;
+    }
+    bool Quiescent() const {
+        for (const auto &g : generations) if (g.id) return false;
+        return true;
+    }
+    bool Fenced() const { return fenced; }
+    const std::array<Generation, maxGenerations> &Generations() const { return generations; }
+    void Replace() { generations = {}; fenced = true; }
+
+    // Caller must prove the transport cannot read any remaining source words.
+    // Existing FIFO/codec/mixer references still keep their suppression alive.
+    void TransportDiscarded(uint64_t generation) {
+        for (auto &g : generations) if (g.id == generation) {
+            g.dmaNext = g.identity.frames;
+            g.cancelled = true; g.preview = false; g.transportDiscarded = true;
+            Fence(); Retire(g); return;
+        }
+        Fence();
+    }
+
+private:
+    Generation *Find(Tag tag) {
+        if (!tag.generation) return nullptr;
+        for (auto &g : generations)
+            if (g.id == tag.generation && tag.frame < g.identity.frames) return &g;
+        return nullptr;
+    }
+    static void Retire(Generation &g) {
+        if (!g.references && (g.transportDiscarded || (g.completed && g.dmaNext == g.identity.frames))) g = {};
+    }
+    std::array<Generation, maxGenerations> generations{};
+    uint64_t nextId{1};
+    bool fenced{true};
+};
+#endif
