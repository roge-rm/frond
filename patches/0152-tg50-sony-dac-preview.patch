+#ifndef FROND_SONY_DAC_HOST_H
+#define FROND_SONY_DAC_HOST_H
+#include "SonyDacPreview.h"
+#include "Tg50Audio.h"
+#include "pxa_DMA.h"
+#include "pxa_I2S.h"
+#include "i2sdev_AK4534.h"
+
+// One emulator-thread owner. No pointers, provenance or preview PCM are portable.
+class SonyDacHost {
+public:
+    using Canonical = uintptr_t (*)(void *, uint32_t, unsigned);
+    struct Frame { uint32_t portable{}, host{}; };
+    struct State {
+        SonyDacPreview ledger;
+        std::array<SonyDacPreview::Tag,16> fifo{};
+        SonyDacPreview::Tag scoped{}, serial{};
+        std::array<Frame,16> dac{};
+        unsigned fifoCount{}, dacCount{};
+        bool inWrite{};
+        Ak4534HostState partial{};
+    };
+    SonyDacHost(PxaDma *dma, PxaI2s *i2s, AK4534 *codec, Tg50Audio &mixer,
+                void *context, Canonical canonical)
+        : dma(dma), i2s(i2s), codec(codec), context(context), canonical(canonical) {
+        uint32_t words[16]{};
+        state.fifoCount = pxaI2sTxSnapshot(i2s,words);
+        const auto &initial = mixer.GetState();
+        state.dacCount = initial.dacCount;
+        for (unsigned i=0;i<state.dacCount;++i) state.dac[i] = {initial.dac[i],initial.dac[i]};
+        pxaDmaSetWriteObserver(dma,this,[](void *p,bool before,uint32_t source,
+                                        uint32_t target,unsigned width,uint32_t value,bool success) {
+            if (target == 0x40400080) static_cast<SonyDacHost *>(p)->Dma(before,source,width,value,success);
+        });
+        pxaI2sSetTxObserver(i2s,this,[](void *p,PxaI2sTxEvent event,uint32_t) {
+            static_cast<SonyDacHost *>(p)->Fifo(event);
+        });
+        ak4534SetHostRoute(codec,this,[](void *p,bool tx) {
+            auto &self = *static_cast<SonyDacHost *>(p);
+            const auto tag = self.state.serial; self.state.serial = {};
+            if (!tx) { self.state.ledger.Discard(tag); return false; }
+            return self.state.ledger.Serial(tag);
+        },[](void *p,uint32_t portable,uint32_t host) {
+            auto &self = *static_cast<SonyDacHost *>(p);
+            if (self.state.dacCount == self.state.dac.size()) { self.Fence(); return; }
+            self.state.dac[self.state.dacCount++] = {portable,host};
+        },[](void *p) { static_cast<SonyDacHost *>(p)->Fence(); },[](void *p) {
+            auto &self = *static_cast<SonyDacHost *>(p);
+            self.Fence(); self.state.dac = {}; self.state.dacCount = 0;
+        });
+    }
+    ~SonyDacHost() {
+        pxaDmaSetWriteObserver(dma,nullptr,nullptr);
+        pxaI2sSetTxObserver(i2s,nullptr,nullptr);
+        ak4534SetHostRoute(codec,nullptr,nullptr,nullptr);
+    }
+    SonyDacHost(const SonyDacHost &) = delete;
+    SonyDacHost &operator=(const SonyDacHost &) = delete;
+    SonyDacPreview &Ledger() { return state.ledger; }
+    void Fence() { state.ledger.Fence(); }
+    bool Start() {
+        const auto status = ak4534GetHostStatus(codec);
+        if (!status.stable44100Stereo || state.serial.generation || state.inWrite) return false;
+        uint32_t words[16]{};
+        if (pxaI2sTxSnapshot(i2s,words) != state.fifoCount) return false;
+        for (unsigned i=0;i<state.fifoCount;++i) if (words[i]) return false;
+        for (unsigned i=0;i<state.dacCount;++i)
+            if (state.dac[i].portable || state.dac[i].host) return false;
+        return state.ledger.Start();
+    }
+    uint32_t Select(uint32_t portable,bool present) {
+        uint32_t host = portable;
+        if (present) {
+            if (!state.dacCount || state.dac[0].portable != portable) Fence();
+            else host = state.dac[0].host;
+            if (state.dacCount) Shift(state.dac,state.dacCount);
+        }
+        const auto status = ak4534GetHostStatus(codec);
+        if (!status.stable44100Stereo) Fence();
+        return state.ledger.Render(host,{},status.gain);
+    }
+    State Capture() const { auto copy = state; copy.partial = ak4534GetHostState(codec); return copy; }
+    bool Restore(const State &saved) {
+        if (saved.fifoCount > 16 || saved.dacCount > 16 || saved.inWrite ||
+            !ak4534RestoreHostState(codec,saved.partial)) return false;
+        state = saved; return true;
+    }
+
+private:
+    template <typename T> static void Shift(T &queue,unsigned &count) {
+        for (unsigned i=1;i<count;++i) queue[i-1] = queue[i];
+        queue[--count] = {};
+    }
+    void Dma(bool before,uint32_t source,unsigned width,uint32_t value,bool success) {
+        if (before) {
+            if (state.inWrite) { Fence(); return; }
+            state.inWrite = true;
+            const auto address = canonical ? canonical(context,source,width) : 0;
+            if (success && address) state.scoped = state.ledger.Dma(address,width,value);
+            else Fence();
+        } else {
+            if (state.scoped.generation) state.ledger.Discard(state.scoped);
+            state.scoped = {}; state.inWrite = false;
+            if (!success) Fence();
+        }
+    }
+    void Fifo(PxaI2sTxEvent event) {
+        switch (event) {
+            case PxaI2sTxEvent::enqueue:
+                if (state.fifoCount == 16) { Fence(); return; }
+                state.fifo[state.fifoCount++] = state.scoped;
+                if (!state.inWrite || !state.scoped.generation) Fence();
+                state.scoped = {}; break;
+            case PxaI2sTxEvent::dequeue:
+            case PxaI2sTxEvent::discard:
+                if (!state.fifoCount) { Fence(); break; }
+                if (event == PxaI2sTxEvent::discard) state.ledger.Discard(state.fifo[0]);
+                else {
+                    if (state.serial.generation) { state.ledger.Discard(state.serial); Fence(); }
+                    state.serial = state.fifo[0];
+                }
+                Shift(state.fifo,state.fifoCount); break;
+            case PxaI2sTxEvent::repeat:
+                if (state.serial.generation) state.ledger.Discard(state.serial);
+                state.serial = {}; Fence(); break;
+            case PxaI2sTxEvent::control: Fence(); break;
+        }
+    }
+    PxaDma *dma;
+    PxaI2s *i2s;
+    AK4534 *codec;
+    void *context;
+    Canonical canonical;
+    State state{};
+};
+#endif
