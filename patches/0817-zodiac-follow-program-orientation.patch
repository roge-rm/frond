+++ b/src/uarm/uarm/guest_orientation.h
@@ -0,0 +1,22 @@
+#ifndef FROND_GUEST_ORIENTATION_H
+#define FROND_GUEST_ORIENTATION_H
+
+// Which orientation the OS has chosen, from the display's scan orientation (SysGetOrientation numbers,
+// 0 while the display is off). The DAL logo is scanned unturned, which reads as portrait, so after any
+// reset nothing counts until the OS first goes landscape. A guest reset never passes through the SoC's
+// Reset, but the display is off while it restarts, so a 0 starts the wait again.
+class GuestOrientationTracker {
+  public:
+    void Restart() { booting = true; }
+    void Loaded() { booting = false; }
+    unsigned Update(unsigned scan) {
+        if (!scan) booting = true;
+        else if (booting && scan == 2) booting = false;
+        return booting ? 0 : scan;
+    }
+
+  private:
+    bool booting{true};
+};
+
+#endif
