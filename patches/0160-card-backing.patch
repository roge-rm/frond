diff --git a/src/uarm/uarm/CardBacking.h b/src/uarm/uarm/CardBacking.h
new file mode 100644
index 0000000..8358da5
--- /dev/null
+++ b/src/uarm/uarm/CardBacking.h
@@ -0,0 +1,93 @@
+#ifndef FROND_CARD_BACKING_H
+#define FROND_CARD_BACKING_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+// Milestone 1 inventory of whole-card paths (do not rewrite these yet):
+//
+// sdCardData: uarm/sdcard.cpp; web/uarm.cpp GetSdCardData*; native/Commands.cpp
+// save/export; native/DesktopControl.h sd-export and save; native/ReadOnlyGuest.h
+// copy/restore; tests/tx-lifecycle-rom.cpp; tests/e2-state.cpp.
+//
+// SessionFile5 GetSd/SetSd: common/session/session_file5.{h,cpp}; native/main.cpp
+// readSession; native/Commands.cpp and DesktopControl.h save; tests/sd-session.cpp,
+// e2-state.cpp, device-profiles.cpp, tx-lifecycle-rom.cpp; GetSdSize guards in
+// tests/tx-power-rom.cpp, tests/device-session.cpp, tools/benchmark-*.cpp.
+//
+// There is no sdCardInsert. Insertion is SoC::SdInsert / SdEject / SdRemount and
+// deviceSetSdCardInserted: SoC.cpp, soc_generic_impl.h, native/main.cpp,
+// Commands.cpp, DesktopControl.h, web/uarm.cpp, device boards, tests.
+//
+// Memory Stick in savestate: msCtrlrSave embeds a compressed physical image
+// (mmiodev_MemoryStickController.cpp); soc.Save reaches it through the TG50
+// board OnSave. msCtrlrExport / MemoryStickMedia::CopyImage feed host export.
+// ReadOnlyGuest does not copy MS separately; the whole-card bytes travel inside
+// the savestate from soc.Save. GuestFiles/database work uses ReadOnlyGuest, so
+// they inherit that savestate embedding and the separate SD sdCardData copy.
+//
+// Checked 64-bit card payload. offset+length is never formed until both fit.
+
+inline bool cardRangeOk(uint64_t size, uint64_t offset, uint64_t length, size_t* hostLength = nullptr) {
+    if (offset > size) return false;
+    if (length > size - offset) return false;
+    if (offset > std::numeric_limits<size_t>::max()) return false;
+    if (length > std::numeric_limits<size_t>::max()) return false;
+    if (hostLength) *hostLength = static_cast<size_t>(length);
+    return true;
+}
+
+class CardBacking {
+   public:
+    virtual ~CardBacking() = default;
+    virtual uint64_t Size() const = 0;
+
+    bool Read(uint64_t offset, uint64_t length, void* dest) const {
+        size_t n = 0;
+        if (!cardRangeOk(Size(), offset, length, &n)) return false;
+        if (n == 0) return true;
+        if (!dest) return false;
+        return ReadBytes(static_cast<size_t>(offset), n, dest);
+    }
+
+    bool Write(uint64_t offset, uint64_t length, const void* src) {
+        size_t n = 0;
+        if (!cardRangeOk(Size(), offset, length, &n)) return false;
+        if (n == 0) return true;
+        if (!src) return false;
+        return WriteBytes(static_cast<size_t>(offset), n, src);
+    }
+
+   protected:
+    virtual bool ReadBytes(size_t offset, size_t length, void* dest) const = 0;
+    virtual bool WriteBytes(size_t offset, size_t length, const void* src) = 0;
+};
+
+// Tiny-fixture RAM backing. File copy-on-write generations belong to milestone 2.
+class RamCardBacking : public CardBacking {
+   public:
+    explicit RamCardBacking(size_t size) : bytes_(size) {}
+    explicit RamCardBacking(std::vector<uint8_t> bytes) : bytes_(std::move(bytes)) {}
+
+    uint64_t Size() const override { return bytes_.size(); }
+    const std::vector<uint8_t>& Bytes() const { return bytes_; }
+
+   protected:
+    bool ReadBytes(size_t offset, size_t length, void* dest) const override {
+        std::memcpy(dest, bytes_.data() + offset, length);
+        return true;
+    }
+
+    bool WriteBytes(size_t offset, size_t length, const void* src) override {
+        std::memcpy(bytes_.data() + offset, src, length);
+        return true;
+    }
+
+   private:
+    std::vector<uint8_t> bytes_;
+};
+
+#endif
diff --git a/src/uarm/uarm/FrondSdImage.h b/src/uarm/uarm/FrondSdImage.h
new file mode 100644
index 0000000..8da167b
--- /dev/null
+++ b/src/uarm/uarm/FrondSdImage.h
@@ -0,0 +1,75 @@
+#ifndef FROND_SD_IMAGE_H
+#define FROND_SD_IMAGE_H
+
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+#define MINIZ_NO_ZLIB_COMPATIBLE_NAMES
+#include "zip/miniz.h"
+
+// .frondsd sidecar, matching MemoryStickImage.h: 64-byte header then sectors.
+// Identity stays in the v7 media descriptor, not this header.
+namespace frondSdFile {
+constexpr size_t headerBytes = 64;
+constexpr uint32_t version = 1;
+constexpr uint32_t sectorBytes = 512;
+constexpr uint64_t maxPayloadBytes = 128ull << 20;  // production cap until a later milestone
+
+inline uint32_t get32(const uint8_t* p) {
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+inline uint64_t get64(const uint8_t* p) { return uint64_t(get32(p)) | (uint64_t(get32(p + 4)) << 32); }
+inline void put32(uint8_t* p, uint32_t n) {
+    for (unsigned i = 0; i < 4; ++i) p[i] = uint8_t(n >> (8 * i));
+}
+inline void put64(uint8_t* p, uint64_t n) {
+    put32(p, uint32_t(n));
+    put32(p + 4, uint32_t(n >> 32));
+}
+inline uint32_t crc32(const uint8_t* bytes, size_t size) { return mz_crc32(0, bytes, size); }
+
+inline bool validPayloadSize(uint64_t size) {
+    return size >= sectorBytes && size % sectorBytes == 0 && size <= maxPayloadBytes;
+}
+
+inline bool encode(const uint8_t* payload, uint64_t size, std::vector<uint8_t>& file) {
+    if (!validPayloadSize(size)) return false;
+    if (size > std::numeric_limits<size_t>::max()) return false;
+    if (!payload) return false;
+    const auto n = static_cast<size_t>(size);
+    std::vector<uint8_t> out(headerBytes + n);
+    std::memcpy(out.data(), "FRONDSD", 8);
+    put32(out.data() + 8, version);
+    put32(out.data() + 12, sectorBytes);
+    put64(out.data() + 16, size);
+    put32(out.data() + 24, crc32(payload, n));
+    std::memcpy(out.data() + headerBytes, payload, n);
+    file.swap(out);
+    return true;
+}
+
+inline bool encode(const std::vector<uint8_t>& payload, std::vector<uint8_t>& file) {
+    return encode(payload.data(), payload.size(), file);
+}
+
+inline bool decode(const uint8_t* file, size_t size, std::vector<uint8_t>& payload) {
+    if (!file || size < headerBytes) return false;
+    if (std::memcmp(file, "FRONDSD\0", 8) || get32(file + 8) != version || get32(file + 12) != sectorBytes)
+        return false;
+    for (unsigned i = 28; i < headerBytes; ++i)
+        if (file[i]) return false;
+    const uint64_t payloadBytes = get64(file + 16);
+    if (!validPayloadSize(payloadBytes)) return false;
+    if (payloadBytes > std::numeric_limits<size_t>::max()) return false;
+    if (size - headerBytes != payloadBytes) return false;
+    const auto n = static_cast<size_t>(payloadBytes);
+    if (get32(file + 24) != crc32(file + headerBytes, n)) return false;
+    std::vector<uint8_t> candidate(file + headerBytes, file + headerBytes + n);
+    payload.swap(candidate);
+    return true;
+}
+}  // namespace frondSdFile
+
+#endif
diff --git a/src/uarm/uarm/MachineFolder.h b/src/uarm/uarm/MachineFolder.h
new file mode 100644
index 0000000..72538b7
--- /dev/null
+++ b/src/uarm/uarm/MachineFolder.h
@@ -0,0 +1,218 @@
+#ifndef FROND_MACHINE_FOLDER_H
+#define FROND_MACHINE_FOLDER_H
+
+#include "FrondSdImage.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Per-machine folder: the .frond sits beside sd.frondsd and/or ms.frondms.
+// List/import/export ignore temps and generation files. Packing copies those
+// packable names at the archive or destination root; pickers wait for milestone 4.
+namespace frondMachine {
+constexpr const char* sdSibling = "sd.frondsd";
+constexpr const char* msSibling = "ms.frondms";
+constexpr const char* androidSession = "session.frond";
+constexpr uint32_t kindSd = 1, kindMs = 2;
+constexpr size_t nameBytes = 32, identityBytes = 32, descriptorBytes = 92;
+constexpr uint64_t msLogicalBytes = 128ull << 20;
+constexpr uint64_t msPhysicalBytes = 136577024;  // MemoryStickMedia::imageBytes
+
+inline bool ignoredName(std::string_view name) {
+    return name.find(".frond.tmp-") != std::string_view::npos ||
+           name.find(".frondsd.tmp-") != std::string_view::npos ||
+           name.find(".frondms.tmp-") != std::string_view::npos ||
+           name.find(".gen-") != std::string_view::npos;
+}
+
+inline bool endsWith(std::string_view name, std::string_view suffix) {
+    return name.size() >= suffix.size() && name.substr(name.size() - suffix.size()) == suffix;
+}
+
+inline bool packableName(std::string_view name) {
+    if (ignoredName(name)) return false;
+    if (name == sdSibling || name == msSibling) return true;
+    if (endsWith(name, ".frond")) return true;
+    if (endsWith(name, ".frond.settings.json")) return true;
+    return false;
+}
+
+struct Media {
+    uint32_t kind{};
+    std::string name;
+    bool inserted{};
+    bool writeProtected{};
+    std::array<uint8_t, identityBytes> identity{};
+    uint64_t logicalSize{};
+    uint64_t physicalSize{};
+};
+
+inline bool validMedia(const Media& media) {
+    if (media.kind == kindSd)
+        return media.name == sdSibling && media.logicalSize == media.physicalSize &&
+               frondSdFile::validPayloadSize(media.physicalSize);
+    if (media.kind == kindMs)
+        return media.name == msSibling && media.logicalSize == msLogicalBytes &&
+               media.physicalSize == msPhysicalBytes;
+    return false;
+}
+
+inline bool encodeDescriptor(const Media& media, std::vector<uint8_t>& out) {
+    if (!validMedia(media) || media.name.size() >= nameBytes) return false;
+    std::vector<uint8_t> bytes(descriptorBytes);
+    auto put32 = [](uint8_t* p, uint32_t n) {
+        for (unsigned i = 0; i < 4; ++i) p[i] = uint8_t(n >> (8 * i));
+    };
+    auto put64 = [&](uint8_t* p, uint64_t n) {
+        put32(p, uint32_t(n));
+        put32(p + 4, uint32_t(n >> 32));
+    };
+    put32(bytes.data(), media.kind);
+    std::memcpy(bytes.data() + 4, media.name.c_str(), media.name.size());
+    put32(bytes.data() + 36, media.inserted ? 1u : 0u);
+    put32(bytes.data() + 40, media.writeProtected ? 1u : 0u);
+    std::memcpy(bytes.data() + 44, media.identity.data(), identityBytes);
+    put64(bytes.data() + 76, media.logicalSize);
+    put64(bytes.data() + 84, media.physicalSize);
+    out.swap(bytes);
+    return true;
+}
+
+inline bool decodeDescriptor(const uint8_t* bytes, size_t size, Media& media) {
+    if (!bytes || size != descriptorBytes) return false;
+    auto get32 = [](const uint8_t* p) {
+        return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+    };
+    auto get64 = [&](const uint8_t* p) { return uint64_t(get32(p)) | (uint64_t(get32(p + 4)) << 32); };
+    Media parsed;
+    parsed.kind = get32(bytes);
+    const auto* name = bytes + 4;
+    size_t n = 0;
+    while (n < nameBytes && name[n]) ++n;
+    if (n == nameBytes) return false;
+    for (size_t i = n; i < nameBytes; ++i)
+        if (name[i]) return false;
+    parsed.name.assign(reinterpret_cast<const char*>(name), n);
+    const uint32_t inserted = get32(bytes + 36), protect = get32(bytes + 40);
+    if (inserted > 1 || protect > 1) return false;
+    parsed.inserted = inserted;
+    parsed.writeProtected = protect;
+    std::memcpy(parsed.identity.data(), bytes + 44, identityBytes);
+    parsed.logicalSize = get64(bytes + 76);
+    parsed.physicalSize = get64(bytes + 84);
+    if (!validMedia(parsed)) return false;
+    media = std::move(parsed);
+    return true;
+}
+
+inline bool sessionFile(const std::filesystem::path& folder, std::filesystem::path& out) {
+    std::error_code ec;
+    if (!std::filesystem::is_directory(folder, ec)) return false;
+    const auto named = folder / (folder.filename().string() + ".frond");
+    const auto android = folder / androidSession;
+    if (std::filesystem::is_regular_file(named, ec) && !ignoredName(named.filename().string())) {
+        out = named;
+        return true;
+    }
+    if (std::filesystem::is_regular_file(android, ec) && !ignoredName(android.filename().string())) {
+        out = android;
+        return true;
+    }
+    std::filesystem::path found;
+    int count = 0;
+    for (const auto& entry : std::filesystem::directory_iterator(folder, ec)) {
+        if (ec || !entry.is_regular_file(ec)) continue;
+        const auto name = entry.path().filename().string();
+        if (ignoredName(name) || !endsWith(name, ".frond")) continue;
+        found = entry.path();
+        ++count;
+    }
+    if (count != 1) return false;
+    out = found;
+    return true;
+}
+
+inline std::vector<std::filesystem::path> packableFiles(const std::filesystem::path& folder) {
+    std::vector<std::filesystem::path> files;
+    std::error_code ec;
+    if (!std::filesystem::is_directory(folder, ec)) return files;
+    for (const auto& entry : std::filesystem::directory_iterator(folder, ec)) {
+        if (ec || !entry.is_regular_file(ec)) continue;
+        if (!packableName(entry.path().filename().string())) continue;
+        files.push_back(entry.path());
+    }
+    std::sort(files.begin(), files.end());
+    return files;
+}
+
+enum class SiblingStatus { ok, missing, extra, mismatch, malformed };
+
+inline bool readBytes(const std::filesystem::path& path, std::vector<uint8_t>& bytes) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    in.seekg(0, std::ios::end);
+    const auto n = in.tellg();
+    if (n < 0) return false;
+    bytes.resize(static_cast<size_t>(n));
+    in.seekg(0);
+    return !n || bool(in.read(reinterpret_cast<char*>(bytes.data()), n));
+}
+
+inline bool msHeaderLooksRight(const std::filesystem::path& path) {
+    std::ifstream in(path, std::ios::binary);
+    uint8_t header[frondSdFile::headerBytes];
+    if (!in || !in.read(reinterpret_cast<char*>(header), sizeof(header))) return false;
+    if (std::memcmp(header, "FRONDMS\0", 8)) return false;
+    auto get32 = [](const uint8_t* p) {
+        return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+    };
+    if (get32(header + 8) != 1 || get32(header + 12) != 8192 || get32(header + 16) != 32 ||
+        get32(header + 20) != 512 || get32(header + 24) != 9)
+        return false;
+    for (unsigned i = 32; i < 64; ++i)
+        if (header[i]) return false;
+    return true;
+}
+
+inline SiblingStatus checkSiblings(const std::filesystem::path& folder, const std::vector<Media>& cards) {
+    bool expectSd = false, expectMs = false;
+    for (const auto& card : cards) {
+        if (!validMedia(card)) return SiblingStatus::mismatch;
+        if (card.kind == kindSd) {
+            if (expectSd) return SiblingStatus::mismatch;
+            expectSd = true;
+            const auto path = folder / sdSibling;
+            std::error_code ec;
+            if (!std::filesystem::is_regular_file(path, ec)) return SiblingStatus::missing;
+            std::vector<uint8_t> file, payload;
+            if (!readBytes(path, file) || !frondSdFile::decode(file.data(), file.size(), payload))
+                return SiblingStatus::malformed;
+            if (payload.size() != card.logicalSize || payload.size() != card.physicalSize)
+                return SiblingStatus::mismatch;
+        } else {
+            if (expectMs) return SiblingStatus::mismatch;
+            expectMs = true;
+            const auto path = folder / msSibling;
+            std::error_code ec;
+            if (!std::filesystem::is_regular_file(path, ec)) return SiblingStatus::missing;
+            const auto size = std::filesystem::file_size(path, ec);
+            if (ec) return SiblingStatus::malformed;
+            if (size != frondSdFile::headerBytes + card.physicalSize) return SiblingStatus::mismatch;
+            if (!msHeaderLooksRight(path)) return SiblingStatus::malformed;
+        }
+    }
+    std::error_code ec;
+    if (!expectSd && std::filesystem::is_regular_file(folder / sdSibling, ec)) return SiblingStatus::extra;
+    if (!expectMs && std::filesystem::is_regular_file(folder / msSibling, ec)) return SiblingStatus::extra;
+    return SiblingStatus::ok;
+}
+}  // namespace frondMachine
+
+#endif
