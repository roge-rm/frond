+    ic->nextFetchBuffer = *state++;
+    for (auto& buffer : ic->fetchBuffers) {
+        buffer.base = *state++;
+        std::memcpy(buffer.words, state, sizeof(buffer.words));
+        state += 8;
+    }
+    return true;
