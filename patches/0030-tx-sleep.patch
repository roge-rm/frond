+void icacheGetFetchState(struct icache* ic, uint32_t* state) {
+    *state++ = ic->nextFetchBuffer;
+    for (const auto& buffer : ic->fetchBuffers) {
+        *state++ = buffer.base;
+        std::memcpy(state, buffer.words, sizeof(buffer.words));
+        state += 8;
+    }
