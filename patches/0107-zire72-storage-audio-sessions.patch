+// Raw SD image sizes the CLI takes. The TX's card range is the one qualified. The Zire 72's ROM
+// has no SDHC driver, so its cards stop at 2 GiB (CSD v1); vSD presents anything larger as SDHC.
+inline bool deviceProfileSdSizeValid5(int32_t deviceType, uint64_t bytes) {
+    if (!bytes || bytes % 512) return false;
+    if (deviceType == deviceTypeTX) return bytes >= (32u << 20) && bytes <= (128u << 20);
+    if (deviceType == deviceTypeZire72) return bytes >= (32u << 20) && bytes <= (uint64_t(2) << 30);
+    return true;
+}
