+
+void EmPalmOS::RunSafePoint() {
+    if (!safePointRequested || !safePointHandler || gSession->IsNested()) return;
+
+    // The event loop came round, so the nil event that asked for it is done with.
+    safePointRequested = false;
+    postNilEvent = false;
+    safePointHandler();
+}
