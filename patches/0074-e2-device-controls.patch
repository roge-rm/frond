+void paintSilkscreen(Canvas& canvas, const DeviceSilkscreen& silk) {
+    const float W=silk.width,H=silk.height;
+    const Rgb ink{176,192,220},line{104,120,150};
+    // Dark printed glass over the digitizer.
+    canvas.paint(0,0,W,H,[](float,float) {return 1.f;},[&](float x,float y,Rgb) {
+        const Rgb c=mix(Rgb{25,29,42},Rgb{17,20,30},y/H);
+        const float t=std::fabs(x-W*0.5f)/(W*0.5f);
+        return c*(1-0.12f*t*t);
+    });
+    // Graffiti writing area: one outline, split into letters and numbers by two marks.
+    const SDL_Rect box{silk.letters.x,silk.letters.y,silk.numbers.x+silk.numbers.w-silk.letters.x,silk.letters.h};
+    const float bx0=box.x-2,by0=box.y-2,bx1=box.x+box.w+2,by1=box.y+box.h+2;
+    canvas.paint(bx0,by0,bx1,by1,[&](float x,float y) {return canvas.edge(deviceRoundedDistance(box,7,x,y));},
+                 [&](float,float y,Rgb) {return mix(Rgb{31,36,51},Rgb{26,30,44},clamp01((y-box.y)/box.h));});
+    canvas.paint(bx0,by0,bx1,by1,[&](float x,float y) {
+        return canvas.edge(std::fabs(deviceRoundedDistance(box,7,x,y)+0.5f)-0.6f);
+    },[&](float,float,Rgb) {return line;});
+    const float split=silk.numbers.x;
+    for(float sign:{1.f,-1.f}) {
+        const float rim=sign>0 ? box.y : box.y+box.h;
+        const std::array<std::array<float,2>,3> mark{{{split-3.4f,rim},{split+3.4f,rim},{split,rim+sign*5.5f}}};
+        canvas.paint(split-5,rim-7,split+5,rim+7,[&](float x,float y) {
+            return canvas.edge(polygon(x,y,mark));
+        },[&](float,float,Rgb) {return line;});
+    }
+    // Buttons: a pad over the reachable part of each ROM rectangle, with its icon centred.
+    for(size_t i=0;i<silk.count;++i) {
+        const auto& button=silk.buttons[i];
+        SDL_Rect r=button.bounds;
+        r.h=std::min(r.y+r.h,silk.height)-r.y;
+        const float corner=std::min(r.w,r.h)*0.22f,cx=r.x+r.w*0.5f,cy=r.y+r.h*0.5f;
+        const float x0=r.x-1,y0=r.y-1,x1=r.x+r.w+1,y1=r.y+r.h+1;
+        canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(deviceRoundedDistance(r,corner,x,y));},
+                     [&](float,float y,Rgb) {return mix(Rgb{36,42,60},Rgb{29,34,49},clamp01((y-r.y)/r.h));});
+        canvas.paint(x0,y0,x1,y1,[&](float x,float y) {
+            return canvas.edge(std::fabs(deviceRoundedDistance(r,corner,x,y)+0.5f)-0.45f)*0.8f;
+        },[](float,float,Rgb) {return Rgb{70,82,108};});
