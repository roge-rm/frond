+// Stroke glyphs for the keyboard areas: x from the glyph centre, y from the baseline.
+float glyphDistance(char c, float x, float y) {
+    float d=1e9f;
+    auto line=[&](float ax,float ay,float bx,float by) {d=std::min(d,segment(x,y,ax,ay,bx,by));};
+    switch(c) {
+        case 'a': d=ring(x,y,0,-2.7f,2.7f);line(2.7f,-5.4f,2.7f,0);break;
+        case 'b': d=ring(x,y,0,-2.7f,2.7f);line(-2.7f,-8.4f,-2.7f,0);break;
+        case 'c': d=arc(x,y,0,-2.7f,2.7f,degrees(40),degrees(320));break;
+        case '1': line(0.4f,-8,0.4f,0);line(-1.8f,-6.2f,0.4f,-8);break;
+        case '2': {
+            const float cx=0,cy=-5.8f,r=2.3f;
+            d=arc(x,y,cx,cy,r,degrees(180),degrees(390));
+            line(cx+r*std::cos(degrees(30)),cy+r*std::sin(degrees(30)),-2.4f,0);line(-2.4f,0,2.6f,0);
+            break;
+        }
+        case '3':
+            d=std::min(arc(x,y,0,-6,2,degrees(200),degrees(450)),arc(x,y,0,-2,2.1f,degrees(270),degrees(520)));
+            break;
+        default: break;
+    }
+    return d;
+}
+float textDistance(const char* text, float x, float y) {
+    // Glyphs are drawn 1.15 times their outline size so they stay legible at normal size.
+    const float size=1.15f,advance=6.4f*size;
+    const size_t n=std::strlen(text);
+    float d=1e9f;
+    for(size_t i=0;i<n;++i)d=std::min(d,glyphDistance(text[i],(x-(i-(n-1)*0.5f)*advance)/size,y/size)*size);
+    return d;
+}
