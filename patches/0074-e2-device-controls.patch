+void paintE2Controls(Canvas& canvas, const DeviceControlProfile& profile, int width, uint32_t pressed) {
+    const float H=profile.height;
+    const int ox=(width-profile.width)/2;
+    auto down=[&](KeyId key) {return (pressed&(1u<<key))!=0;};
+    auto all=[&](float,float) {return 1.f;};
+    auto shifted=[&](SDL_Rect r) {r.x+=ox;return r;};
+    // Original vector artwork: a midnight blue face below the silkscreen glass.
+    canvas.paint(0,0,width,H,all,[&](float x,float y,Rgb) {
+        const Rgb c=mix(Rgb{36,44,64},Rgb{13,16,26},std::pow(y/H,0.85f));
+        const float t=std::fabs(x-width*0.5f)/(width*0.5f);
+        return c*(1-0.22f*t*t);
+    });
+    canvas.paint(0,0,width,2,[&](float,float y) {return canvas.edge(std::fabs(y-0.5f)-0.5f);},
+                 [](float,float,Rgb) {return Rgb{5,6,10};});
+    canvas.paint(0,0,width,4,[&](float,float y) {return canvas.edge(std::fabs(y-1.7f)-0.4f)*0.6f;},
+                 [](float,float,Rgb) {return Rgb{84,96,124};});
+
+    for(size_t i=0;i<profile.count;++i) {
+        const auto& button=profile.buttons[i];
+        if(deviceNavigatorButton(profile,button))continue;
+        const bool held=down(button.key);
+        const SDL_Rect key=shifted(button.bounds);
+        const float corner=deviceButtonCorner(profile,key),sink=held ? 0.8f : 0;
+        const float x0=key.x-4,y0=key.y-4,x1=key.x+key.w+4,y1=key.y+key.h+6;
+        const float kcx=key.x+key.w*0.5f,kcy=key.y+key.h*0.5f+sink;
+        auto d=[&](float x,float y) {return deviceRoundedDistance(key,corner,x,y);};
+        // Shadow and a dark seam round the key.
+        canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return clamp01((2-d(x,y-1.6f))/4)*(held?0.35f:0.65f);},
+                     [](float,float,Rgb) {return Rgb{2,3,6};});
+        canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(d(x,y)-1.1f);},
+                     [](float,float,Rgb) {return Rgb{6,8,13};});
+        // Silver rim, lit along the top; the navy face sits inside it.
+        canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(d(x,y));},[&](float,float y,Rgb) {
+            const Rgb c=mix(Rgb{178,186,200},Rgb{82,90,106},clamp01((y-key.y)/key.h));
+            return held ? c*0.7f : c;
+        });
+        auto face=[&](float x,float y) {return d(x,y-sink)+1.6f;};
+        canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(face(x,y));},[&](float x,float y,Rgb) {
+            const float t=clamp01((y-key.y-sink)/key.h);
+            Rgb c=mix(Rgb{48,60,90},Rgb{20,26,42},t);
+            const float r=std::hypot((x-kcx)/(key.w*0.42f),(y-key.y-sink-key.h*0.3f)/(key.h*0.3f));
+            c=c+Rgb{22,26,36}*std::pow(clamp01(1-r),2.f);
+            c=mix(Rgb{14,18,30},c,clamp01(-face(x,y)/2.5f));
+            // Held: darker, with a shadow under the rim's top edge.
+            return held ? c*(0.5f+0.2f*clamp01(-face(x,y-1.5f)/3)) : c;
+        });
+        const Rgb ink=held ? Rgb{106,116,136} : Rgb{190,201,220};
+        canvas.paint(kcx-11,kcy-11,kcx+11,kcy+11,[&](float x,float y) {
+            return canvas.edge(e2IconDistance(button.icon,x-kcx,y-kcy)-0.6f);
+        },[&](float,float,Rgb) {return ink;});
+    }
+
+    if(profile.navigator.w<=0)return;
+    const SDL_Rect nav=shifted(profile.navigator),pill=shifted(profile.select);
+    const float cx=nav.x+nav.w*0.5f,cy=nav.y+nav.h*0.5f,R=nav.w*0.5f,r=pill.w*0.5f;
+    const float x0=nav.x-5,y0=nav.y-5,x1=nav.x+nav.w+5,y1=nav.y+nav.h+7;
+    auto dist=[&](float x,float y) {return std::hypot(x-cx,y-cy);};
+    auto part=[&](float x,float y) {return deviceNavigatorAt(profile,x-ox,y);};
+    // Round brushed-silver five-way in a dark seam, with a soft shadow.
+    canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return clamp01((R+2.5f-dist(x,y-1.8f))/4.5f)*0.75f;},
+                 [](float,float,Rgb) {return Rgb{1,2,5};});
+    canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(dist(x,y)-R-1.4f);},
+                 [](float,float,Rgb) {return Rgb{5,6,10};});
+    canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(dist(x,y)-R);},[&](float x,float y,Rgb) {
+        const float t=clamp01((y-nav.y)/nav.h),rr=std::max(dist(x,y),0.001f);
+        Rgb c=mix(Rgb{214,219,228},Rgb{116,123,137},t);
+        // Lit from the top left, with faint concentric brushing.
+        c=c*(0.92f+0.1f*(-(x-cx)*0.5f-(y-cy)*0.85f)/rr)+Rgb{2,2,2}*std::sin(rr*2.6f);
+        // The rim rolls off at the outer edge and slopes into the groove round select.
+        c=mix(c,c*0.66f,clamp01(1+(rr-R)/2));
+        c=c*(1-0.25f*std::pow(clamp01(1-(rr-r-2)/8),2.f));
+        const KeyId k=part(x,y);
+        return k!=keyInvalid && k!=keyIdSelect && down(k) ? c*0.6f : c;
+    });
+    // Small arrow marks on each direction.
+    for(auto [key,ax,ay]:{std::tuple<KeyId,float,float>{keyIdUp,0,-1},{keyIdDown,0,1},{keyIdLeft,-1,0},{keyIdRight,1,0}}) {
+        const float tip=R-6.5f,base=R-11,half=3.6f;
+        const std::array<std::array<float,2>,3> mark{{{cx+ax*tip,cy+ay*tip},
+                                                      {cx+ax*base-ay*half,cy+ay*base+ax*half},
+                                                      {cx+ax*base+ay*half,cy+ay*base-ax*half}}};
+        const Rgb ink=down(key) ? Rgb{46,52,64} : Rgb{78,86,102};
+        canvas.paint(cx-R,cy-R,cx+R,cy+R,[&](float x,float y) {
+            return canvas.edge(polygon(x,y,mark));
+        },[&](float,float,Rgb) {return ink;});
+    }
+    // Dark groove and the domed navy select key.
+    const bool held=down(keyIdSelect);
+    const float sink=held ? 0.8f : 0;
+    canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(dist(x,y)-r-2.2f);},
+                 [&](float,float y,Rgb) {return mix(Rgb{12,15,24},Rgb{54,62,80},clamp01((y-pill.y)/pill.h));});
+    auto selectDistance=[&](float x,float y) {return dist(x,y-sink)-r+0.3f;};
+    canvas.paint(x0,y0,x1,y1,[&](float x,float y) {return canvas.edge(selectDistance(x,y));},[&](float x,float y,Rgb) {
+        const float t=clamp01((y-pill.y-sink)/pill.h);
+        Rgb c=held ? mix(Rgb{26,33,52},Rgb{18,22,36},t) : mix(Rgb{64,80,116},Rgb{26,33,54},t);
+        const float h=std::hypot((x-cx)/(r*0.8f),(y-cy-sink+r*0.45f)/(r*0.5f));
+        if(!held)c=c+Rgb{20,24,34}*std::pow(clamp01(1-h),2.f);
+        return c;
+    });
+    canvas.paint(x0,y0,x1,y1,[&](float x,float y) {
+        return canvas.edge(std::fabs(selectDistance(x,y)+0.7f)-0.35f)*(held?0.15f:0.5f)*clamp01((cy-y)/r+0.3f);
+    },[](float,float,Rgb) {return Rgb{140,154,182};});
+}
+
+// Distance to the silkscreen icons, in LCD pixels from the button centre.
+float silkscreenIconDistance(SilkscreenIcon icon, float x, float y) {
+    float d=1e9f;
+    auto line=[&](float ax,float ay,float bx,float by) {d=std::min(d,segment(x,y,ax,ay,bx,by));};
+    switch(icon) {
+        case SilkscreenIcon::home:
+            line(-11,-1,0,-11);line(0,-11,11,-1);line(-8,-3.6f,-8,10);line(8,-3.6f,8,10);line(-8,10,8,10);
+            line(-2.6f,10,-2.6f,3.4f);line(-2.6f,3.4f,2.6f,3.4f);line(2.6f,3.4f,2.6f,10);
+            break;
+        case SilkscreenIcon::menu: {
+            // A pull-down menu: title bar and items.
+            const SDL_Rect frame{-10,-8,20,17};
+            d=std::fabs(deviceRoundedDistance(frame,2,x,y));
+            line(-10,-3.5f,10,-3.5f);line(-6.5f,0.5f,5,0.5f);line(-6.5f,4.5f,2,4.5f);
+            break;
+        }
+        case SilkscreenIcon::favorites: {
+            std::array<std::array<float,2>,10> p;
+            for(int i=0;i<10;++i) {
+                const float a=degrees(-90+36*i),r=i%2 ? 4.9f : 11.5f;
+                p[i]={r*std::cos(a),r*std::sin(a)+1};
+            }
+            for(int i=0;i<10;++i)line(p[i][0],p[i][1],p[(i+1)%10][0],p[(i+1)%10][1]);
+            break;
+        }
+        case SilkscreenIcon::find:
+            d=ring(x,y,-2.5f,-2.5f,6.6f);
+            d=std::min(d,segment(x,y,2.6f,2.6f,8.6f,8.6f)-1.1f);
+            break;
+        case SilkscreenIcon::clock:
+            d=ring(x,y,0,0,6.6f);line(0,0,0,-4.2f);line(0,0,3.2f,1.4f);
+            break;
+        case SilkscreenIcon::brightness:
+            d=std::min(ring(x,y,0,0,3.2f),std::hypot(x,y)<3.2f && x<0 ? 0.f : 1e9f);
+            for(int i=0;i<8;++i) {
+                const float a=degrees(45*i);
+                line(5.4f*std::cos(a),5.4f*std::sin(a),7.8f*std::cos(a),7.8f*std::sin(a));
+            }
+            break;
+        case SilkscreenIcon::letters: d=textDistance("abc",x,y-4.5f);break;
+        case SilkscreenIcon::numbers: d=textDistance("123",x,y-4.5f);break;
+    }
+    return d;
+}
