+// Distance to the E2 app key icons, in strip units from the key centre.
+float e2IconDistance(DeviceControlIcon icon, float x, float y) {
+    float d=1e9f;
+    auto line=[&](float ax,float ay,float bx,float by) {d=std::min(d,segment(x,y,ax,ay,bx,by));};
+    switch(icon) {
+        case DeviceControlIcon::calendar: {
+            // A page with binder tabs and a small grid.
+            const SDL_Rect page{-7,-6,14,13};
+            d=std::fabs(deviceRoundedDistance(page,1.5f,x,y));
+            line(-7,-2.4f,7,-2.4f);line(-3.5f,-8.2f,-3.5f,-4.4f);line(3.5f,-8.2f,3.5f,-4.4f);
+            line(-7,2.3f,7,2.3f);line(-2.3f,-2.4f,-2.3f,7);line(2.3f,-2.4f,2.3f,7);
+            break;
+        }
+        case DeviceControlIcon::contacts:
+            d=ring(x,y,0,-3.4f,3.1f);d=std::min(d,arc(x,y,0,7.6f,6.8f,degrees(196),degrees(344)));
+            line(-6.5f,5.7f,6.5f,5.7f);
+            break;
+        case DeviceControlIcon::tasks: {
+            const SDL_Rect box{-7,-6,12,12};
+            d=std::fabs(deviceRoundedDistance(box,1.5f,x,y));
+            line(-4,-0.5f,-1.2f,2.6f);line(-1.2f,2.6f,7,-7.5f);
+            break;
+        }
+        case DeviceControlIcon::notes: {
+            // A note page with a pencil across its corner.
+            const SDL_Rect page{-7,-7,11,14};
+            if(segment(x,y,0,4.5f,7.5f,-6)>2.6f)d=std::fabs(deviceRoundedDistance(page,1.2f,x,y));
+            line(-4.5f,-3,1.5f,-3);line(-4.5f,0.3f,-0.5f,0.3f);line(-4.5f,3.6f,-2.5f,3.6f);
+            line(0.9f,2.6f,7.5f,-6.5f);line(-0.9f,1.3f,5.7f,-7.8f);line(-0.9f,1.3f,-0.3f,4.7f);
+            line(-0.3f,4.7f,0.9f,2.6f);line(5.7f,-7.8f,7.5f,-6.5f);
+            break;
+        }
+        default: break;
+    }
+    return d;
+}
