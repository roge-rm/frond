+class Imx1GraphicsGpuGles final : public Imx1GraphicsGpuBackend {
+   public:
+    // bankBytes: each bank's size, a whole number of pages. Null with why in error when there is no usable GPU.
+    // FROND_ZODIAC_GPU_DEVICE names an EGL device's DRM node to use (e.g. /dev/dri/renderD128), or surfaceless;
+    // otherwise the first hardware device with a DRM node, then Mesa's surfaceless platform, then the default
+    // display (Android's).
+    static std::unique_ptr<Imx1GraphicsGpuGles> create(const uint32_t (&bankBytes)[2], std::string& error) {
+        std::unique_ptr<Imx1GraphicsGpuGles> gpu(new Imx1GraphicsGpuGles());
+        for (unsigned bank = 0; bank < 2; ++bank) gpu->rows[bank] = bankBytes[bank] / pageBytes;
+        gpu->worker = std::thread([raw = gpu.get()] { raw->run(); });
+        {
+            std::unique_lock<std::mutex> lock(gpu->mutex);
+            gpu->changed.wait(lock, [&] { return gpu->started; });
+        }
+        if (!gpu->ready) {
+            error = gpu->failure;
+            return nullptr;
+        }
+        return gpu;
+    }
+    ~Imx1GraphicsGpuGles() override {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stopping = true;
+        }
+        changed.notify_all();
+        if (worker.joinable()) worker.join();
+        if (posted && !std::getenv("FROND_ZODIAC_GPU_QUIET"))
+            std::fprintf(stderr, "zodiac gpu: per fill %.1f us queued, %.1f us drawing, %.1f us reading back\n",
+                         queueNs / 1e3 / double(posted), drawNs / 1e3 / double(posted), readNs / 1e3 / double(posted));
+    }
+    const std::string& renderer() const override { return name; }
+    bool healthy() const override { return ready && !broken; }
+    void upload(unsigned bank, uint32_t firstPage, uint32_t pages, const uint8_t* data) override {
+        std::vector<uint8_t> copy(data, data + size_t(pages) * pageBytes);
+        post([this, bank, firstPage, pages, copy = std::move(copy)] {
+            gl.BindTexture(GL_TEXTURE_2D, banks[bank].texture);
+            gl.PixelStorei(GL_UNPACK_ALIGNMENT, 4);
+            gl.TexSubImage2D(GL_TEXTURE_2D, 0, 0, GLint(firstPage), rowTexels, GLsizei(pages), GL_RED_INTEGER,
+                             GL_UNSIGNED_SHORT, copy.data());
+        });
+    }
+    uint64_t fill(const Imx1GpuFill& fill, uint32_t firstPage, uint32_t pages, uint8_t* to) override {
+        std::vector<uint16_t> pixels;
+        if (fill.pixels) pixels.assign(fill.pixels, fill.pixels + size_t(fill.width) * fill.height);
+        const uint64_t number = ++posted;
+        const auto queued = std::chrono::steady_clock::now();
+        post([this, fill, pixels = std::move(pixels), firstPage, pages, to, number, queued] {
+            const auto started = std::chrono::steady_clock::now();
+            draw(fill, pixels);
+            const auto drawn = std::chrono::steady_clock::now();
+            read(fill.bank, firstPage, pages, to + size_t(firstPage) * pageBytes);
+            const auto read = std::chrono::steady_clock::now();
+            using ns = std::chrono::nanoseconds;
+            queueNs += uint64_t(std::chrono::duration_cast<ns>(started - queued).count());
+            drawNs += uint64_t(std::chrono::duration_cast<ns>(drawn - started).count());
+            readNs += uint64_t(std::chrono::duration_cast<ns>(read - drawn).count());
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                done.store(number, std::memory_order_release);
+            }
+            finished.notify_all();
+        });
+        return number;
+    }
+    uint64_t completed() const override { return done.load(std::memory_order_acquire); }
+    void waitFor(uint64_t number) override {
+        // Fills are short: spin a little before sleeping.
+        for (unsigned i = 0; i < 2000; ++i)
+            if (completed() >= number) return;
+        std::unique_lock<std::mutex> lock(mutex);
+        finished.wait(lock, [&] { return completed() >= number; });
+    }
