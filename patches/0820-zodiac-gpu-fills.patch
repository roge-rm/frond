+    }
+    result = c & 65535u;
+})";
+        const GLuint v = compile(GL_VERTEX_SHADER, vertex), f = v ? compile(GL_FRAGMENT_SHADER, fragment) : 0;
+        if (!f) return false;
+        program = gl.CreateProgram();
+        gl.AttachShader(program, v);
+        gl.AttachShader(program, f);
+        gl.LinkProgram(program);
+        GLint ok = 0;
+        gl.GetProgramiv(program, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            char log[1024] = {};
+            gl.GetProgramInfoLog(program, sizeof log, nullptr, log);
+            failure = std::string("link: ") + log;
+            return false;
+        }
+        gl.UseProgram(program);
+        gl.Uniform1i(gl.GetUniformLocation(program, "source"), sourceUnit);
+        gl.Uniform1i(gl.GetUniformLocation(program, "under"), underUnit);
+        gl.Uniform1i(gl.GetUniformLocation(program, "pixels"), pixelsUnit);
+        const char* names[] = {"base", "pitch", "width", "height", "colour", "sourceBase", "sourcePitch", "sourceX",
+                               "sourceY", "paint", "flags"};
+        for (unsigned i = 0; i < 11; ++i) uniforms[i] = gl.GetUniformLocation(program, names[i]);
+        return true;
