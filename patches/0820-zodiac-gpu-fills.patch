+#undef FROND_GL
+        const char* renderer = reinterpret_cast<const char*>(gl.GetString(GL_RENDERER));
+        const char* version = reinterpret_cast<const char*>(gl.GetString(GL_VERSION));
+        name = std::string(renderer ? renderer : "?") + " (" + (version ? version : "?") + ", " + device + ")";
