+// Tapwave Zodiac: original vector art on a dark graphite body. The shoulder triggers are slim tabs,
+// the stick a ribbed knob in a round well that follows the held position, the Action keys glossy
+// round buttons and Home and Function small pills. Paints the body from x0 to x1 and 0 to h and the
+// keys of one section authored from x0 to x1, in the section's own units; screenHeight places
+// around keys on a panel taller than authored.
+void paintZodiacControls(Canvas& canvas, const DeviceControlProfile& profile, DeviceKeyMask pressed,
+                         DeviceStick stick, DeviceControlSection section, float x0, float x1, float h,
+                         int screenHeight=0) {
+    auto down=[&](KeyId key) {return key!=keyInvalid && (pressed&deviceKeyBit(key))!=0;};
+    canvas.paint(x0,0,x1,h,[](float,float) {return 1.f;},[&](float x,float y,Rgb) {
+        Rgb c=mix(Rgb{58,60,66},Rgb{30,31,35},std::pow(clamp01(y/h),1.2f));
+        return c+Rgb{4,4,4}*speckle(x,y);
+    });
+    // A faint highlight along the top edge of the body.
+    canvas.paint(x0,0,x1,3,[&](float,float y) {return canvas.edge(std::fabs(y-1)-0.5f)*0.35f;},
+                 [](float,float,Rgb) {return Rgb{140,144,152};});
+    for(size_t i=0;i<profile.count;++i) {
+        const auto& b=profile.buttons[i];
+        if(b.section!=section || b.bounds.x<x0 || b.bounds.x>=x1)continue;
+        SDL_Rect r=b.bounds;
+        if(section==DeviceControlSection::around)r.y+=deviceAroundTop(profile,b,screenHeight);
+        const float cx=r.x+r.w*0.5f,cy=r.y+r.h*0.5f;
+        const float bx0=r.x-6,by0=r.y-6,bx1=r.x+r.w+6,by1=r.y+r.h+8;
+        const bool held=down(b.key);
+        if(b.icon==DeviceControlIcon::stick) {
+            const float well=r.w*0.5f,knob=r.w*deviceStickKnob,travel=r.w*deviceStickTravel;
+            const float kx=cx+stick.x*travel,ky=cy+stick.y*travel;
+            // Recessed well with a lit lower lip.
+            canvas.paint(bx0,by0,bx1,by1,[&](float x,float y) {return canvas.edge(std::hypot(x-cx,y-cy)-well);},
+                         [&](float,float y,Rgb) {return mix(Rgb{14,15,17},Rgb{36,38,42},clamp01((y-r.y)/r.h));});
+            canvas.paint(bx0,by0,bx1,by1,[&](float x,float y) {
+                return canvas.edge(std::fabs(std::hypot(x-cx,y-cy)-well)-0.6f)*clamp01((y-cy)/well)*0.7f;
+            },[](float,float,Rgb) {return Rgb{104,108,116};});
+            // The knob's shadow, its rim and a ribbed face.
+            canvas.paint(bx0,by0,bx1,by1,[&](float x,float y) {
+                return clamp01((knob+3-std::hypot(x-kx,y-ky-2.5f))/6)*0.6f;
+            },[](float,float,Rgb) {return Rgb{0,0,0};});
+            canvas.paint(bx0,by0,bx1,by1,[&](float x,float y) {return canvas.edge(std::hypot(x-kx,y-ky)-knob);},
+                         [&](float x,float y,Rgb) {
+                const float d=std::hypot(x-kx,y-ky)/knob;
+                Rgb c=mix(Rgb{96,99,106},Rgb{44,46,51},clamp01((y-ky+knob)/(2*knob)));
