+            if(!found)return false;
+        }
+    }
+    if((s.link==Link::off || s.link==Link::failed) &&
+       (s.rawSize || s.wireSize || !s.flight.empty() || !s.inbox.empty() || s.inFrame ||
+        s.control || s.ackPending || s.retrying || s.rxNext || s.txNext))return false;
