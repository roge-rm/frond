+// A deadline can have an unrelated denominator; its exact difference needs 128 bits.
+struct Imx1ReferenceInterval {
+    uint64_t ticks = 0;
+    __uint128_t numerator = 0, denominator = 1;
+    bool positive() const { return ticks || numerator; }
+};
