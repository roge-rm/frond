+// XScale D-cache state, saved only when there is some: the C bit, the stale window and
+// the noted pages as VA page, PA page pairs.
+template <typename T>
+static void mmuPrvDcacheSave(struct ArmMmu *mmu, T &savestate) {
+    if (!mmu->xscale || (!mmu->dcOn && !mmu->staleOn && mmu->dcPages->empty())) return;
+    auto chunk = savestate.GetChunk(ChunkType::xscaleDcache, 0);
+    if (!chunk) ERR("unable to allocate chunk");
+    SaveChunkHelper helper(*chunk);
+    std::vector<uint32_t> pairs;
+    pairs.reserve(mmu->dcPages->size() * 2);
+    for (uint32_t page : *mmu->dcPages) {
+        pairs.push_back(page);
+        pairs.push_back(mmu->dcPage[page] & 0xfffff);
+    }
+    helper.Do8(mmu->dcOn).Do8(mmu->staleOn).Do32(uint32_t(mmu->dcPages->size()));
+    if (!pairs.empty()) helper.DoBuffer32(pairs.data(), pairs.size());
+}
+
+template <typename T>
+static void mmuPrvDcacheLoad(struct ArmMmu *mmu, T &loader) {
+    if (!mmu->xscale) return;
+    mmu->dcPages->clear();
+    mmu->dcGen = 1;
+    memset(mmu->dcPage, 0, TLB_SIZE * sizeof(uint32_t));
+    mmu->staleOn = 0;
+    // Sessions from before the model ran with the cache on whenever the MMU was.
+    mmu->dcOn = mmu->transTablPA != MMU_DISABLED_TTP;
+    if (!loader.HasChunk(ChunkType::xscaleDcache)) return;
+    auto chunk = loader.GetChunkOrFail(ChunkType::xscaleDcache, 0, "xscale dcache");
+    if (!chunk) return;
+    LoadChunkHelper helper(*chunk);
+    uint8_t dcOn = 0, staleOn = 0;
+    uint32_t count = 0;
+    helper.Do8(dcOn).Do8(staleOn).Do32(count);
+    if (count > TLB_SIZE || dcOn > 1 || staleOn > 1) {
+        loader.NotifyError();
+        return;
+    }
+    std::vector<uint32_t> pairs(size_t(count) * 2);
+    if (count) helper.DoBuffer32(pairs.data(), pairs.size());
+    if (chunk->HasError()) {
+        loader.NotifyError();
+        return;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        const uint32_t page = pairs[2 * i], pa = pairs[2 * i + 1];
+        if (page >= TLB_SIZE || pa > 0xfffff || mmu->dcPage[page]) {
+            loader.NotifyError();
+            return;
+        }
+        mmu->dcPage[page] = (uint32_t(mmu->dcGen) << 20) | pa;
+        mmu->dcPages->push_back(page);
+    }
+    mmu->dcOn = dcOn;
+    mmu->staleOn = staleOn && mmu->transTablPA == MMU_DISABLED_TTP;
+}
