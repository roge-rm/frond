+// With the MMU off inside the stale window: the noted PA of addr's page, if it has one.
+static inline MMUTranslateResult mmuStaleTranslate(const ArmMmu* mmu, uint32_t addr) {
+    const uint32_t e = mmu->dcPage[addr >> 12];
+    if ((e >> 20) != mmu->dcGen) return addr;
+    return uint64_t((addr & 0xfff) | ((e & 0xfffff) << 12)) | (1ull << 62);
+}
+
+// Notes a cacheable page's mapping while the MMU and D-cache are on.
+static inline void mmuDcacheNote(ArmMmu* mmu, uint32_t va, uint32_t pa) {
+    uint32_t& e = mmu->dcPage[va >> 12];
+    const uint32_t noted = (uint32_t(mmu->dcGen) << 20) | (pa >> 12);
+    if (e == noted) return;
+    if ((e >> 20) != mmu->dcGen) mmu->dcPages->push_back(va >> 12);
+    e = noted;
+}
