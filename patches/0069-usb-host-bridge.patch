diff --git a/src/uarm/uarm/UsbBusHost.cpp b/src/uarm/uarm/UsbBusHost.cpp
new file mode 100644
--- /dev/null
+++ b/src/uarm/uarm/UsbBusHost.cpp
@@ -0,0 +1,493 @@
+#include "UsbBusHost.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+using R = Pxa270UdcHostResult;
+
+namespace {
+// Full-speed bit times: 12 Mbit/s.
+uint64_t bitsNs(uint64_t bits) { return (bits * 1000 + 11) / 12; }
+// Token (SYNC, PID, ADDR, ENDP, CRC5: 32), DATAx (SYNC, PID, CRC16: 32 + 8 * bytes),
+// handshake (16), a 2-bit EOP after each packet and two 2-bit inter-packet gaps.
+uint64_t transactionBits(unsigned bytes) { return 32 + 32 + 8ull * bytes + 16 + 3 * 2 + 2 * 2; }
+constexpr uint64_t nakBits = 32 + 16 + 2 * 2 + 2;  // token, NAK/STALL handshake
+constexpr uint64_t timeoutBits = 32 + 2 + 18;      // token, bus turnaround timeout
+constexpr uint64_t sofBits = 32 + 2;
+constexpr uint64_t eofGuardNs = 50000;             // keep clear of the frame end
+
+std::string hex4(uint16_t value) {
+    char text[8];
+    std::snprintf(text, sizeof(text), "%04x", value);
+    return text;
+}
+std::string printable(const uint8_t* bytes, size_t size) {
+    std::string text;
+    for (size_t i = 0; i < size; ++i) text += bytes[i] >= 0x20 && bytes[i] < 0x7f ? char(bytes[i]) : '.';
+    return text;
+}
+}  // namespace
+
+UsbBusHost::UsbBusHost(std::function<Pxa270Udc*()> udc, Link link) : udc(std::move(udc)), link(std::move(link)) {}
+
+const char* UsbBusHost::PhaseName(Phase phase) {
+    switch (phase) {
+        case Phase::detached: return "detached";
+        case Phase::waitEnable: return "waiting";
+        case Phase::connect: return "connecting";
+        case Phase::reset: return "resetting";
+        case Phase::enumerate: return "enumerating";
+        case Phase::running: return "running";
+        case Phase::failed: return "failed";
+    }
+    return "?";
+}
+
+void UsbBusHost::Message(const std::string& text) {
+    if (messages.size() < 64) messages.push_back(text);
+}
+
+void UsbBusHost::Attach() {
+    if (phase != Phase::detached && phase != Phase::failed) return;
+    Detach();
+    phase = Phase::waitEnable;
+    poked = true;  // look at the UDC on the next tick
+}
+
+void UsbBusHost::Detach() {
+    phase = Phase::detached;
+    inFlight = Token::none;
+    control = {};
+    sofRunning = false;
+    address = pendingAddress = 0;
+    attempts = 0;
+    outPending = clearHalt = false;
+    outSize = 0;
+    bulkTimeouts = 0;
+    retryAt = busyUntil = lastControlEnd = requeryAt = 0;
+    poked = waitSpace = false;
+    step = 0;
+    inEndpoint = outEndpoint = 0;
+    portFunction.clear();
+}
+
+uint64_t UsbBusHost::NextWake() const {
+    if (phase == Phase::detached || phase == Phase::failed) return UINT64_MAX;
+    if (poked) return 0;
+    if (phase == Phase::waitEnable) return UINT64_MAX;  // the UDE and UDCICR writes poke
+    if (phase == Phase::connect || phase == Phase::reset) return phaseAt;
+    uint64_t wake = inFlight != Token::none ? busyUntil : retryAt;
+    if (pendingAddress) wake = std::min(wake, addressAt);
+    auto* u = udc();
+    if (sofRunning && u && pxa270UdcHostSofWanted(u)) wake = std::min(wake, nextSof);
+    return wake;
+}
+
+bool UsbBusHost::LinkWaiting() const {
+    if (phase != Phase::running || !inEndpoint || inFlight != Token::none || control.active || poked) return false;
+    return (!outPending && link.pending && link.pending()) || (waitSpace && link.sendSpace && link.sendSpace() >= 64);
+}
+
+// A NAK, or nothing to send: try again 10 us after the guest next touches the UDC
+// (Poke), or once the next frame has started.
+void UsbBusHost::Nak() {
+    nakAt = now;
+    retryAt = std::max(now + nakRetryNs, nextSof + bitsNs(sofBits));
+}
+
+bool UsbBusHost::Addressed() { return pxa270UdcHostAddress(udc()) == address; }
+
+// Enumeration failed: reset the port and start again a little later, a few times.
+void UsbBusHost::Restart(const char* why) {
+    Message(std::string("usb: ") + why);
+    inFlight = Token::none;
+    control = {};
+    sofRunning = false;
+    outPending = clearHalt = false;
+    if (++attempts >= maxAttempts) {
+        phase = Phase::failed;
+        Message("usb: gave up; unplug and plug in again to retry");
+        return;
+    }
+    phase = Phase::connect;
+    phaseAt = now + retryNs;
+}
+
+void UsbBusHost::StartControl(uint8_t type, uint8_t request, uint16_t value, uint16_t index, uint16_t length) {
+    control = {};
+    control.active = true;
+    const uint8_t setup[8] = {type, request, uint8_t(value), uint8_t(value >> 8), uint8_t(index),
+                              uint8_t(index >> 8), uint8_t(length), uint8_t(length >> 8)};
+    std::memcpy(control.setup, setup, 8);
+    // After a SOF, at least 1 ms after the previous transfer (and the address recovery).
+    uint64_t earliest = std::max(lastControlEnd + frameNs, now + 1);
+    if (pendingAddress) earliest = std::max(earliest, addressAt);
+    control.startAt = (earliest + frameNs - 1) / frameNs * frameNs;
+    control.deadline = control.startAt + controlTimeoutNs;
+}
+
+void UsbBusHost::ControlDone(Result result) {
+    control.active = false;
+    lastControlEnd = now;
+    if (phase == Phase::enumerate || (step >= 6 && !inEndpoint)) return EnumerationStep(result);
+    if (clearHalt) {
+        clearHalt = false;
+        if (result != Result::ok) Restart("could not clear a halted endpoint");
+    }
+}
+
+void UsbBusHost::EnumerationStep(Result result) {
+    const auto& d = control.data;
+    auto fail = [&](const char* what) {
+        Restart((std::string(what) + (result == Result::stall ? " stalled" :
+                                      result == Result::timeout ? " timed out" : " failed")).c_str());
+    };
+    switch (step) {
+        case 0:  // GET_DESCRIPTOR(device, 8) at address 0
+            if (result != Result::ok || d.size() < 8 ||
+                (d[7] != 8 && d[7] != 16 && d[7] != 32 && d[7] != 64))
+                return fail("device descriptor");
+            maxPacket0 = d[7];
+            step = 1;
+            return StartControl(0x00, 5, deviceAddress, 0, 0);
+        case 1:  // SET_ADDRESS, then 2 ms recovery (USB 2.0 9.2.6.3)
+            if (result != Result::ok) return fail("SET_ADDRESS");
+            pendingAddress = deviceAddress;
+            addressAt = now + 2 * frameNs;
+            step = 2;
+            return StartControl(0x80, 6, 0x0100, 0, 18);
+        case 2:
+            if (result != Result::ok || d.size() < 18) return fail("device descriptor");
+            vendor = uint16_t(d[8] | d[9] << 8);
+            product = uint16_t(d[10] | d[11] << 8);
+            step = 3;
+            return StartControl(0x80, 6, 0x0200, 0, 9);
+        case 3:
+            if (result != Result::ok || d.size() < 9) return fail("configuration descriptor");
+            configLength = uint16_t(d[2] | d[3] << 8);
+            configuration = d[5];
+            if (configLength < 9) return fail("configuration descriptor");
+            step = 4;
+            return StartControl(0x80, 6, 0x0200, 0, configLength);
+        case 4:
+            if (result != Result::ok || d.size() < 9) return fail("configuration descriptor");
+            step = 5;
+            return StartControl(0x00, 9, configuration, 0, 0);
+        case 5:
+            if (result != Result::ok) return fail("SET_CONFIGURATION");
+            step = 6;
+            // GET_EXT_CONNECTION_INFORMATION, as pilot-link and the Linux visor driver ask.
+            return StartControl(0xc2, 4, 0, 0, 20);
+        case 6:
+            inEndpoint = outEndpoint = 0;
+            portFunction.clear();
+            if (result == Result::ok && d.size() >= 12 && d[0]) {
+                // num_ports, endpoint_numbers_different, 2 reserved, then 8 bytes per port:
+                // function id (4), port, endpoint info (IN << 4 | OUT), 2 reserved.
+                const unsigned ports = std::min<unsigned>(d[0], unsigned((d.size() - 4) / 8));
+                unsigned chosen = 0;
+                for (unsigned i = 0; i < ports; ++i)
+                    if (!std::memcmp(&d[4 + 8 * i], "cnys", 4)) chosen = i;
+                const uint8_t* port = &d[4 + 8 * chosen];
+                portFunction = printable(port, 4);
+                inEndpoint = d[1] ? port[5] >> 4 : port[4];
+                outEndpoint = d[1] ? port[5] & 15 : port[4];
+            } else if (result == Result::stall) {
+                step = 7;
+                // GET_CONNECTION_INFORMATION (Visor, Palm OS 3): pick the HotSync port.
+                return StartControl(0xc2, 3, 0, 0, 18);
+            }
+            break;
+        case 7:
+            if (result == Result::ok && d.size() >= 4) {
+                const unsigned ports = std::min<unsigned>(d[0] | d[1] << 8, unsigned((d.size() - 2) / 2));
+                for (unsigned i = 0; i < ports; ++i)
+                    if (d[2 + 2 * i] == 2) {
+                        portFunction = "hotsync";
+                        inEndpoint = outEndpoint = d[3 + 2 * i];
+                    }
+            }
+            break;
+    }
+    const bool wasRunning = phase == Phase::running;
+    phase = Phase::running;
+    attempts = 0;
+    // No port named yet (the TX lists none outside HotSync at times): ask again each
+    // second. The bulk endpoints are never guessed; the TX ROM faults on OUT data to an
+    // endpoint it has not set up.
+    if (!inEndpoint || !outEndpoint) {
+        inEndpoint = outEndpoint = 0;
+        requeryAt = now + 1000 * frameNs;
+        if (!wasRunning) {
+            ++counters.enumerations;
+            Message("usb: enumerated " + hex4(vendor) + ":" + hex4(product) + ", no HotSync port yet");
+        }
+        return;
+    }
+    if (!wasRunning) ++counters.enumerations;
+    Message("usb: enumerated " + hex4(vendor) + ":" + hex4(product) + ", port " +
+            (portFunction.empty() ? std::string("(none)") : "'" + portFunction + "'") + " IN " +
+            std::to_string(inEndpoint) + " OUT " + std::to_string(outEndpoint));
+}
+
+// Reserves bus time for a transaction of `bits`, handshake included.
+// False if it would not fit in what is left of this frame.
+bool UsbBusHost::Begin(Token token, unsigned bits) {
+    const uint64_t ns = bitsNs(bits);
+    if (now < lastSof + bitsNs(sofBits)) {
+        retryAt = lastSof + bitsNs(sofBits);
+        return false;
+    }
+    if (now % frameNs + ns + eofGuardNs > frameNs) {
+        retryAt = nextSof + bitsNs(sofBits);
+        return false;
+    }
+    inFlight = token;
+    busyUntil = now + ns;
+    if (log) log->push_back({now, now + ns});
+    ++counters.transactions;
+    return true;
+}
+
+bool UsbBusHost::StartTransaction() {
+    auto* u = udc();
+    if (control.active) {
+        if (now < control.startAt) {
+            retryAt = control.startAt;
+            return false;
+        }
+        if (now > control.deadline) {
+            ControlDone(Result::timeout);
+            return false;
+        }
+        switch (control.stage) {
+            case Stage::setup: return Begin(Token::setup, unsigned(transactionBits(8)));
+            case Stage::dataOut: {
+                const unsigned length = control.setup[6] | control.setup[7] << 8;
+                return Begin(Token::out0, unsigned(transactionBits(std::min<unsigned>(maxPacket0, length - unsigned(control.sent)))));
+            }
+            case Stage::statusOut: return Begin(Token::out0, unsigned(transactionBits(0)));
+            case Stage::dataIn:
+            case Stage::statusIn: {
+                if (!Addressed()) return Begin(Token::in0, unsigned(timeoutBits));
+                unsigned size = 0;
+                const R r = pxa270UdcHostPeekIn(u, 0, &size);
+                return Begin(Token::in0, unsigned(r == R::Ack ? transactionBits(size) : nakBits));
+            }
+        }
+        return false;
+    }
+    if (phase != Phase::running) return false;
+    if (!inEndpoint) {
+        if (now < requeryAt) {
+            retryAt = requeryAt;
+            return false;
+        }
+        step = 6;
+        StartControl(0xc2, 4, 0, 0, 20);
+        return false;
+    }
+    if (clearHalt) {
+        StartControl(0x02, 1, 0, haltedEndpoint, 0);
+        return false;
+    }
+    if (!outPending && link.receive) {
+        outSize = unsigned(link.receive(outPacket, 64));
+        outPending = outSize != 0;
+    }
+    const bool wantIn = link.sendSpace && link.sendSpace() >= 64;
+    if (outPending && (preferOut || !wantIn)) {
+        preferOut = false;
+        inFlightEndpoint = outEndpoint;
+        return Begin(Token::bulkOut, unsigned(Addressed() ? transactionBits(outSize) : timeoutBits));
+    }
+    preferOut = true;
+    waitSpace = !wantIn;
+    if (!wantIn) {
+        Nak();  // Service pokes once the host side has room or bytes
+        return false;
+    }
+    inFlightEndpoint = uint8_t(0x80 | inEndpoint);
+    if (!Addressed()) return Begin(Token::bulkIn, unsigned(timeoutBits));
+    unsigned size = 0;
+    const R r = pxa270UdcHostPeekIn(u, inFlightEndpoint, &size);
+    return Begin(Token::bulkIn, unsigned(r == R::Ack ? transactionBits(size) : r == R::Timeout ? timeoutBits : nakBits));
+}
+
+void UsbBusHost::FinishTransaction() {
+    auto* u = udc();
+    const Token token = inFlight;
+    inFlight = Token::none;
+    const bool addressed = Addressed();
+    auto nak = [&] {
+        ++counters.naks;
+        Nak();
+        // Nothing but NAKs on a standard request for a while: the device may have missed
+        // the SETUP. Vendor requests (the Palm port list) can take a TX several hundred
+        // ms, and a new SETUP would start them over.
+        if (control.active && control.stage != Stage::setup && !(control.setup[0] & 0x60) &&
+            now >= control.setupAt + setupRetryNs) {
+            ++counters.setupRetries;
+            char text[96];
+            std::snprintf(text, sizeof(text), "usb: no answer on EP0 to %02x/%02x %ums after its SETUP, sending it again",
+                          control.setup[0], control.setup[1], unsigned((now - control.setupAt) / frameNs));
+            Message(text);
+            control.stage = Stage::setup;
+            control.data.clear();
+            control.sent = 0;
+        }
+    };
+    switch (token) {
+        case Token::none: return;
+        case Token::setup: {
+            if (!addressed) return ControlDone(Result::timeout);
+            const R r = pxa270UdcHostSetup(u, control.setup);
+            if (r != R::Ack) return ControlDone(Result::error);
+            control.setupAt = now;
+            const unsigned length = control.setup[6] | control.setup[7] << 8;
+            control.stage = (control.setup[0] & 0x80) ? (length ? Stage::dataIn : Stage::statusIn)
+                                                      : (length ? Stage::dataOut : Stage::statusIn);
+            return;
+        }
+        case Token::out0: {
+            if (!addressed) return ControlDone(Result::timeout);
+            const bool status = control.stage == Stage::statusOut;
+            const unsigned length = control.setup[6] | control.setup[7] << 8;
+            const unsigned n = status ? 0 : std::min<unsigned>(maxPacket0, length - unsigned(control.sent));
+            const R r = pxa270UdcHostOut(u, status ? nullptr : control.out.data() + control.sent, n);
+            if (r == R::Nak) return nak();
+            if (r == R::Stall) return ControlDone(Result::stall);
+            if (r != R::Ack) return ControlDone(Result::error);
+            if (status) return ControlDone(Result::ok);
+            control.sent += n;
+            if (control.sent >= length) control.stage = Stage::statusIn;
+            return;
+        }
+        case Token::in0: {
+            if (!addressed) return ControlDone(Result::timeout);
+            unsigned size = 0;
+            R r = pxa270UdcHostPeekIn(u, 0, &size);
+            uint8_t data[64];
+            if (r == R::Nak) return nak();
+            r = pxa270UdcHostIn(u, data, &size);  // ACK, or the STALL handshake
+            if (r == R::Nak) return nak();
+            if (r == R::Stall) return ControlDone(Result::stall);
+            if (r != R::Ack) return ControlDone(Result::error);
+            if (control.stage == Stage::statusIn) return ControlDone(size ? Result::error : Result::ok);
+            const unsigned length = control.setup[6] | control.setup[7] << 8;
+            control.data.insert(control.data.end(), data, data + size);
+            if (control.data.size() > length) return ControlDone(Result::error);
+            if (size < maxPacket0 || control.data.size() == length) control.stage = Stage::statusOut;
+            return;
+        }
+        case Token::bulkIn: {
+            uint8_t data[64];
+            unsigned size = 0;
+            const R r = addressed ? pxa270UdcHostEpIn(u, inFlightEndpoint, data, &size) : R::Timeout;
+            if (r == R::Ack) {
+                bulkTimeouts = 0;
+                if (size) link.send(data, size);
+                counters.bytesIn += size;
+                return;
+            }
+            if (r == R::Nak) return nak();
+            if (r == R::Stall) {
+                clearHalt = true;
+                haltedEndpoint = inFlightEndpoint;
+                return;
+            }
+            if (++bulkTimeouts >= 100) Restart("the bulk IN endpoint stopped answering");
+            else retryAt = now + nakRetryNs;
+            return;
+        }
+        case Token::bulkOut: {
+            const R r = addressed ? pxa270UdcHostEpOut(u, inFlightEndpoint, outPacket, outSize) : R::Timeout;
+            if (r == R::Ack) {
+                bulkTimeouts = 0;
+                outPending = false;
+                counters.bytesOut += outSize;
+                return;
+            }
+            if (r == R::Nak) return nak();
+            if (r == R::Stall) {
+                clearHalt = true;
+                haltedEndpoint = inFlightEndpoint;
+                return;
+            }
+            if (++bulkTimeouts >= 100) Restart("the bulk OUT endpoint stopped answering");
+            else retryAt = now + nakRetryNs;
+            return;
+        }
+    }
+}
+
+void UsbBusHost::Tick(uint64_t nowNs) {
+    now = nowNs;
+    ++counters.ticks;
+    if (poked) {
+        poked = false;
+        if (retryAt > now) retryAt = std::max(now, nakAt + nakRetryNs);
+    }
+    if (phase == Phase::detached || phase == Phase::failed) return;
+    auto* u = udc();
+    if (!u) return;
+    // On the bus: the device listens for a reset and EP0 (see pxa270UdcHostListening).
+    const bool present = pxa270UdcHostListening(u);
+    const bool reconnected = phase != Phase::waitEnable && pxa270UdcHostEnableCount(u) != enableCount;
+    if (!present || reconnected) {
+        if (phase != Phase::waitEnable) {
+            Message(present ? "usb: the TX left the bus and came back" : "usb: the TX left the bus; waiting");
+            Detach();
+            phase = Phase::waitEnable;
+        }
+        if (!present) return;
+    }
+    switch (phase) {
+        case Phase::waitEnable:
+            enableCount = pxa270UdcHostEnableCount(u);
+            phase = Phase::connect;
+            phaseAt = now + connectNs;
+            return;
+        case Phase::connect:
+            if (now < phaseAt) return;
+            // Port reset: the UDC drops its address and configuration at once; the host
+            // waits out the reset and recovery before its first SETUP.
+            if (!pxa270UdcHostReset(u)) return;
+            address = pendingAddress = 0;
+            maxPacket0 = 8;
+            phase = Phase::reset;
+            phaseAt = now + resetNs;
+            sofRunning = true;
+            lastSof = now / frameNs * frameNs;
+            nextSof = lastSof + frameNs;
+            retryAt = 0;
+            return;
+        default: break;
+    }
+    if (inFlight != Token::none && now >= busyUntil) FinishTransaction();
+    if (!Running()) return;  // a restart from FinishTransaction
+    if (sofRunning && now >= nextSof) {
+        // Frames slept through still count in UDCFNR, which wraps at 2048.
+        const uint64_t frames = (now - lastSof) / frameNs;
+        const uint64_t count = frames % 2048 ? frames % 2048 : 2048;
+        for (uint64_t i = 0; i < count; ++i) pxa270UdcHostFrame(u);
+        counters.frames += frames;
+        lastSof = now / frameNs * frameNs;
+        nextSof = lastSof + frameNs;
+    }
+    if (pendingAddress && now >= addressAt) {
+        address = pendingAddress;
+        pendingAddress = 0;
+    }
+    if (phase == Phase::reset) {
+        if (now < phaseAt) return;
+        phase = Phase::enumerate;
+        step = 0;
+        StartControl(0x80, 6, 0x0100, 0, 8);
+    }
+    if (inFlight != Token::none || now < retryAt) return;
+    // A step that only prepares (a new control transfer) may start at once.
+    for (unsigned i = 0; i < 2 && inFlight == Token::none && now >= retryAt && Running(); ++i)
+        if (StartTransaction()) break;
+}
diff --git a/src/uarm/uarm/UsbBusHost.h b/src/uarm/uarm/UsbBusHost.h
new file mode 100644
--- /dev/null
+++ b/src/uarm/uarm/UsbBusHost.h
@@ -0,0 +1,129 @@
+#ifndef FROND_USB_BUS_HOST_H
+#define FROND_USB_BUS_HOST_H
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "pxa270_UDC.h"
+
+// Full-speed USB host for the PXA27x UDC, run on emulated time by whoever calls Tick:
+// connect debounce, port reset, enumeration, SET_CONFIGURATION, Palm's
+// GET_EXT_CONNECTION_INFORMATION (vendor request 0x04, or 0x03 if that stalls), then
+// bulk IN/OUT polling on the HotSync port, with the bytes going to and from `Link`.
+// Rules kept on the bus:
+// - SOF every 1 ms of emulated time. A transaction never crosses the end of a frame.
+// - SETUP and OUT data reach the UDC, and an IN is taken from it, only once the whole
+//   packet has been on the wire. A NAKed token is retried 10 us after the guest next
+//   writes to the UDC (see Poke), or at the start of the next frame.
+// - A standard control request that only gets NAKs sends its SETUP again every 100 ms,
+//   as the device may have lost it, until the 500 ms deadline. The TX ROM reads a SETUP
+//   and then drops it at times while it starts HotSync.
+// - A control transfer starts on a frame boundary at least 1 ms after the previous one.
+// - Tokens go to the host's idea of the device address; another address gets no answer.
+// Nothing here is session state. Every call runs on the emulator thread.
+class UsbBusHost {
+   public:
+    struct Link {
+        std::function<size_t()> sendSpace;                       // guest to host room
+        std::function<size_t(const uint8_t*, size_t)> send;      // guest to host
+        std::function<size_t(uint8_t*, size_t)> receive;         // host to guest
+        std::function<size_t()> pending;                         // host to guest bytes waiting
+    };
+    enum class Phase { detached, waitEnable, connect, reset, enumerate, running, failed };
+    static constexpr uint64_t frameNs = 1000000;
+    static constexpr uint64_t nakRetryNs = 10000;
+    static constexpr uint64_t connectNs = 100 * frameNs;   // USB 2.0 7.1.7.3 debounce
+    static constexpr uint64_t resetNs = 20 * frameNs;      // 10 ms reset, 10 ms recovery
+    static constexpr uint64_t controlTimeoutNs = 500 * frameNs;
+    static constexpr uint64_t setupRetryNs = 100 * frameNs;
+    static constexpr uint64_t retryNs = 250 * frameNs;  // after a failed enumeration
+    static constexpr unsigned maxAttempts = 5;
+    static constexpr uint8_t deviceAddress = 2;
+
+    struct Counters {
+        uint64_t frames{}, transactions{}, naks{}, bytesIn{}, bytesOut{}, enumerations{}, setupRetries{}, ticks{};
+    };
+
+    UsbBusHost(std::function<Pxa270Udc*()> udc, Link link);
+
+    void Attach();     // cable in: waits for the device to listen, then resets and enumerates
+    void Detach();     // cable out: forgets the device
+    void Tick(uint64_t nowNs);
+    // Emulated time the next Tick is needed by: 0 for at once, UINT64_MAX for none
+    // (detached, failed, or waiting for the guest to turn the UDC on).
+    uint64_t NextWake() const;
+    // The guest wrote to the UDC: tick soon and retry a NAKed token.
+    void Poke() { poked = true; }
+    // Bytes or room arrived on the link while the bridge was idle; Poke if so.
+    bool LinkWaiting() const;
+    Phase GetPhase() const { return phase; }
+    static const char* PhaseName(Phase phase);
+
+    uint16_t Vendor() const { return vendor; }
+    uint16_t Product() const { return product; }
+    const std::string& PortFunction() const { return portFunction; }
+    uint8_t InEndpoint() const { return inEndpoint; }
+    uint8_t OutEndpoint() const { return outEndpoint; }
+    const Counters& GetCounters() const { return counters; }
+    std::vector<std::string> TakeMessages() { return std::move(messages); }
+
+    // Optional record of every transaction's bus interval [start, end) in ns.
+    std::vector<std::pair<uint64_t, uint64_t>>* log{nullptr};
+
+   private:
+    enum class Token : uint8_t { none, setup, out0, in0, bulkIn, bulkOut };
+    enum class Stage : uint8_t { setup, dataIn, dataOut, statusIn, statusOut };
+    struct Control {
+        bool active{false};
+        uint8_t setup[8]{};
+        std::vector<uint8_t> out, data;
+        Stage stage{Stage::setup};
+        size_t sent{0};
+        uint64_t startAt{0}, deadline{0}, setupAt{0};
+    };
+    enum class Result { ok, stall, timeout, error };
+
+    void Restart(const char* why);
+    void StartControl(uint8_t type, uint8_t request, uint16_t value, uint16_t index, uint16_t length);
+    void ControlDone(Result result);
+    void EnumerationStep(Result result);
+    bool StartTransaction();
+    void FinishTransaction();
+    bool Begin(Token token, unsigned bytes);
+    void Message(const std::string& text);
+    void Nak();
+    bool Running() const { return phase == Phase::reset || phase == Phase::enumerate || phase == Phase::running; }
+    bool Addressed();
+
+    std::function<Pxa270Udc*()> udc;
+    Link link;
+    Phase phase{Phase::detached};
+    uint64_t now{0}, phaseAt{0}, nextSof{0}, lastSof{0}, busyUntil{0}, retryAt{0}, lastControlEnd{0};
+    bool sofRunning{false}, poked{false}, waitSpace{false};
+    uint64_t nakAt{0};
+    Token inFlight{Token::none};
+    uint8_t inFlightEndpoint{0};
+    unsigned attempts{0};
+    uint8_t address{0}, pendingAddress{0};
+    uint64_t addressAt{0};
+    Control control;
+    unsigned step{0};
+    uint8_t maxPacket0{8}, configuration{0};
+    uint16_t configLength{0}, vendor{0}, product{0};
+    std::string portFunction;
+    uint8_t inEndpoint{0}, outEndpoint{0};
+    // Running: the OUT packet being sent and which direction goes next.
+    uint8_t outPacket[64]{};
+    unsigned outSize{0};
+    bool outPending{false}, preferOut{false}, clearHalt{false};
+    uint8_t haltedEndpoint{0};
+    unsigned bulkTimeouts{0};
+    uint32_t enableCount{0};
+    uint64_t requeryAt{0};  // the UDC's UDE count when this connection began
+    Counters counters;
+    std::vector<std::string> messages;
+};
+#endif
diff --git a/src/uarm/uarm/UsbHostBridge.cpp b/src/uarm/uarm/UsbHostBridge.cpp
new file mode 100644
--- /dev/null
+++ b/src/uarm/uarm/UsbHostBridge.cpp
@@ -0,0 +1,159 @@
+#ifndef __EMSCRIPTEN__
+#include "UsbHostBridge.h"
+
+#include "soc_PXA.h"
+
+struct UsbHostBridge::Impl {
+    SocPXA* soc{nullptr};
+    Config config;
+    HostByteLink link;
+    std::unique_ptr<UsbBusHost> host;
+    bool replaced{false}, plugPending{false};
+    uint64_t plugAt{0};
+    std::vector<std::string> messages;
+    UsbBusHost::Phase lastPhase{UsbBusHost::Phase::detached};
+
+    // Peripheral batch, on emulated time: unplug after a load or reset, plug in when
+    // due, then the host's own work.
+    static void Tick(void* context, uint64_t now) {
+        auto& self = *static_cast<Impl*>(context);
+        if (!self.host) return;
+        if (self.replaced) {
+            self.replaced = false;
+            self.Unplug();
+            self.plugPending = true;
+            self.plugAt = now + replugNs;
+        }
+        if (self.plugPending && now >= self.plugAt) {
+            self.plugPending = false;
+            self.soc->SetUsbTestCable(true);
+            self.host->Attach();
+        }
+        self.host->Tick(now);
+    }
+    static uint64_t Wake(void* context) {
+        auto& self = *static_cast<Impl*>(context);
+        if (!self.host) return UINT64_MAX;
+        if (self.replaced) return 0;
+        const uint64_t wake = self.host->NextWake();
+        return self.plugPending ? std::min(wake, self.plugAt) : wake;
+    }
+    // Reset or load: the host forgets the device at once; the next tick unplugs the cable.
+    // Off: a session saved while the bridge had the cable out gets it back in.
+    static void Replaced(void* context) {
+        auto& self = *static_cast<Impl*>(context);
+        self.replaced = true;
+        if (self.host) self.host->Detach();
+        self.link.Clear();
+    }
+    // Any guest write to the UDC.
+    static void Notify(void* context) {
+        auto& self = *static_cast<Impl*>(context);
+        if (!self.host) return;
+        self.host->Poke();
+        self.soc->KickUsbHost();
+    }
+    void Unplug() {
+        if (soc->UsbTestCableAttached()) soc->SetUsbTestCable(false);
+    }
+};
+
+UsbHostBridge::UsbHostBridge() : impl(std::make_unique<Impl>()) {}
+UsbHostBridge::~UsbHostBridge() { Stop(); }
+
+bool UsbHostBridge::Start(SocPXA* soc, const Config& config, std::string& error) {
+    Stop();
+    if (!soc || soc->GetDeviceType() != DeviceType5::deviceTypeTX || !soc->GetUsbController()) {
+        if (config.kind == HostSerial::Kind::off) return true;
+        error = "This device has no USB port.";
+        return false;
+    }
+    // Off, or an endpoint that can't open: GPIO13 stays low, the level the TX has always
+    // had without a bridge, also after loading a session saved while a bridge had the
+    // cable out.
+    auto off = [&] {
+        impl->soc = soc;
+        if (!soc->UsbTestCableAttached()) soc->SetUsbTestCable(true);
+        const UsbHostHooks hooks{impl.get(), nullptr, nullptr, Impl::Replaced};
+        soc->SetUsbHostHooks(&hooks);
+    };
+    if (config.kind == HostSerial::Kind::off) {
+        off();
+        return true;
+    }
+    if (!impl->link.Open(config, error)) {
+        off();
+        return false;
+    }
+    impl->soc = soc;
+    const bool wasPlugged = soc->UsbTestCableAttached();
+    impl->Unplug();
+    impl->config = impl->link.GetConfig();
+    auto* link = &impl->link;
+    impl->host = std::make_unique<UsbBusHost>(
+        [soc] { return soc->GetUsbController(); },
+        UsbBusHost::Link{[link] { return link->SendSpace(); },
+                         [link](const uint8_t* data, size_t size) { return link->Send(data, size); },
+                         [link](uint8_t* data, size_t size) { return link->Receive(data, size); },
+                         [link] { return link->PendingReceive(); }});
+    // A cable the session left plugged in comes out first, so the TX sees a new plug.
+    impl->plugPending = true;
+    impl->plugAt = soc->GetTime() + (wasPlugged ? replugNs : 0);
+    impl->lastPhase = UsbBusHost::Phase::detached;
+    const UsbHostHooks hooks{impl.get(), Impl::Tick, Impl::Wake, Impl::Replaced};
+    soc->SetUsbHostHooks(&hooks);
+    pxa270UdcHostSetNotify(soc->GetUsbController(), Impl::Notify, impl.get());
+    soc->KickUsbHost();
+    return true;
+}
+
+void UsbHostBridge::Stop() {
+    if (!impl->soc) return;
+    impl->soc->SetUsbHostHooks(nullptr);
+    if (impl->soc->GetUsbController()) pxa270UdcHostSetNotify(impl->soc->GetUsbController(), nullptr, nullptr);
+    // Back to the level the TX has without a bridge: GPIO13 low, no host on the bus.
+    if (impl->host) impl->host->Detach();
+    if (!impl->soc->UsbTestCableAttached()) impl->soc->SetUsbTestCable(true);
+    impl->host.reset();
+    impl->link.Close();
+    impl->soc = nullptr;
+    impl->config = {};
+    impl->replaced = impl->plugPending = false;
+}
+
+void UsbHostBridge::Service() {
+    auto* soc = impl->soc;
+    if (!soc) return;
+    if (!impl->host) {
+        // Off: put the cable back after a load (see Start).
+        if (impl->replaced) {
+            impl->replaced = false;
+            if (!soc->UsbTestCableAttached()) soc->SetUsbTestCable(true);
+        }
+        return;
+    }
+    // The emulated-time work happens in the peripheral batch; this only wakes it when
+    // a load dropped its schedule, the host side has bytes or room, or it is overdue.
+    if (impl->host->LinkWaiting()) impl->host->Poke();
+    const uint64_t wake = Impl::Wake(impl.get());
+    if (wake <= soc->GetTime()) soc->KickUsbHost();
+    for (auto& message : impl->host->TakeMessages()) impl->messages.push_back(std::move(message));
+    const auto phase = impl->host->GetPhase();
+    if (phase != impl->lastPhase) {
+        impl->lastPhase = phase;
+        impl->messages.push_back(std::string("usb: ") + UsbBusHost::PhaseName(phase));
+    }
+}
+
+UsbHostBridge::Config UsbHostBridge::GetConfig() const { return impl->config; }
+std::string UsbHostBridge::Endpoint() const { return impl->link.Endpoint(); }
+
+std::string UsbHostBridge::Describe() const {
+    if (!impl->host) return "off";
+    return std::string(impl->config.kind == HostSerial::Kind::pty ? "pty " : "tcp ") + impl->link.Endpoint() +
+           (impl->link.Connected() ? " connected " : " waiting ") + UsbBusHost::PhaseName(impl->host->GetPhase());
+}
+
+const UsbBusHost* UsbHostBridge::Host() const { return impl->host.get(); }
+std::vector<std::string> UsbHostBridge::TakeMessages() { return std::move(impl->messages); }
+#endif
