+        cpuSetReg(cpu,14,p->site+4);
+        cpuSetReg(cpu,15,p->stub);
+        if (getenv("FROND_TRACE_WAKE")) fprintf(stderr,"native: host wake\n");
+        return true;
+    } catch (const std::runtime_error&) { return false; }
