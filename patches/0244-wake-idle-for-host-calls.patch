+bool WakeIdle(SoC& soc) {
+    try {
+        if (syscallDispatchInProgress(soc.GetSyscallDispatch())) return false;
+        const IdleWake* p=idleWake(soc);
+        if (!p || !soc.RunToNativePc(p->site,0,budget,budget)) return false;
+        auto* cpu=soc.GetCpu();
+        auto* r=cpuGetRegisters(cpu);
