--- /dev/null
+++ b/src/uarm/uarm/jit_dynarmic.cpp
@@ -0,0 +1,267 @@
+// dynarmic JIT for ordinary guest code (trial). Built as C++20 with FROND_DYNARMIC.
+// Privileged, coprocessor and Frond's special instructions end the block and go back to
+// the interpreter, which also takes every exception and IRQ between runs.
+#include "jit_dynarmic.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+#include "dynarmic/frontend/A32/a32_ir_emitter.h"
+#include "dynarmic/interface/A32/a32.h"
+#include "dynarmic/interface/A32/config.h"
+#include "dynarmic/ir/terminal.h"
+
+namespace {
+
+using namespace Dynarmic;
+using PageTable = std::array<std::uint8_t *, A32::UserConfig::NUM_PAGE_TABLE_ENTRIES>;
+
+// Counters for FROND_JIT_STATS=1.
+struct Stats {
+    uint64_t runs = 0, ran = 0, interpret = 0, halt = 0, fault = 0, invalAll = 0, invalRange = 0;
+    std::unordered_map<uint32_t, uint64_t> interpPc;
+    uint64_t pagesChanged = 0, pageClears = 0, pageFills = 0, reads = 0, writes = 0;
+    ~Stats() {
+        const char *v = getenv("FROND_JIT_STATS");
+        if (!v || !*v || !strcmp(v, "0")) return;
+        fprintf(stderr,
+                "jit: runs %llu ran %llu interpret %llu halt %llu fault %llu invalAll %llu "
+                "invalRange %llu pagesChanged %llu pageClears %llu pageFills %llu reads %llu writes %llu\n",
+                (unsigned long long)runs, (unsigned long long)ran, (unsigned long long)interpret,
+                (unsigned long long)halt, (unsigned long long)fault, (unsigned long long)invalAll,
+                (unsigned long long)invalRange, (unsigned long long)pagesChanged, (unsigned long long)pageClears,
+                (unsigned long long)pageFills, (unsigned long long)reads, (unsigned long long)writes);
+        std::vector<std::pair<uint64_t, uint32_t>> top;
+        for (auto &[pc, n] : interpPc) top.push_back({n, pc});
+        std::sort(top.rbegin(), top.rend());
+        for (size_t i = 0; i < top.size() && i < 12; i++)
+            fprintf(stderr, "jit: interpret %08x %llu\n", top[i].second, (unsigned long long)top[i].first);
+    }
+} stats;
+
+constexpr HaltReason kInterpret = HaltReason::UserDefined2;
+constexpr HaltReason kSlowPath = HaltReason::UserDefined3;
+constexpr HaltReason kFault = HaltReason::UserDefined4;
+
+struct Env final : public A32::UserCallbacks {
+    ArmCpu *cpu = nullptr;
+    A32::Jit *jit = nullptr;
+    PageTable *pages = nullptr;
+    std::vector<uint32_t> filled;  // page table entries to clear
+    // Guest cache invalidations come often (whole cache tens of times a second), so the
+    // translated code survives them while its page still holds the same bytes. Each page
+    // that code was read from keeps a copy taken when it was first read.
+    std::unordered_map<uint32_t, std::vector<uint8_t>> codePages;
+    bool checkCode = false;
+
+    bool PageBytes(uint32_t page, uint8_t *out) {
+        const uint32_t va = page << 12;
+        for (uint32_t off = 0; off < 4096; off += 4) {
+            uint32_t w;
+            if (off == 0) {
+                if (uint8_t *host = cpuJitCodePage(cpu, va)) {
+                    std::memcpy(out, host, 4096);
+                    return true;
+                }
+            }
+            if (!cpuJitFetch(cpu, va + off, &w)) return false;
+            std::memcpy(out + off, &w, 4);
+        }
+        return true;
+    }
+
+    void NoteCodePage(uint32_t va) {
+        const uint32_t page = va >> 12;
+        if (codePages.count(page)) return;
+        std::vector<uint8_t> copy(4096);
+        if (!PageBytes(page, copy.data())) copy.clear();
+        codePages.emplace(page, std::move(copy));
+    }
+
+    void CheckCode() {
+        checkCode = false;
+        uint8_t now[4096];
+        for (auto &[page, copy] : codePages) {
+            const bool ok = PageBytes(page, now);
+            if (ok && copy.size() == 4096 && !std::memcmp(now, copy.data(), 4096)) continue;
+            stats.pagesChanged++;
+            jit->InvalidateCacheRange(page << 12, 4096);
+            if (ok) copy.assign(now, now + 4096); else copy.clear();
+        }
+    }
+    uint64_t gen = ~0ull;
+    uint64_t budget = 0, ran = 0;
+
+    void ClearPages() {
+        stats.pageClears++;
+        for (uint32_t i : filled) (*pages)[i] = nullptr;
+        filled.clear();
+    }
+
+    void CheckGen() {
+        const uint64_t g = cpuJitPageGen(cpu);
+        if (g != gen) {
+            ClearPages();
+            gen = g;
+        }
+    }
+
+    void Fault() { jit->HaltExecution(kFault); }
+
+    void AfterIo() {
+        if (cpuJitSlowPath(cpu)) jit->HaltExecution(kSlowPath);
+    }
+
+    template <typename T>
+    T Read(A32::VAddr va) {
+        T v{};
+        stats.reads++;
+        if (!cpuJitRead(cpu, va, sizeof(T), &v)) {
+            Fault();
+            return 0;
+        }
+        // Only aligned reads land here for pages the table could hold; fill it.
+        CheckGen();
+        const uint32_t page = va >> 12;
+        if (!(*pages)[page]) {
+            if (uint8_t *host = cpuJitReadPage(cpu, va)) {
+                stats.pageFills++;
+                (*pages)[page] = host;
+                filled.push_back(page);
+            } else {
+                AfterIo();
+            }
+        }
+        return v;
+    }
+
+    template <typename T>
+    void Write(A32::VAddr va, T v) {
+        stats.writes++;
+        if (!cpuJitWrite(cpu, va, sizeof(T), &v)) {
+            Fault();
+            return;
+        }
+        AfterIo();
+    }
+
+    std::optional<std::uint32_t> MemoryReadCode(A32::VAddr va) override {
+        NoteCodePage(va);
+        uint32_t w;
+        if (!cpuJitFetch(cpu, va, &w)) return std::nullopt;
+        return w;
+    }
+
+    bool PreCodeReadHook(bool thumb, A32::VAddr pc, A32::IREmitter &ir) override {
+        uint32_t w;
+        if (cpuJitFetch(cpu, pc & ~3u, &w) && cpuJitPlain(cpu, pc, w, thumb)) return true;
+        ir.SetTerm(IR::Term::Interpret(ir.current_location));
+        return false;
+    }
+
+    std::uint8_t MemoryRead8(A32::VAddr va) override { return Read<uint8_t>(va); }
+    std::uint16_t MemoryRead16(A32::VAddr va) override { return Read<uint16_t>(va); }
+    std::uint32_t MemoryRead32(A32::VAddr va) override { return Read<uint32_t>(va); }
+    std::uint64_t MemoryRead64(A32::VAddr va) override { return Read<uint64_t>(va); }
+    void MemoryWrite8(A32::VAddr va, std::uint8_t v) override { Write(va, v); }
+    void MemoryWrite16(A32::VAddr va, std::uint16_t v) override { Write(va, v); }
+    void MemoryWrite32(A32::VAddr va, std::uint32_t v) override { Write(va, v); }
+    void MemoryWrite64(A32::VAddr va, std::uint64_t v) override { Write(va, v); }
+
+    void InterpreterFallback(A32::VAddr pc, size_t) override {
+        stats.interpPc[pc]++;
+        jit->HaltExecution(kInterpret);
+    }
+    void CallSVC(std::uint32_t) override { jit->HaltExecution(kInterpret); }
+
+    // Undefined, unpredictable and no-execute: PC is past the instruction and its tick
+    // is counted, so step back and let the interpreter run it.
+    void ExceptionRaised(A32::VAddr pc, A32::Exception) override {
+        jit->Regs()[15] = pc;
+        undoTick = true;
+        jit->HaltExecution(kInterpret);
+    }
+
+    void AddTicks(std::uint64_t ticks) override { ran += ticks; }
+    std::uint64_t GetTicksRemaining() override { return budget; }
+
+    bool undoTick = false;
+};
+
+}  // namespace
+
+struct FrondJit {
+    Env env;
+    PageTable pages{};
+    std::unique_ptr<A32::Jit> jit;
+};
+
+FrondJit *jitCreate(ArmCpu *cpu) {
+    auto *j = new FrondJit;
+    j->env.cpu = cpu;
+    j->env.pages = &j->pages;
+    A32::UserConfig conf;
+    conf.callbacks = &j->env;
+    conf.arch_version = A32::ArchVersion::v5TE;
+    conf.page_table = &j->pages;
+    conf.page_table_writes_via_callbacks = true;
+    conf.check_halt_on_link = true;
+    // Unaligned accesses go through the callbacks, which fault on them.
+    conf.detect_misaligned_access_via_page_table = 16 | 32 | 64;
+    conf.only_detect_misalignment_via_page_table_on_page_boundary = false;
+    conf.always_little_endian = true;
+    conf.code_cache_size = 64 * 1024 * 1024;
+    j->jit = std::make_unique<A32::Jit>(conf);
+    j->env.jit = j->jit.get();
+    return j;
+}
+
+void jitDestroy(FrondJit *j) { delete j; }
+
+void jitInvalidate(FrondJit *j, uint32_t va, uint32_t size) {
+    stats.invalRange++;
+    j->env.checkCode = true;
+}
+
+void jitInvalidateAll(FrondJit *j) {
+    stats.invalAll++;
+    j->env.checkCode = true;
+}
+
+uint32_t jitRun(FrondJit *j, uint32_t *regs, uint32_t &cpsr, uint32_t cycles, int &stop) {
+    Env &e = j->env;
+    A32::Jit &jit = *j->jit;
+    e.CheckGen();
+    if (e.checkCode) e.CheckCode();
+    std::memcpy(jit.Regs().data(), regs, 16 * sizeof(uint32_t));
+    jit.SetCpsr(cpsr);
+    e.budget = cycles;
+    e.ran = 0;
+    e.undoTick = false;
+    const HaltReason hr = jit.Run();
+    jit.ClearHalt(kInterpret | kSlowPath | kFault);
+    std::memcpy(regs, jit.Regs().data(), 16 * sizeof(uint32_t));
+    cpsr = jit.Cpsr();
+    uint64_t ran = e.ran;
+    if (e.undoTick && ran) ran--;
+    stats.runs++;
+    stats.ran += ran;
+    if (Has(hr, kFault)) stats.fault++;
+    if (Has(hr, kInterpret)) stats.interpret++;
+    if (Has(hr, kSlowPath)) stats.halt++;
+    if (Has(hr, kFault))
+        stop = FROND_JIT_FAULT;
+    else if (Has(hr, kInterpret))
+        stop = FROND_JIT_INTERPRET;
+    else if (Has(hr, kSlowPath))
+        stop = FROND_JIT_HALT;
+    else
+        stop = FROND_JIT_BUDGET;
+    return uint32_t(ran);
+}
