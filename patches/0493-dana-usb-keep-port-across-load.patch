+    // The bus side a session keeps across a load, apart from save(): address, configuration, the
+    // bulk halts and the OUT toggle. Call after load(); anything in flight is dropped.
+    struct Bus { unsigned address = 0, configuration = 0; bool haltIn = false, haltOut = false, outToggle = false; };
+    Bus bus() const { return {address, configuration, haltIn, haltOut, outToggle}; }
+    bool setBus(const Bus& b) {
+        if(b.address > 127 || b.configuration > 1 || (b.configuration && !b.address) ||
+           (!b.configuration && (b.haltIn || b.haltOut || b.outToggle))) return false;
+        busReset();
+        address = b.address; configuration = b.configuration; haltIn = b.haltIn; haltOut = b.haltOut; outToggle = b.outToggle;
+        return true;
+    }
