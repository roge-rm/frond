+
+// Bus operations shared by the PXA25x and PXA27x hosts. Register semantics remain
+// in their respective controllers. Implicit pointer conversion preserves TX fixtures.
+class UsbDevicePort {
+ public:
+    UsbDevicePort() = default;
+    UsbDevicePort(Pxa270Udc* p): p270(p) {}
+    UsbDevicePort(Pxa255Udc* p): p255(p) {}
+    explicit operator bool() const { return p270 || p255; }
+    bool Reset() const { return p270 ? pxa270UdcHostReset(p270) : pxa255UdcHostReset(p255); }
+    bool Frame() const { return p270 ? pxa270UdcHostFrame(p270) : pxa255UdcHostFrame(p255); }
+    bool Enabled() const { return p270 ? pxa270UdcHostEnabled(p270) : pxa255UdcHostEnabled(p255); }
+    bool Listening() const { return p270 ? pxa270UdcHostListening(p270) : pxa255UdcHostListening(p255); }
+    bool SofWanted() const { return p270 ? pxa270UdcHostSofWanted(p270) : pxa255UdcHostSofWanted(p255); }
+    uint32_t EnableCount() const { return p270 ? pxa270UdcHostEnableCount(p270) : pxa255UdcHostEnableCount(p255); }
+    uint8_t Address() const { return p270 ? pxa270UdcHostAddress(p270) : pxa255UdcHostAddress(p255); }
+    void SetNotify(void (*notify)(void*), void* context) const { if(p270) pxa270UdcHostSetNotify(p270, notify, context); else if(p255) pxa255UdcHostSetNotify(p255, notify, context); }
+    Pxa270UdcHostResult Setup(const uint8_t* data) const { return p270 ? pxa270UdcHostSetup(p270, data) : pxa255UdcHostSetup(p255, data); }
+    Pxa270UdcHostResult Out(const uint8_t* data, unsigned size) const { return p270 ? pxa270UdcHostOut(p270, data, size) : pxa255UdcHostOut(p255, data, size); }
+    Pxa270UdcHostResult In(uint8_t* data, unsigned* size) const { return p270 ? pxa270UdcHostIn(p270, data, size) : pxa255UdcHostIn(p255, data, size); }
+    Pxa270UdcHostResult EpOut(uint8_t ep, const uint8_t* data, unsigned size) const { return p270 ? pxa270UdcHostEpOut(p270, ep, data, size) : pxa255UdcHostEpOut(p255, ep, data, size); }
+    Pxa270UdcHostResult EpIn(uint8_t ep, uint8_t* data, unsigned* size) const { return p270 ? pxa270UdcHostEpIn(p270, ep, data, size) : pxa255UdcHostEpIn(p255, ep, data, size); }
+    Pxa270UdcHostResult PeekIn(uint8_t ep, unsigned* size) const { return p270 ? pxa270UdcHostPeekIn(p270, ep, size) : pxa255UdcHostPeekIn(p255, ep, size); }
+ private:
+    Pxa270Udc* p270{nullptr};
+    Pxa255Udc* p255{nullptr};
+};
