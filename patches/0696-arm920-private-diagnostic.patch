+void Imx1Bootstrap::emitDiagnosticMemory(const ArmDiagnosticSink& sink) const {
+    const uint32_t internal[] = {0x00300000,uint32_t(sram.size()),uint32_t(sram.size()),0,1};
+    sink.emit("sram-map",internal,5);
