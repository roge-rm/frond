+const uint8_t* stateRomDigest(const Probe& p) {
+    if (!p.romDigestKnown) {
+        MD5Context md5;
+        md5Init(&md5);
+        if (!p.rom.empty()) md5Update(&md5, const_cast<uint8_t*>(p.rom.data()), p.rom.size());
+        md5Finalize(&md5);
+        std::memcpy(p.romDigest, md5.digest, 16);
+        p.romDigestKnown = true;
+    }
+    return p.romDigest;
+}
