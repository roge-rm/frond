+constexpr uint64_t stateLayoutFingerprint() {
+    const uint64_t words[] = {
+        stateFourcc("IDNT"), stateIdentityVersion, sizeof(Imx1ProbeOptions),
+        stateFourcc("PROB"), ProbeState::stateVersion, sizeof(Probe), sizeof(Imx1ProbeResult),
+        stateFourcc("CPU "), Arm920SavedState::stateVersion, sizeof(Arm920SavedState),
+        stateFourcc("BOOT"), Imx1Bootstrap::stateVersion, sizeof(Imx1Bootstrap),
+        Imx1Aitc::stateVersion, sizeof(Imx1Aitc), Imx1Cgm::stateVersion, sizeof(Imx1Cgm),
+        Imx1Gpio::stateVersion, sizeof(Imx1Gpio), Imx1Eim::stateVersion, sizeof(Imx1Eim),
+        Imx1Timer::stateVersion, sizeof(Imx1Timer), Imx1Sysctrl::stateVersion, sizeof(Imx1Sysctrl),
+        Imx1Mmcsd::stateVersion, sizeof(Imx1Mmcsd), Imx1I2c::stateVersion, sizeof(Imx1I2c),
+        Imx1Asp::stateVersion, sizeof(Imx1Asp), Imx1Pwm::stateVersion, sizeof(Imx1Pwm),
+        Imx1Watchdog::stateVersion, sizeof(Imx1Watchdog), Imx1Rtc::stateVersion, sizeof(Imx1Rtc),
+        stateFourcc("CS4 "), Imx1Cs4Capture::stateVersion, sizeof(Imx1Cs4Capture),
+        stateFourcc("CS5R"), Imx1Cs5Reset::stateVersion, sizeof(Imx1Cs5Reset),
+        stateFourcc("CS5C"), Imx1Cs5Configuration::stateVersion, sizeof(Imx1Cs5Configuration),
+        Imx1GraphicsGpio::stateVersion, sizeof(Imx1GraphicsGpio),
+        Imx1GraphicsWindows::stateVersion, sizeof(Imx1GraphicsWindows),
+        Imx1GraphicsLookup::stateVersion, sizeof(Imx1GraphicsLookup),
+        Imx1GraphicsController::stateVersion, sizeof(Imx1GraphicsController),
+        Imx1GraphicsEngine::stateVersion, sizeof(Imx1GraphicsEngine),
+        Imx1GraphicsDisplay::stateVersion, sizeof(Imx1GraphicsDisplay),
+        Imx1GraphicsInterrupts::stateVersion, sizeof(Imx1GraphicsInterrupts),
+        Imx1GraphicsAcquisition::stateVersion, sizeof(Imx1GraphicsAcquisition),
+        Imx1GraphicsSd::stateVersion, sizeof(Imx1GraphicsSd),
+        Imx1GraphicsClocks::stateVersion, sizeof(Imx1GraphicsClocks),
+        stateFourcc("GCMD"), Imx1GraphicsCommands::stateVersion, sizeof(Imx1GraphicsCommands),
+        stateFourcc("GMEM"), Imx1GraphicsMemory::stateVersion, sizeof(Imx1GraphicsMemory), stateGraphicsMemoryVersion,
+        stateFourcc("FRAM"), Imx1GraphicsFrame::stateVersion, sizeof(Imx1GraphicsFrame),
+        stateFourcc("I2CB"), stateBusVersion,
+        stateMemoryVersion, stateRingVersion, stateJitVersion};
+    uint64_t hash = 1469598103934665603ull;
+    for (const auto word : words) hash = stateLayoutMix(hash, word);
+    return hash;
