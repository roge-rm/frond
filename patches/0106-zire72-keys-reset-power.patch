diff --git a/src/uarm/native/Commands.cpp b/src/uarm/native/Commands.cpp
--- a/src/uarm/native/Commands.cpp
+++ b/src/uarm/native/Commands.cpp
@@ -128,7 +128,10 @@
     void CmdResetHard(vector<string> args, cli::CommandEnvironment& env, void* context) {
         auto ctx = reinterpret_cast<commands::Context*>(context);
 
-        ctx->soc->JamKey(keyIdPower, 2000);
+        // The Zire's DAL only checks the power key after it's released, so its hard reset is a
+        // power-on reset: the small ROM marks the RAM store invalid and Palm OS boots clean.
+        if (ctx->soc->GetDeviceType() == DeviceType5::deviceTypeZire72) ctx->soc->RequestPowerOnReset();
+        else ctx->soc->JamKey(keyIdPower, 2000);
         ctx->soc->Reset();
     }
 
