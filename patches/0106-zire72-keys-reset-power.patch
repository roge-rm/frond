     pxaLcdResetPaletteBuffer(lcd);
     if (nand) nandResetPageBuffer(nand);
+    // The Zire keeps its store in RAM, so its reset is the reset pin's GPIO reset; on a
+    // power-on cause its small ROM marks the store invalid. The RTC keeps running either way.
+    if (GetDeviceType() == DeviceType5::deviceTypeZire72) {
+        pxaPwrClkSetResetCause(pwrClk, powerOnReset ? 1 : 8);
+        pxaRtcRestoreRetained(rtc, resetRtc);
+    }
+    powerOnReset = false;
 }
 
