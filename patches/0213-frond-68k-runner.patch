--- /dev/null
+++ b/src/cloudpilot/frond/main.cpp
@@ -0,0 +1,147 @@
+// frond-68k: the runner for DragonBall (68k) devices, built on Cloudpilot's core.
+// This first cut checks a ROM and runs it headless; the window, input and sessions come later.
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <string>
+
+#include "EmCommon.h"
+#include "EmDevice.h"
+#include "EmROMReader.h"
+#include "EmSession.h"
+#include "device_profile5.h"
+
+using namespace std;
+
+namespace {
+
+void usage() {
+    cerr << "usage: frond-68k --rom FILE [--device NAME] [--check-rom] [--run-for SECONDS]" << endl;
+}
+
+bool readFile(const string& path, unique_ptr<uint8[]>& data, size_t& size) {
+    ifstream in(path, ios::binary | ios::ate);
+    if (!in) return false;
+    const auto end = in.tellg();
+    if (end <= 0 || end > (64 << 20)) return false;
+    size = size_t(end);
+    data = make_unique<uint8[]>(size);
+    in.seekg(0);
+    return bool(in.read(reinterpret_cast<char*>(data.get()), size));
+}
+
+// A card header ID as text; headers before version 5 have none.
+string fourCc(uint32_t value) {
+    if (!value) return "none";
+    string text;
+    for (int shift = 24; shift >= 0; shift -= 8) {
+        const char c = char(value >> shift);
+        text += c >= 0x20 && c < 0x7f ? c : '?';
+    }
+    return text;
+}
+
+// The Cloudpilot device ID for a 68k profile.
+const char* cloudpilotDevice(const DeviceProfile5& profile) {
+    return profile.deviceType == deviceTypeIIIx ? "PalmIIIx" : nullptr;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    string romPath, deviceName;
+    bool checkOnly = false;
+    double runFor = 0;
+    for (int i = 1; i < argc; ++i) {
+        const string arg = argv[i];
+        auto value = [&]() -> const char* { return i + 1 < argc ? argv[++i] : nullptr; };
+        if (arg == "--rom") {
+            const char* v = value();
+            if (!v) return usage(), 2;
+            romPath = v;
+        } else if (arg == "--device") {
+            const char* v = value();
+            if (!v) return usage(), 2;
+            deviceName = v;
+        } else if (arg == "--check-rom") {
+            checkOnly = true;
+        } else if (arg == "--run-for") {
+            const char* v = value();
+            char* end = nullptr;
+            runFor = v ? strtod(v, &end) : 0;
+            if (!v || *end || !(runFor > 0 && runFor <= 3600)) return usage(), 2;
+        } else {
+            return usage(), 2;
+        }
+    }
+    if (romPath.empty()) return usage(), 2;
+
+    unique_ptr<uint8[]> rom;
+    size_t romSize = 0;
+    if (!readFile(romPath, rom, romSize)) {
+        cerr << "cannot read ROM " << romPath << endl;
+        return 1;
+    }
+
+    // The quick header check the frontends use, then Cloudpilot's full ROM check.
+    const auto header = deviceProfileInspect68kRom5(romSize, [&](uint64_t at, uint8_t* out, size_t count) {
+        if (at > romSize || count > romSize - at) return false;
+        memcpy(out, rom.get() + at, count);
+        return true;
+    });
+    if (!header.hasHeader) {
+        cerr << "not a 68k Palm ROM" << endl;
+        return 1;
+    }
+    if (!header.profile) {
+        cerr << "unsupported 68k ROM (card header version " << header.headerVersion << ")" << endl;
+        return 1;
+    }
+    const DeviceProfile5* profile = header.profile;
+    if (!deviceName.empty()) {
+        profile = deviceProfileNamed5(deviceName.c_str());
+        if (!profile || !deviceProfileRuns68k5(profile->deviceType)) {
+            cerr << "unknown 68k device " << deviceName << endl;
+            return 1;
+        }
+    }
+
+    EmROMReader reader(rom.get(), romSize);
+    if (!reader.Read()) {
+        cerr << "unreadable ROM" << endl;
+        return 1;
+    }
+    auto device = make_unique<EmDevice>(cloudpilotDevice(*profile));
+    if (!device->Supported() || !device->SupportsROM(reader)) {
+        cerr << profile->name << ": this ROM doesn't run on a " << profile->displayName << endl;
+        return 1;
+    }
+    cout << "device " << profile->name << endl
+         << "card version " << reader.GetCardVersion() << endl
+         << "company " << fourCc(reader.GetCompanyID()) << " hal " << fourCc(reader.GetHalID()) << endl
+         << "rom bytes " << romSize << endl;
+    if (checkOnly) return 0;
+
+    if (!gSession->Initialize(device.release(), rom.release(), romSize)) {
+        cerr << "core failed to start" << endl;
+        return 1;
+    }
+    // Guest time comes from emulated cycles at the clock rate of the moment (the ROM sets the PLL
+    // while it boots), so a headless run takes as long as the host needs.
+    double seconds = 0;
+    while (seconds < runFor) {
+        const uint32_t cycles = gSession->RunEmulation(100000);
+        if (!cycles) {
+            cerr << "the CPU stopped with no wakeup" << endl;
+            return 1;
+        }
+        seconds += double(cycles) / gSession->GetClocksPerSecond();
+    }
+    cout << "ran " << gSession->GetSystemCycles() << " cycles, " << seconds << " guest seconds, now at "
+         << gSession->GetClocksPerSecond() << " clocks per second" << endl;
+    return 0;
+}
