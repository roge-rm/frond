+bool SocPXA::EnableSonyPreview() {
+    if (!StateMutationAllowed() || GetDeviceType() != deviceTypeTG50) return false;
+    if (sonyPreview) return true;
+    // Original TG50 NOR. The immutable source image is separate from the PACE shadow.
+    if (romGetSize(rom) != 13041664 ||
+        md5(static_cast<uint8_t*>(romGetData(rom)), romGetSize(rom)) !=
+            "4fcdb4d5f12c04a4969088a9ed839f41") return false;
+    sonyPreview = AttachSonyTransport();
+    if (!sonyPreview) return false;
+    cpuSetInstructionObserver(cpu, SonyInstruction, this, 0x20b21bd8, 0x20b229e0);
+    ramSetWriteObserver(ram, SonyRamWrite, this);
+    if (ramMirror) ramSetWriteObserver(ramMirror, SonyRamWrite, this);
+    return true;
+}
+
+void SocPXA::SonyRamWrite(void* context, uintptr_t backing, uint32_t size) {
+    auto& self = *static_cast<SocPXA*>(context);
+    if (!self.sonyPreview) return;
+    self.sonyPreview->Ledger().InvalidateSource(backing,size);
