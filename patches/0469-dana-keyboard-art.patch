+        {"address",{351,10,34,34},"address","","cancel",M::none,true},
+        {"todo",{385,10,34,34},"to do","","done",M::none,true},
+        {"memo",{419,10,34,34},"memo","","note",M::none,true},
+        {"find",{453,10,34,34},"find","","contrast",M::none,true},
