+void Imx1Bootstrap::advanceFastBusCycles(uint32_t cycles) {
+    const uint64_t clocks = uint64_t(cycles) * cgm.busDivider() + perclk1Phase;
+    const uint32_t divider = cgm.perclk1Divider();
+    timer1.advance(clocks / divider);
+    perclk1Phase = clocks % divider;
+}
 
