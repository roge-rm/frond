+    if((regs[0x20]&1) && ((hostArmed && (regs[0x2c]&4)) || (regs[0x25]&1))) {
+        const uint64 phase=(remaining+1)*hz;
+        const uint64 needed=phase>fractional ? phase-fractional : 1;
+        EmHAL::WakeAt(now+(needed+11999999)/12000000);
+    }
 }
