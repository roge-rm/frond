diff --git a/src/cloudpilot/emulator/hardware/EmHAL.cpp b/src/cloudpilot/emulator/hardware/EmHAL.cpp
index 47e0e1e..7df3afb 100644
--- a/src/cloudpilot/emulator/hardware/EmHAL.cpp
+++ b/src/cloudpilot/emulator/hardware/EmHAL.cpp
@@ -458,7 +458,14 @@ uint32 EmHAL::CyclesToNextInterrupt(uint64 systemCycles) {
         wakeAt = ~uint64(0);
         return next;
     }
-    return uint32(std::min<uint64>(next, wakeAt - systemCycles));
+    // A skip that reaches the wake uses it up, so a wake asked for after the CPU wakes there
+    // isn't ignored behind a stale earlier one.
+    if (wakeAt - systemCycles <= next) {
+        const uint64 until = wakeAt - systemCycles;
+        wakeAt = ~uint64(0);
+        return uint32(until);
+    }
+    return next;
 }
 
