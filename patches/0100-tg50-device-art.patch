+        case '3': return "0,0 4,0 2,2.6 3,2.6 4,3.6 4,5 3,6 1,6 0,5";
+        case '4': return "3,6 3,0 0,4 4,4";
+        case '5': return "4,0 0,0 0,2.6 3,2.6 4,3.6 4,5 3,6 0,6";
+        case '6': return "3.4,0 1,0 0,1 0,5 1,6 3,6 4,5 4,3.6 3,2.6 0,2.6";
