+        case 'a': return "0.4,2 3,2 3.6,2.6 3.6,6 1,6 0.4,5.4 0.4,4.6 1,4 3.6,4";
+        case 'b': return "0.4,0 0.4,6 3,6 3.6,5.4 3.6,2.6 3,2 0.4,2";
