 };
 inline constexpr DeviceFirmwareVariant5 deviceFirmwareVariants5[] = {
     {deviceTypeE2, "e2-denvfs", 6u << 20, 0x20000, "rePalm", "Dmitry.GR",
-     deviceCompanyPalm5, 0x68737072 /* hspr */, true, ""},
