--- /dev/null
+++ b/src/uarm/uarm/CardSave.h
@@ -0,0 +1,58 @@
+#ifndef FROND_CARD_SAVE_H
+#define FROND_CARD_SAVE_H
+
+#include "FileCardBacking.h"
+#include "SessionIo.h"
+#include "sdcard.h"
+
+#include <algorithm>
+#include <cstring>
+#include <filesystem>
+
+// The SD card's part of a machine-folder save, apart from the SoC.
+namespace frondNative {
+
+// Writes the live card to a sidecar temp from a pinned snapshot. The card's own root does not
+// move: a save that fails, or one to another folder, leaves the live session as it was.
+inline bool publishSd(const std::filesystem::path& folder, frondMachine::Media& media, bool inserted,
+                      std::filesystem::path& temp) {
+    media.kind = frondMachine::kindSd;
+    media.name = frondMachine::sdSibling;
+    media.inserted = inserted;
+    media.writeProtected = false;
+    const uint64_t bytes = uint64_t(sdCardSectorCount()) * SD_SECTOR_SIZE;
+    media.logicalSize = bytes;
+    media.physicalSize = bytes;
+    const char* id = sdCardGetId();
+    media.identity.fill(0);
+    if (id && *id) std::memcpy(media.identity.data(), id, std::min(size_t(32), std::strlen(id)));
+    auto pin = sdCardSnapshot();
+    if (!pin) return false;
+    if (!frondSession::createTemp(folder, ".frondsd.tmp-", temp)) return false;
+    if (!frondSession::writeSdFromReader(
+            temp, bytes, [&](uint64_t off, uint64_t n, void* dest) { return pin->Read(off, n, dest); },
+            media.identity)) {
+        frondSession::removePath(temp);
+        temp.clear();
+        return false;
+    }
+    return true;
+}
+
+// After a published save. A live card file-backed on this folder's sidecar moves onto the new
+// file; otherwise generations left beside the sidecar belong to a card it replaced.
+inline void afterSdPublish(const std::filesystem::path& folder) {
+    const auto sidecar = folder / frondMachine::sdSibling;
+    std::error_code ec;
+    if (!std::filesystem::is_regular_file(sidecar, ec)) return;
+    if (sdCardBackedBy(sidecar.c_str())) {
+        sdCardAdoptSaved(sidecar.c_str(), uint64_t(sdCardSectorCount()) * SD_SECTOR_SIZE,
+                         frondSdFile::headerBytes);
+        return;
+    }
+    FileCardBacking::DiscardGenerations(sidecar);
+}
+
+}  // namespace frondNative
+
+#endif
