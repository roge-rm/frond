+static bool nativeSegment(ArmCpu* cpu, uint32_t address, uint32_t size, bool write, uint32_t& pa) {
+    if (cpu->memorySystemKind != ARM_MEMORY_SYSTEM_MMU) return false;
+#ifdef SUPPORT_FCSE
+    if (address < 0x02000000u) address |= cpu->pid;
