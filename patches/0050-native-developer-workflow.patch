+    return nativeRange(cpu,address,size,true);
+}
+bool cpuNativeBuffer(ArmCpu* cpu, uint32_t address, void* data, uint32_t size, bool write) {
+    if (!size) return true;
+    if (!data || !nativeRange(cpu,address,size,write)) return false;
+    for (uint32_t offset=0; offset<size;) {
+        const uint32_t count=std::min<uint32_t>(0x400-((address+offset)&0x3ff),size-offset);
+        uint32_t pa;
+        if (!nativeSegment(cpu,address+offset,count,write,pa)) return false;
+        for (uint32_t i=0;i<count;++i) {
+            auto* byte=static_cast<uint8_t*>(data)+offset+i;
+            if (write ? !memAccess<1,true>(cpu->mem,pa+i,byte) : !memAccess<1,false>(cpu->mem,pa+i,byte)) return false;
+        }
+        offset+=count;
+    }
+    return true;
+}
