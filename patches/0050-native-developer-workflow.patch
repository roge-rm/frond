+Session::Session(SoC& soc) {
+    require(syscallDispatchRecoveryActive(soc.GetSyscallDispatch()) &&
+            !syscallDispatchInProgress(soc.GetSyscallDispatch()),"native session requires top-level recovery checkpoint");
