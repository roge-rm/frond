--- /dev/null
+++ b/src/uarm/native/InputReplay.h
@@ -0,0 +1,33 @@
+#ifndef FROND_INPUT_REPLAY_H
+#define FROND_INPUT_REPLAY_H
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "keys.h"
+
+class SoC;
+class SdlRenderer;
+
+class InputReplay {
+   public:
+    bool Load(const std::string& path, int width, int height, std::string& error);
+    bool Dispatch(uint64_t elapsedMs, SoC& soc, SdlRenderer& renderer, std::string& error);
+    uint64_t LastEventMs() const { return events.empty() ? 0 : events.back().at; }
+    bool Finished() const { return next == events.size(); }
+
+   private:
+    enum class Kind { penDown, penUp, keyDown, keyUp, snapshot };
+    struct Event {
+        uint64_t at;
+        Kind kind;
+        int x{0}, y{0};
+        KeyId key{keyInvalid};
+        std::string path;
+    };
+    std::vector<Event> events;
+    size_t next{0};
+};
+
+#endif
