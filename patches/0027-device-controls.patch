+#include "DeviceControls.h"
+#include <cmath>
+
+void drawDeviceControls(SDL_Renderer* renderer, const DeviceControlProfile& profile,
+                        int width, int height, int scale, uint32_t pressed) {
+    if(!profile.count)return;
+    auto fill=[&](int x,int y,int w,int h) {SDL_Rect r{x*scale,y*scale,w*scale,h*scale};SDL_RenderFillRect(renderer,&r);};
+    auto line=[&](int x,int y,int xx,int yy) {
+        // Give the vector icons a consistent weight at either display scale.
+        for(int i=0;i<scale;++i)SDL_RenderDrawLine(renderer,x*scale,y*scale+i,xx*scale,yy*scale+i);
+    };
+    auto circle=[&](int x,int y,int radius) {
+        for(int d=0;d<360;d+=6) {
+            double a=d*3.141592653589793/180,b=(d+6)*3.141592653589793/180;
+            line(x+std::lround(radius*std::cos(a)),y+std::lround(radius*std::sin(a)),
+                 x+std::lround(radius*std::cos(b)),y+std::lround(radius*std::sin(b)));
+        }
+    };
+    auto shade=[&](SDL_Color c) {SDL_SetRenderDrawColor(renderer,c.r,c.g,c.b,255);};
+    auto blend=[](SDL_Color a,SDL_Color b,int step,int total) {
+        return SDL_Color{Uint8(a.r+(int(b.r)-a.r)*step/total),
+                         Uint8(a.g+(int(b.g)-a.g)*step/total),
+                         Uint8(a.b+(int(b.b)-a.b)*step/total),255};
+    };
+    auto rounded=[&](SDL_Rect r,int radius,SDL_Color top,SDL_Color bottom) {
+        for(int row=0;row<r.h;++row) {
+            int dy=row<radius ? radius-row-1 : row>=r.h-radius ? row-(r.h-radius) : 0;
+            int inset=dy ? radius-int(std::sqrt(radius*radius-dy*dy)) : 0;
+            shade(blend(top,bottom,row,r.h));fill(r.x+inset,r.y+row,r.w-2*inset,1);
+        }
+    };
+    auto disc=[&](int x,int y,int radius,SDL_Color top,SDL_Color bottom) {
+        for(int dy=-radius;dy<=radius;++dy) {
+            int half=int(std::sqrt(radius*radius-dy*dy));
+            shade(blend(top,bottom,dy+radius,2*radius));fill(x-half,y+dy,half*2+1,1);
+        }
+    };
+    const SDL_Color ink{16,25,37,255},silver{165,183,199,255};
+    // Original vector artwork: a brushed bezel, inset app keys and a five-way ring.
+    for(int y=0;y<profile.height;++y) {
+        shade(blend({55,72,91,255},{29,42,59,255},y,profile.height));fill(0,height+y,width,1);
+    }
+    shade(silver);fill(0,height,width,1);
+    shade(ink);fill(0,height+profile.height-1,width,1);
+    if(profile.navigatorRadius) {
+        const int x=(width-profile.width)/2+profile.navigator.x,y=height+profile.navigator.y;
+        const int radius=profile.navigatorRadius;
+        disc(x,y+2,radius,ink,ink);
+        disc(x,y,radius,silver,{68,84,102,255});
+        disc(x,y,radius-2,{111,131,151,255},{48,65,84,255});
+        // Each visible ring quadrant has the same radial hit region as the input path.
+        for(int dy=-radius+3;dy<=radius-3;++dy) {
+            const int half=int(std::sqrt((radius-3)*(radius-3)-dy*dy));
+            int begin=-half;
+            while(begin<=half) {
+                const auto key=deviceControlAt(profile,width,height,x+begin,y+dy);
+                int end=begin+1;
+                while(end<=half && deviceControlAt(profile,width,height,x+end,y+dy)==key)++end;
+                if(key!=keyIdSelect && (pressed&(1u<<key))) {
+                    shade(blend({89,176,214,255},{34,104,150,255},dy+radius,2*radius));
+                    fill(x+begin,y+dy,end-begin,1);
+                }
+                begin=end;
+            }
+        }
+        disc(x,y,16,ink,ink);
+        const bool down=pressed&(1u<<keyIdSelect);
+        disc(x,y+(down?1:0),14,down?SDL_Color{103,195,227,255}:silver,
+             down?SDL_Color{34,109,155,255}:SDL_Color{67,87,109,255});
+    }
+    for(size_t i=0;i<profile.count;++i) {
+        const auto& button=profile.buttons[i];auto r=deviceButtonRect(profile,button,width,height);
+        const bool down=pressed&(1u<<button.key);
+        const bool navigator=profile.navigatorRadius && button.icon>=DeviceControlIcon::up &&
+                             button.icon<=DeviceControlIcon::select;
+        if(!navigator) {
+            auto shadow=r;shadow.y+=2;rounded(shadow,9,ink,ink);
+            rounded(r,9,silver,{52,70,89,255});
+            SDL_Rect face{r.x+2,r.y+2,r.w-4,r.h-4};
+            rounded(face,7,down?SDL_Color{90,176,213,255}:SDL_Color{114,135,157,255},
+                    down?SDL_Color{34,105,150,255}:SDL_Color{57,76,98,255});
+        }
+        SDL_SetRenderDrawColor(renderer,238,245,250,255);
+        const int x=r.x+r.w/2,y=r.y+r.h/2+(down?1:0);
+        switch(button.icon) {
+            case DeviceControlIcon::home: // Home
+                line(x-10,y,x,y-9);line(x,y-9,x+10,y);line(x-7,y-2,x-7,y+9);
+                line(x+7,y-2,x+7,y+9);line(x-7,y+9,x+7,y+9);line(x,y+9,x,y+3);break;
+            case DeviceControlIcon::calendar: // Calendar
+                line(x-9,y-8,x+9,y-8);line(x-9,y-8,x-9,y+9);line(x+9,y-8,x+9,y+9);
+                line(x-9,y+9,x+9,y+9);line(x-9,y-3,x+9,y-3);
+                line(x-5,y-11,x-5,y-6);line(x+5,y-11,x+5,y-6);
