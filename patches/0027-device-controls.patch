+#ifndef FROND_DEVICE_CONTROLS_H
+#define FROND_DEVICE_CONTROLS_H
+#include <SDL.h>
+#include <array>
+#include <cstdlib>
+#include "device_type5.h"
+#include "keys.h"
+
+enum class DeviceControlIcon { home, calendar, contacts, web, up, down, left, right, select, power };
+struct DeviceButton {
+    KeyId key;
+    SDL_Rect bounds;
+    const char* label;
+    DeviceControlIcon icon;
+};
+struct DeviceControlProfile {
+    int width, height;
+    const DeviceButton* buttons;
+    size_t count;
+    SDL_Point navigator;
+    int navigatorRadius;
+};
+inline const DeviceControlProfile& deviceControls(DeviceType5 device) {
+    static const DeviceButton tx[] = {
+        {keyIdHard1, {8,30,44,40}, "Home", DeviceControlIcon::home},
+        {keyIdHard2, {58,30,44,40}, "Calendar", DeviceControlIcon::calendar},
+        {keyIdHard3, {218,30,44,40}, "Contacts", DeviceControlIcon::contacts},
+        {keyIdHard4, {268,30,44,40}, "Web", DeviceControlIcon::web},
+        {keyIdUp, {148,10,24,20}, "Up", DeviceControlIcon::up},
+        {keyIdDown, {148,58,24,20}, "Down", DeviceControlIcon::down},
+        {keyIdLeft, {124,32,22,24}, "Left", DeviceControlIcon::left},
+        {keyIdRight, {174,32,22,24}, "Right", DeviceControlIcon::right},
+        {keyIdSelect, {148,32,24,24}, "Select", DeviceControlIcon::select},
+    };
+    static const DeviceControlProfile txProfile{320,84,tx,std::size(tx),{160,44},38};
+    static const DeviceControlProfile empty{0,0,nullptr,0,{0,0},0};
+    return device == deviceTypeTX ? txProfile : empty;
+}
+inline SDL_Rect deviceButtonRect(const DeviceControlProfile& profile,
+                                const DeviceButton& button, int screenWidth, int screenHeight) {
+    auto r=button.bounds; r.x+=(screenWidth-profile.width)/2; r.y+=screenHeight; return r;
+}
+inline KeyId deviceControlAt(const DeviceControlProfile& profile, int screenWidth,
+                             int screenHeight, int x, int y) {
+    if(profile.navigatorRadius) {
+        const int dx=x-(screenWidth-profile.width)/2-profile.navigator.x;
+        const int dy=y-screenHeight-profile.navigator.y;
+        const int distance=dx*dx+dy*dy;
+        if(distance<=profile.navigatorRadius*profile.navigatorRadius) {
+            if(distance<=14*14)return keyIdSelect;
+            if(std::abs(dx)>std::abs(dy))return dx<0 ? keyIdLeft : keyIdRight;
+            return dy<0 ? keyIdUp : keyIdDown;
+        }
+    }
+    for(size_t i=0;i<profile.count;++i) {
+        if(profile.navigatorRadius && profile.buttons[i].icon>=DeviceControlIcon::up &&
+           profile.buttons[i].icon<=DeviceControlIcon::select)continue;
+        const auto r=deviceButtonRect(profile,profile.buttons[i],screenWidth,screenHeight);
+        if(x>=r.x && x<r.x+r.w && y>=r.y && y<r.y+r.h)return profile.buttons[i].key;
+    }
+    return keyInvalid;
+}
+void drawDeviceControls(SDL_Renderer* renderer, const DeviceControlProfile& profile,
+                        int screenWidth, int screenHeight, int scale, uint32_t pressed);
+#endif
