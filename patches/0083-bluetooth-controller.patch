diff --git a/src/uarm/uarm/BluetoothBackend.h b/src/uarm/uarm/BluetoothBackend.h
new file mode 100644
--- /dev/null
+++ b/src/uarm/uarm/BluetoothBackend.h
@@ -0,0 +1,33 @@
+#ifndef FROND_BLUETOOTH_BACKEND_H
+#define FROND_BLUETOOTH_BACKEND_H
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// User-selected H4 controller endpoint. It owns live host I/O only; no descriptor,
+// partial host packet or peer generation is portable guest state. Emulator thread.
+class BluetoothBackend {
+ public:
+    static constexpr size_t maxFrame=65540, capacity=1024*1024;
+    BluetoothBackend()=default;
+    ~BluetoothBackend(){Close();}
+    BluetoothBackend(const BluetoothBackend&)=delete;
+    BluetoothBackend& operator=(const BluetoothBackend&)=delete;
+    bool Open(const std::string& path,std::string& error);
+    void Close();
+    bool Connected() const {return fd>=0;}
+    bool Write(const uint8_t* data,size_t size);
+    void Poll();
+    uint16_t Read(); // 0x100 means no byte, same as UART_CHAR_NONE.
+    bool FrameInProgress() const {return frameRemaining!=0;}
+    size_t Pending() const {return received.size()-readAt;}
+    size_t Queued() const {return outgoing.size()-sentAt;}
+ private:
+    int fd{-1};
+    std::vector<uint8_t> incoming,outgoing,received;
+    size_t expected{},sentAt{},readAt{},frameRemaining{};
+    bool Consume(const uint8_t* bytes,size_t size);
+};
+#endif
diff --git a/src/uarm/uarm/BluetoothBackend.cpp b/src/uarm/uarm/BluetoothBackend.cpp
new file mode 100644
--- /dev/null
+++ b/src/uarm/uarm/BluetoothBackend.cpp
@@ -0,0 +1,93 @@
+#include "BluetoothBackend.h"
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#ifndef __EMSCRIPTEN__
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#endif
+
+bool BluetoothBackend::Open(const std::string& path,std::string& error) {
+#ifdef __EMSCRIPTEN__
+    error="Bluetooth controller endpoints require the native runner.";return false;
+#else
+    if(path.empty() || path[0]!='/' || path.find('\0')!=std::string::npos || path.size()>=sizeof(sockaddr_un::sun_path)) {
+        error="Choose an absolute Unix socket path shorter than 108 bytes.";return false;
+    }
+    const int candidate=socket(AF_UNIX,SOCK_STREAM|SOCK_CLOEXEC,0);
+    if(candidate<0){error=std::strerror(errno);return false;}
+    sockaddr_un address{};address.sun_family=AF_UNIX;
+    std::memcpy(address.sun_path,path.c_str(),path.size()+1);
+    // A local Unix connect has no network route/timeout. Set nonblocking before
+    // connection so a full listener queue cannot stall the emulation thread.
+    if(fcntl(candidate,F_SETFL,O_NONBLOCK)<0 || connect(candidate,reinterpret_cast<sockaddr*>(&address),sizeof(address))<0) {
+        error=std::strerror(errno);close(candidate);return false;
+    }
+    Close();fd=candidate;error.clear();return true;
+#endif
+}
+void BluetoothBackend::Close() {
+#ifndef __EMSCRIPTEN__
+    if(fd>=0)close(fd);
+#endif
+    fd=-1;incoming.clear();outgoing.clear();received.clear();expected=sentAt=readAt=frameRemaining=0;
+}
+bool BluetoothBackend::Write(const uint8_t* bytes,size_t size) {
+    if(!Connected() || !bytes || !size || size>maxFrame || size>capacity-Queued()) {Close();return false;}
+    if(sentAt){outgoing.erase(outgoing.begin(),outgoing.begin()+sentAt);sentAt=0;}
+    outgoing.insert(outgoing.end(),bytes,bytes+size);return true;
+}
+bool BluetoothBackend::Consume(const uint8_t* bytes,size_t size) {
+    for(size_t i=0;i<size;++i) {
+        if(incoming.size()==maxFrame)return false;
+        incoming.push_back(bytes[i]);
+        if(incoming.size()==1 && incoming[0]!=2 && incoming[0]!=3 && incoming[0]!=4)return false;
+        if(incoming[0]==4 && incoming.size()==3)expected=3+incoming[2];
+        else if(incoming[0]==2 && incoming.size()==5)expected=5+incoming[3]+(size_t(incoming[4])<<8);
+        else if(incoming[0]==3 && incoming.size()==4)expected=4+incoming[3];
+        if(expected>maxFrame)return false;
+        if(expected && incoming.size()==expected) {
+            if(expected>capacity-Pending())return false;
+            if(readAt){received.erase(received.begin(),received.begin()+readAt);readAt=0;}
+            received.insert(received.end(),incoming.begin(),incoming.end());
+            incoming.clear();expected=0;
+        }
+    }
+    return true;
+}
+void BluetoothBackend::Poll() {
+#ifndef __EMSCRIPTEN__
+    if(!Connected())return;
+    // Bounded work per guest callback. A short write keeps its exact suffix.
+    for(unsigned tries=0;tries<4 && Queued();++tries) {
+        const auto n=send(fd,outgoing.data()+sentAt,Queued(),MSG_DONTWAIT|MSG_NOSIGNAL);
+        if(n<0 && errno==EINTR)continue;
+        if(n<0 && (errno==EAGAIN || errno==EWOULDBLOCK))break;
+        if(n<=0){Close();return;}
+        sentAt+=size_t(n);
+    }
+    if(sentAt==outgoing.size()){outgoing.clear();sentAt=0;}
+    std::array<uint8_t,4096> bytes;
+    for(unsigned tries=0;tries<4;++tries) {
+        const auto n=recv(fd,bytes.data(),bytes.size(),MSG_DONTWAIT);
+        if(n<0 && errno==EINTR)continue;
+        if(n<0 && (errno==EAGAIN || errno==EWOULDBLOCK))break;
+        if(n<=0 || !Consume(bytes.data(),size_t(n))){Close();return;}
+    }
+#endif
+}
+uint16_t BluetoothBackend::Read() {
+    if(!Pending())return 0x100;
+    if(!frameRemaining){
+        // Consume exposes complete validated frames only. Retain this frame's
+        // ownership across byte callbacks and receive-buffer compaction.
+        const auto* p=received.data()+readAt;
+        frameRemaining=p[0]==4?3+p[2]:p[0]==2?5+p[3]+(size_t(p[4])<<8):4+p[3];
+    }
+    --frameRemaining;
+    const auto c=received[readAt++];
+    if(readAt==received.size()){received.clear();readAt=0;}
+    return c;
+}
diff --git a/src/uarm/uarm/BluetoothBootstrap.h b/src/uarm/uarm/BluetoothBootstrap.h
new file mode 100644
--- /dev/null
+++ b/src/uarm/uarm/BluetoothBootstrap.h
@@ -0,0 +1,125 @@
+#ifndef FROND_BLUETOOTH_BOOTSTRAP_H
+#define FROND_BLUETOOTH_BOOTSTRAP_H
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+
+// The Palm drivers upload their own unchanged image over the UART, then use
+// ordinary H4. This models that wire contract, not execution of the 8051 image.
+class BluetoothBootstrap {
+ public:
+    static constexpr uint32_t maxFrame=65540;
+    using HciSink=std::function<bool(const uint8_t*,size_t)>;
+    enum Stage : uint32_t { hciBeforeUpload, replyDelay, bootAckDelay, mini, patch, bootReadyDelay, hci, failed };
+    explicit BluetoothBootstrap(bool e2=true):e2(e2){}
+    void Reset() {stage=hciBeforeUpload;rxCount=wanted=head=count=0;due=0;rx={};out={};}
+    bool Failed() const {return stage==failed;}
+    bool InHci() const {return stage==hci || stage==hciBeforeUpload;}
+    bool Ready() const {return stage==hci;}
+    bool Respond(const uint8_t* bytes,size_t size){return Emit(bytes,size);}
+    bool Pending() const {return count || stage==replyDelay || stage==bootAckDelay || stage==bootReadyDelay;}
+    Stage State() const {return Stage(stage);}
+    void Tick(uint64_t now) {
+        if(count || now<due)return;
+        if(stage==replyDelay){const uint8_t v[]={4,14,4,1,0x2e,0xfc,0};Emit(v,sizeof(v));stage=bootAckDelay;due=0;}
+        else if(stage==bootAckDelay && due){const uint8_t v[]={'4','1'};Emit(v,sizeof(v));stage=mini;due=0;}
+        else if(stage==bootReadyDelay){
+            // E2 explicitly consumes four bytes before HCI init; their contents
+            // are ignored. Use a valid vendor event for this virtual controller.
+            const uint8_t v[]={4,0xff,1,0};Emit(v,sizeof(v));stage=hci;due=0;
+        }
+    }
+    uint16_t Read(uint64_t now) {
+        Tick(now);if(!count)return 0x100;
+        const auto c=out[head];out[head]=0;head=(head+1)%out.size();--count;
+        if(!count && stage==bootAckDelay)due=now+150000000;
+        return c;
+    }
+    bool Write(uint8_t c,uint64_t now,const HciSink& sink) {
+        if(Failed())return false;
+        if(stage==replyDelay || stage==bootAckDelay || stage==bootReadyDelay)return Reject();
+        if(stage==patch && !rxCount && c=='Z') {
+            if(e2){stage=bootReadyDelay;due=now+100000000;}else stage=hci;
+            return true;
+        }
+        if(!rxCount) {
+            if(stage==mini && c!=':')return Reject();
+            if(stage==patch && c!='@')return Reject();
+            if(InHci() && c!=1 && c!=2 && c!=3)return Reject();
+        }
+        if(rxCount==rx.size())return Reject();
+        rx[rxCount++]=c;
+        if(InHci()) {
+            if(rx[0]==1 && rxCount==4)wanted=4+rx[3];
+            else if(rx[0]==2 && rxCount==5)wanted=5+rx[3]+(uint32_t(rx[4])<<8);
+            else if(rx[0]==3 && rxCount==4)wanted=4+rx[3];
+            if(wanted>rx.size())return Reject();
+            if(wanted && rxCount==wanted) {
+                if(rx[0]==1 && wanted==4 && rx[1]==0x2e && rx[2]==0xfc) {
+                    stage=replyDelay;due=now+10000000;
+                } else if(!sink || !sink(rx.data(),rxCount))return Reject();
+                ClearRx();
+            }
+            return true;
+        }
+        const auto digits=stage==mini?2u:4u;
+        if(rxCount==digits+1) {
+            uint32_t n=0;
+            for(unsigned i=1;i<=digits;++i){const int d=Hex(rx[i]);if(d<0)return Reject();n=n*16+unsigned(d);}
+            wanted=2*n+11;
+            if(wanted>rx.size())return Reject();
+        }
+        if(wanted && rxCount==wanted) {
+            unsigned sum=0;
+            for(unsigned i=1;i+1<rxCount;i+=2) {
+                const int hi=Hex(rx[i]),lo=Hex(rx[i+1]);if(hi<0 || lo<0)return Reject();
+                sum+=16*hi+lo;
+            }
+            const bool valid=!(sum&255);
+            if(stage==mini) {
+                const uint8_t ack=valid?'1':'0';if(!Emit(&ack,1))return false;
+                if(valid && wanted==11 && !std::memcmp(rx.data(),":00000001FF",11))stage=patch;
+            } else {
+                const uint8_t ack[]={'0','0',uint8_t(valid?'1':'0')};if(!Emit(ack,sizeof(ack)))return false;
+            }
+            ClearRx();
+        }
+        return true;
+    }
+    template<class H> void Transfer(H& h) {
+        h.Do32(stage).Do32(rxCount).Do32(wanted).Do32(head).Do32(count).Do64(due)
+            .DoBuffer(rx.data(),rx.size()).DoBuffer(out.data(),out.size());
+    }
+    bool Valid() const {
+        if(stage>failed || rxCount>rx.size() || wanted>rx.size() || head>=out.size() || count>out.size())return false;
+        if(!rxCount)return !wanted;
+        uint32_t header=0,expected=0;
+        if(InHci()){
+            if(rx[0]!=1 && rx[0]!=2 && rx[0]!=3)return false;
+            header=rx[0]==2?5:4;
+            if(rxCount>=header)expected=header+(rx[0]==2?uint32_t(rx[3])+(uint32_t(rx[4])<<8):rx[3]);
+        }else if(stage==mini || stage==patch){
+            if(rx[0]!=(stage==mini?':':'@'))return false;
+            header=stage==mini?3:5;
+            if(rxCount>=header){
+                uint32_t length=0;for(uint32_t i=1;i<header;++i){const auto digit=Hex(rx[i]);if(digit<0)return false;length=16*length+uint32_t(digit);}
+                expected=2*length+11;
+            }
+        }else return false;
+        // A completed frame is consumed synchronously by Write; only a partial
+        // header/frame can be present at a serialization boundary.
+        return rxCount<header?!wanted:expected<=rx.size() && wanted==expected && rxCount<expected;
+    }
+ private:
+    bool e2;
+    uint32_t stage{hciBeforeUpload},rxCount{},wanted{},head{},count{};
+    uint64_t due{};
+    std::array<uint8_t,maxFrame> rx{};
+    std::array<uint8_t,64> out{};
+    static int Hex(uint8_t c){if(c>='0' && c<='9')return c-'0';if(c>='A' && c<='F')return c-'A'+10;return -1;}
+    void ClearRx(){rx={};rxCount=wanted=0;}
+    bool Reject(){stage=failed;ClearRx();out={};head=count=0;return false;}
+    bool Emit(const uint8_t* v,size_t n){if(n>out.size()-count)return Reject();for(size_t i=0;i<n;++i)out[(head+count++)%out.size()]=v[i];return true;}
+};
+#endif
diff --git a/src/uarm/uarm/BluetoothUartMessaging.h b/src/uarm/uarm/BluetoothUartMessaging.h
new file mode 100644
--- /dev/null
+++ b/src/uarm/uarm/BluetoothUartMessaging.h
@@ -0,0 +1,64 @@
+#ifndef FROND_BLUETOOTH_UART_MESSAGING_H
+#define FROND_BLUETOOTH_UART_MESSAGING_H
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// Legacy TX controller transport, inferred from the original driver's FC27/29
+// producer and EF-event consumer. This models UART availability, not electrical
+// wake polarity, radio execution or physical idle/power timing. The extra mode-
+// activation EF04 is a virtual-controller notification; its physical BCM2035
+// bytes were not captured (the original driver only counts those four bytes).
+class BluetoothUartMessaging {
+ public:
+    enum class Result { unhandled, handled, failed };
+    void Reset(){state=0;parameters={};}
+    bool CanReadController()const{return state==0 || state==1;}
+    template<class Send> Result Command(const uint8_t* b,size_t n,Send send){
+        if(n==4 && b[0]==1 && b[1]==3 && b[2]==12){Reset();return Result::unhandled;}
+        if(n<4 || b[0]!=1 || b[2]!=0xfc || (b[1]!=0x27 && b[1]!=0x28 && b[1]!=0x29))return Result::unhandled;
+        auto complete=[&](uint8_t status){const uint8_t r[]={4,14,4,1,b[1],0xfc,status};return send(r,sizeof(r));};
+        auto done=[](bool ok){return ok?Result::handled:Result::failed;};
+        if(b[1]==0x27){
+            if(n!=14 || b[3]!=10)return done(complete(0x12));
+            if(b[4]!=0 && b[4]!=2)return done(complete(0x11));
+            for(size_t i=7;i<13;++i)if(b[i]>1)return done(complete(0x12));
+            if(b[4]==0 && b[10])return done(complete(0x12));
+            std::copy(b+4,b+14,parameters.begin());state=b[4]==2?1:0;
+            if(!complete(0))return Result::failed;
+            return done(state==0 || Event(4,send));
+        }
+        if(b[1]==0x28){
+            if(n!=4 || b[3])return done(complete(0x12));
+            std::array<uint8_t,17> r{4,14,14,1,0x28,0xfc,0};
+            std::copy(parameters.begin(),parameters.end(),r.begin()+7);
+            return done(send(r.data(),r.size()));
+        }
+        if(n!=5 || b[3]!=1)return done(complete(0x12));
+        if(!state)return done(complete(0x0c));
+        switch(b[4]){
+            case 1: state=1;return done(Event(4,send)); // Host wake request -> wake acknowledgment.
+            case 2: if(state==3)state=1;return Result::handled; // Host acknowledges controller wake.
+            case 3: state=2;return done(Event(6,send)); // Host sleep request -> sleep acknowledgment.
+            case 4: return Result::handled; // No autonomous sleep request is outstanding.
+            default:return done(complete(0x12));
+        }
+    }
+    template<class Send>bool PendingControllerInput(bool pending,Send send){
+        if(state!=2 || !pending)return true;
+        if(!Event(3,send))return false;
+        state=3;return true;
+    }
+    template<class T>void Transfer(T& h){h.Do32(state).DoBuffer(parameters.data(),parameters.size());}
+    bool Valid()const{
+        if(state>3 || parameters[0]!=(state?2:0))return false;
+        for(size_t i=3;i<9;++i)if(parameters[i]>1)return false;
+        return parameters[0]!=0 || !parameters[6];
+    }
+ private:
+    uint32_t state{}; // 0 disabled, 1 awake, 2 asleep, 3 controller wake awaiting host acknowledgment.
+    std::array<uint8_t,10>parameters{};
+    template<class Send>static bool Event(uint8_t token,Send send){const uint8_t r[]={4,0xef,1,token};return send(r,sizeof(r));}
+};
+#endif
