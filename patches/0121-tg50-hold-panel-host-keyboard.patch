+        case SDL_SCANCODE_P: return tg50Key(3,5);
+        case SDL_SCANCODE_A: return tg50Key(4,1);
+        case SDL_SCANCODE_S: return tg50Key(4,2);
+        case SDL_SCANCODE_D: return tg50Key(4,3);
