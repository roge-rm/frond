--- a/src/uarm/uarm/jit_dynarmic.cpp
+++ b/src/uarm/uarm/jit_dynarmic.cpp
@@ -61,7 +61,9 @@
 
 constexpr HaltReason kInterpret = HaltReason::UserDefined2;
 constexpr HaltReason kSlowPath = HaltReason::UserDefined3;
-constexpr HaltReason kFault = HaltReason::UserDefined4;
+// A data access that faults ends the run on that instruction (check_halt_on_memory_access),
+// and the interpreter runs it again to take the abort.
+constexpr HaltReason kFault = HaltReason::MemoryAbort;
 
 struct Env final : public A32::UserCallbacks {
     ArmCpu *cpu = nullptr;
@@ -231,6 +233,7 @@
     conf.page_table = &j->pages;
     conf.page_table_writes_via_callbacks = true;
     conf.check_halt_on_link = true;
+    conf.check_halt_on_memory_access = true;
     // Unaligned accesses go through the callbacks, which fault on them.
     conf.detect_misaligned_access_via_page_table = 16 | 32 | 64;
     conf.only_detect_misalignment_via_page_table_on_page_boundary = false;
@@ -276,9 +279,7 @@
     if (Has(hr, kFault)) stats.fault++;
     if (Has(hr, kInterpret)) stats.interpret++;
     if (Has(hr, kSlowPath)) stats.halt++;
-    if (Has(hr, kFault))
-        stop = FROND_JIT_FAULT;
-    else if (Has(hr, kInterpret))
+    if (Has(hr, kFault) || Has(hr, kInterpret))
         stop = FROND_JIT_INTERPRET;
     else if (Has(hr, kSlowPath))
         stop = FROND_JIT_HALT;
--- a/src/uarm/uarm/jit_dynarmic.h
+++ b/src/uarm/uarm/jit_dynarmic.h
@@ -11,7 +11,8 @@
 
 enum FrondJitStop {
     FROND_JIT_BUDGET,     // ran out of cycles
-    FROND_JIT_INTERPRET,  // regs[15] is an instruction the interpreter has to run
+    FROND_JIT_INTERPRET,  // regs[15] is an instruction the interpreter has to run, or one
+                          // whose data access faulted
     FROND_JIT_HALT,       // a callback set the slow path
     FROND_JIT_FAULT,      // a data access faulted; the guest state is not exact
 };
