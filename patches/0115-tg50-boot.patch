+template void tg50ucSave<SavestateProbe<ChunkType>>(TG50uc*, SavestateProbe<ChunkType>&);
+template bool tg50ucLoad<SavestateLoader<ChunkType>>(TG50uc*, SavestateLoader<ChunkType>&, bool);
