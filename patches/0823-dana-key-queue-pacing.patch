+// True when the queue head presses a key while Palm OS's key queue is nearly full. The ROM puts
+// each press in that queue as the report comes, so keys faster than the app takes them would be
+// dropped there; they wait in the FIFO and backlog instead, with no request raised so the app
+// gets to run. Host input only.
+bool EmRegsVZDana::KeyQueueBlocked() const {
+    if(!hostPaced || !queueCount) return false;
+    bool press=false;
+    for(auto code:packets[queueHead]) {
+        if(!code) break;
+        if(std::find(presentedScan,presentedScan+8,code)==presentedScan+8) { press=true; break; }
+    }
+    if(!press) return false;
+    // The ROM puts 7 bytes in per key; leave room for two.
+    return KeyQueueRoom()<=kKeyQueueReserve;
+}
+uint32 EmRegsVZDana::KeyQueueRoom() const {
+    CEnableFullAccess munge;
+    // SysEvtMgrGlobalsType.keyQP, then KeyQueueType's start, end and size in bytes.
+    emuptr globals=EmLowMem_GetGlobal(sysEvtMgrGlobalsP);
+    if(!globals || (globals&1)) return ~0u;
+    emuptr queue=EmMemGet32(globals+10);
+    if(!queue || (queue&1)) return ~0u;
+    uint32 start=EmMemGet16(queue),end=EmMemGet16(queue+2),size=EmMemGet16(queue+4);
+    if(size<8 || size>0x4000 || start>=size || end>=size) return ~0u;
+    return size-(end>=start ? end-start : size-start+end);
+}
