+
+void EmRegsVZDana::Save(Savestate<ChunkType>& s) { SaveState(s); }
+void EmRegsVZDana::Save(SavestateProbe<ChunkType>& s) { SaveState(s); }
+template <typename T> void EmRegsVZDana::SaveState(T& s) {
+    EmRegsVZ::Save(s);
+    adc.Save(s);
+    auto* c=s.GetChunk(ChunkType::regsVZDana); if(!c) return;
+    c->Put32(4); SaveChunkHelper h(*c); StateFields(h);
+}
+void EmRegsVZDana::Load(SavestateLoader<ChunkType>& l) {
+    EmRegsVZ::Load(l);
+    adc.Load(l);
+    auto* c=l.GetChunk(ChunkType::regsVZDana);
+    if(!c || c->Get32()!=4) { l.NotifyError(); return; }
+    LoadChunkHelper h(*c); StateFields(h);
+    if(heldKeys>3 || packetKeys>3 || packetIndex>2 || (packetIndex==2 && packetKeys!=3) || versionCommand > 8 || versionReply > 3 || (versionCommand != 8 && versionReply != 0)) l.NotifyError();
+}
+
+void EmRegsVZDana::Reset(Bool hardware) {
+    EmRegsVZ::Reset(hardware);
+    if(!hardware) return;
+    resetReply=true; resetAsserted=false; versionCommand=versionReply=0;
+    heldKeys=packetKeys=0; packetIndex=0; keysDirty=false; irqPinHigh=true; irqLatched=false; UpdateStIrq();
+    adc=EmSPISlaveADS784x(kChannelSet2);
+}
+
+void EmRegsVZDana::DispatchButtonEvent(ButtonEvent e) {
+    uint8 mask;
+    switch(e.GetButton()) {
+        case ButtonEvent::Button::power: mask=1; break;
+        case ButtonEvent::Button::rockerUp: mask=2; break;
+        default: throw std::runtime_error("Dana key is not qualified");
+    }
+    uint8 next=e.GetType()==ButtonEvent::Type::press ? heldKeys|mask : heldKeys&~mask;
+    if(next!=heldKeys) { heldKeys=next; keysDirty=true; UpdateStIrq(); }
+}
+uint8 EmRegsVZDana::ReadKeyPacket() {
+    if(packetIndex) {
+        uint8 code=(packetKeys&1) && packetIndex==1 ? 0x0f : 0x70;
+        unsigned count=((packetKeys&1)!=0)+((packetKeys&2)!=0);
+        if(++packetIndex>count)packetIndex=0;
+        UpdateStIrq(); return code;
+    }
+    if(!keysDirty)return 0;
+    packetKeys=heldKeys; keysDirty=false;
+    unsigned count=((packetKeys&1)!=0)+((packetKeys&2)!=0);
+    if(count)packetIndex=1;
+    UpdateStIrq(); return 0x40|count;
+}
+
+void EmRegsVZDana::UpdateStIrq() {
+    bool high=resetAsserted || !(keysDirty || packetIndex);
+    uint16 control=StdRead(0xfffff302,2);
+    bool positive=(control&0x8000)!=0;
+    if(control&0x0800) {
+        if(high!=irqPinHigh && high==positive) irqLatched=true;
+    } else irqLatched=high==positive;
+    irqPinHigh=high;
+    uint16 pending=StdRead(0xfffff310,2);
+    StdWrite(0xfffff310,2,(pending&~1)|(irqLatched?1:0));
+    UpdateInterrupts();
+}
+void EmRegsVZDana::StIntControlWrite(emuptr a,int size,uint32 value) {
+    StdWrite(a,size,value); UpdateStIrq();
+}
+void EmRegsVZDana::StIntStatusWrite(emuptr a,int size,uint32 value) {
+    uint32 clear=size==4 ? value>>16 : value;
+    if(size==1 && a==0xfffff30c)clear=0;
+    if((StdRead(0xfffff302,2)&0x0800) && (clear&1))irqLatched=false;
+    intStatusHiWrite(a,size,value); UpdateStIrq();
+}
