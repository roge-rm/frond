--- /dev/null
+++ b/src/common/UsbPrism2Adapter.h
@@ -0,0 +1,459 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <map>
+#include <vector>
+
+// Synthetic Microsoft MN-510 (Prism 2.5, HFA384x over USB) full-speed leaf for the Dana's
+// external USB port. One open network "Frond" on channel 6. Owner and packet callback share
+// one thread. The owner calls busReset() on a bus or machine reset and detach() on unplug.
+//
+// Host side limits: the Dana's bus driver moves 512 bytes per ATL pass, so a 1568 byte frame
+// takes four passes. receive() refuses a frame when 32 are queued and the caller drops it.
+// The guest waits 100 ticks for a reply and 10000 frames for a read, so the owner should
+// call receive() from its own clock and not hold frames back for long.
+class UsbPrism2Adapter {
+ public:
+    using Mac = std::array<uint8_t, 6>;
+    using TxSink = std::function<void(const std::vector<uint8_t>&)>;
+
+    UsbPrism2Adapter() { resetConfig(); }
+    void setMac(const Mac& m) { mac = m; }
+    // Gets each Ethernet II frame (no FCS) the guest sends. Must not call packet().
+    void setTxSink(TxSink s) { txSink = std::move(s); }
+
+    // Ethernet II frame (14 to 1514 bytes) for the guest. False when dropped.
+    bool receive(const uint8_t* frame, size_t size) {
+        if(!connected_ || size < 14 || size > 1514 || queuedRx >= kMaxRx) { ++rxDropped_; return false; }
+        const size_t p = size - 14;
+        std::vector<uint8_t> m(60, 0);
+        put(m, 0, 0x2000);                  // status: RFC 1042 (the ROM strips SNAP)
+        m[6] = 27; m[7] = 80; m[8] = 110;   // silence, signal, 11 Mbit/s
+        m[14] = 0x08; m[15] = 0x02;         // frame control: data, FromDS
+        std::memcpy(&m[18], frame, 6);      // address1: destination
+        std::memcpy(&m[24], kBssid, 6);     // address2: BSSID
+        std::memcpy(&m[30], frame + 6, 6);  // address3: source
+        put(m, 44, uint16_t(8 + p));
+        std::memcpy(&m[46], frame, 6);
+        std::memcpy(&m[52], frame + 6, 6);
+        m[58] = uint8_t((8 + p) >> 8); m[59] = uint8_t(8 + p);
+        const uint8_t snap[6] = {0xaa, 0xaa, 0x03, 0, 0, 0};
+        try {
+            m.insert(m.end(), snap, snap + 6);
+            m.insert(m.end(), frame + 12, frame + size);
+            push(std::move(m), true);
+        } catch(...) { ++rxDropped_; return false; }
+        return true;
+    }
+
+    bool isEnabled() const { return enabled_; }
+    bool linkUp() const { return connected_; }
+    size_t queuedMessages() const { return fifo.size(); }
+    unsigned rxDropped() const { return rxDropped_; }
+    unsigned txFrames() const { return txFrames_; }
+    unsigned txDropped() const { return txDropped_; }
+    unsigned busAddress() const { return address; }
+
+    // Bus reset: default address, unconfigured, queues empty. Firmware state stays.
+    void busReset() {
+        address = configuration = 0; haltIn = haltOut = false; outToggle = false;
+        phase = Phase::idle; pending = Action::none; data.clear(); cached.clear(); haveCache = false;
+        fifo.clear(); queuedRx = 0; queuedBytes = 0; acc.clear(); skip = 0;
+    }
+    // Unplug: a bus reset and the power-on firmware state.
+    void detach() { busReset(); resetConfig(); }
+
+    // The writable RIDs and the link state. The bus state and the queues are not saved.
+    std::vector<uint8_t> save() const {
+        std::vector<uint8_t> v{'P', '2', 'A', 'D', 1, uint8_t((enabled_ ? 1 : 0) | (connected_ ? 2 : 0))};
+        v.push_back(uint8_t(rids.size())); v.push_back(0);
+        for(const auto& [rid, d] : rids) {
+            v.push_back(uint8_t(rid)); v.push_back(uint8_t(rid >> 8));
+            v.push_back(uint8_t(d.size())); v.push_back(0);
+            v.insert(v.end(), d.begin(), d.end());
+        }
+        return v;
+    }
+    // All or nothing. Leaves the bus idle, so call it after the host side has reset.
+    bool load(const uint8_t* b, size_t n) {
+        if(n < 8 || std::memcmp(b, "P2AD", 4) || b[4] != 1 || (b[5] & ~3) || b[7]) return false;
+        const bool en = b[5] & 1, up = b[5] & 2;
+        if(up && !en) return false;
+        if(b[6] != kRids.size()) return false;
+        std::map<uint16_t, std::vector<uint8_t>> in;
+        size_t o = 8;
+        for(size_t k = 0; k < kRids.size(); ++k) {
+            if(o + 4 > n) return false;
+            const uint16_t rid = uint16_t(b[o] | (b[o + 1] << 8));
+            const size_t len = b[o + 2] | (b[o + 3] << 8);
+            o += 4;
+            const RidInfo* info = find(rid);
+            if(!info || len != info->cap || o + len > n || in.count(rid)) return false;
+            in[rid].assign(b + o, b + o + len); o += len;
+        }
+        if(o != n) return false;
+        busReset();
+        rids = std::move(in); enabled_ = en; connected_ = up;
+        return true;
+    }
+
+    // Reply and Packet use the HostReply/HostPacket shape, without a core dependency.
+    template<class Reply, class Packet> Reply packet(const Packet& p) noexcept {
+        try { return packetImpl<Reply>(p); }
+        catch(...) {
+            phase = Phase::stall; pending = Action::none;
+            return Reply{decltype(Reply{}.result)::stall, p.toggle, {}};
+        }
+    }
+
+ private:
+    struct RidInfo { uint16_t rid; uint8_t cap; uint16_t def; };
+    // Writable RIDs: capacity in bytes and the default first word.
+    static constexpr std::array<RidInfo, 18> kRids = {{
+        {0xfc00, 2, 1}, {0xfc02, 34, 0}, {0xfc03, 2, 3}, {0xfc04, 34, 0}, {0xfc05, 2, 0},
+        {0xfc07, 2, 2304}, {0xfc09, 2, 0}, {0xfc23, 2, 0}, {0xfc24, 14, 0}, {0xfc25, 14, 0},
+        {0xfc26, 14, 0}, {0xfc27, 14, 0}, {0xfc28, 2, 0}, {0xfc2a, 2, 1}, {0xfc42, 2, 0},
+        {0xfc83, 2, 2347}, {0xfc84, 2, 15}, {0xfce5, 38, 0}}};
+    static constexpr size_t kMaxRx = 32;
+    static constexpr size_t kMaxQueued = 256 * 1024;
+    static constexpr uint8_t kBssid[6] = {0x02, 0x46, 0x52, 0x4f, 0x4e, 0x44};
+    enum class Phase { idle, read, statusIn, statusOut, doneIn, doneOut, stall };
+    enum class Action { none, address, configure, interface, halt, clear };
+    struct Message { std::vector<uint8_t> bytes; size_t pos = 0; bool rx = false; };
+
+    static const RidInfo* find(uint16_t rid) {
+        for(const auto& r : kRids) if(r.rid == rid) return &r;
+        return nullptr;
+    }
+    static void put(std::vector<uint8_t>& v, size_t o, uint16_t x) { v[o] = uint8_t(x); v[o + 1] = uint8_t(x >> 8); }
+    static void add(std::vector<uint8_t>& v, uint16_t x) { v.push_back(uint8_t(x)); v.push_back(uint8_t(x >> 8)); }
+    static uint16_t get(const std::vector<uint8_t>& v, size_t o) { return uint16_t(v[o] | (v[o + 1] << 8)); }
+
+    Mac mac{{0x02, 0, 0, 0, 0, 1}};
+    TxSink txSink;
+    std::map<uint16_t, std::vector<uint8_t>> rids;
+    bool enabled_ = false, connected_ = false;
+    unsigned address = 0, configuration = 0, value = 0, index = 0;
+    bool haltIn = false, haltOut = false, outToggle = false, controlToggle = true, needZlp = false;
+    bool haveCache = false, cacheToggle = false;
+    Phase phase = Phase::idle;
+    Action pending = Action::none;
+    size_t offset = 0, skip = 0;
+    std::vector<uint8_t> data, cached, acc;
+    std::deque<Message> fifo;
+    size_t queuedRx = 0, queuedBytes = 0;
+    unsigned rxDropped_ = 0, txFrames_ = 0, txDropped_ = 0;
+
+    void resetConfig() {
+        rids.clear();
+        for(const auto& r : kRids) {
+            auto& d = rids[r.rid]; d.assign(r.cap, 0);
+            d[0] = uint8_t(r.def); d[1] = uint8_t(r.def >> 8);
+        }
+        enabled_ = connected_ = false;
+    }
+
+    // Queues a message for bulk IN. A multiple of 64 gets one pad byte, since the host
+    // ignores zero-length packets and would not see the end.
+    void push(std::vector<uint8_t> m, bool rx = false) {
+        if(!rx && queuedBytes > kMaxQueued) return;
+        if(m.size() % 64 == 0) m.push_back(0);
+        queuedBytes += m.size();
+        if(rx) ++queuedRx;
+        fifo.push_back(Message{std::move(m), 0, rx});
+    }
+    void popFront() {
+        queuedBytes -= fifo.front().bytes.size();
+        if(fifo.front().rx) --queuedRx;
+        fifo.pop_front();
+    }
+    void respond(uint16_t type, uint16_t status) {
+        std::vector<uint8_t> m;
+        add(m, type); add(m, status); add(m, 0); add(m, 0); add(m, 0);
+        push(std::move(m));
+    }
+    void info(uint16_t type, const std::vector<uint8_t>& body) {
+        std::vector<uint8_t> m;
+        add(m, 0x8000); add(m, uint16_t(1 + body.size() / 2)); add(m, type);
+        m.insert(m.end(), body.begin(), body.end());
+        push(std::move(m));
+    }
+    void linkStatus(uint16_t s) { std::vector<uint8_t> b; add(b, s); info(0xf200, b); }
+
+    // Bytes the message needs (0 while undecided, SIZE_MAX when the framing is invalid) and
+    // the length the host pads from.
+    size_t need(size_t& padBase) const {
+        if(acc.size() < 2) return 0;
+        switch(get(acc, 0)) {
+            case 1: padBase = 10; return 10;
+            case 2: {
+                if(acc.size() < 4) return 0;
+                const unsigned f = get(acc, 2);
+                if(f < 1 || f > 29) return SIZE_MAX;
+                padBase = 6 + 2 * f; return 4 + 2 * f;
+            }
+            case 3:
+                if(acc.size() < 4) return 0;
+                if(get(acc, 2) != 2) return SIZE_MAX;
+                padBase = 6; return 6;
+            case 0: {
+                if(acc.size() < 60) return 0;
+                const size_t n = (acc[58] << 8) | acc[59];
+                if(n < 8 || n > 1540) return SIZE_MAX;
+                padBase = 60 + n; return 60 + n;
+            }
+            default: return SIZE_MAX;
+        }
+    }
+    // Takes one bulk OUT packet. False when the framing is broken.
+    bool feed(const std::vector<uint8_t>& b, bool last) {
+        const size_t from = std::min(skip, b.size());
+        skip -= from;
+        acc.insert(acc.end(), b.begin() + from, b.end());
+        for(;;) {
+            size_t padBase = 0;
+            const size_t len = need(padBase);
+            if(len == SIZE_MAX) { acc.clear(); skip = 0; return false; }
+            if(!len || acc.size() < len) break;
+            const std::vector<uint8_t> msg(acc.begin(), acc.begin() + len);
+            const size_t padded = (padBase + 63) & ~size_t(63);
+            if(acc.size() >= padded) acc.erase(acc.begin(), acc.begin() + padded);
+            else { skip = padded - acc.size(); acc.clear(); }
+            handle(msg);
+        }
+        if(last) { acc.clear(); skip = 0; }  // a short packet ends the transfer
+        return true;
+    }
+
+    void handle(const std::vector<uint8_t>& m) {
+        switch(get(m, 0)) {
+            case 1: command(get(m, 2), get(m, 4)); break;
+            case 2: writeRid(get(m, 2), get(m, 4), m); break;
+            case 3: readRid(get(m, 4)); break;
+            case 0: transmit(m); break;
+        }
+    }
+
+    void command(uint16_t cmd, uint16_t p0) {
+        const uint16_t code = cmd & 0x3f, err = 0x7f00 | code;
+        switch(code) {
+            case 0x00: fifo.clear(); queuedRx = queuedBytes = 0; resetConfig(); respond(0x8001, code); break;
+            case 0x01:
+                if(p0) { respond(0x8001, err); break; }
+                respond(0x8001, code);
+                if(!enabled_) { enabled_ = true; evaluateLink(); }
+                break;
+            case 0x02:
+                if(p0) { respond(0x8001, err); break; }
+                respond(0x8001, code); enabled_ = connected_ = false;
+                break;
+            case 0x11:
+                if(p0 == 0xf100) {
+                    respond(0x8001, code);
+                    info(0xf100, std::vector<uint8_t>(84, 0));  // 21 little-endian 32-bit counters
+                } else if(p0 == 0xf200) {
+                    respond(0x8001, code); linkStatus(connected_ ? 1 : 2);
+                } else respond(0x8001, err);
+                break;
+            default: respond(0x8001, err);
+        }
+    }
+    // Connected after Enable for an ad hoc network, or when the desired SSID is empty or "Frond".
+    void evaluateLink() {
+        const auto& ssid = rids[0xfc02];
+        const unsigned len = get(ssid, 0);
+        const bool adhoc = get(rids[0xfc00], 0) == 0;
+        const bool match = len == 0 || (len == 5 && !std::memcmp(&ssid[2], "Frond", 5));
+        if(adhoc || match) { connected_ = true; linkStatus(1); }
+    }
+    void writeRid(uint16_t frmlen, uint16_t rid, const std::vector<uint8_t>& m) {
+        const RidInfo* known = find(rid);
+        const size_t n = size_t(frmlen - 1) * 2;
+        if(!known || n > known->cap) { respond(0x8002, 0x7f00); return; }
+        auto& d = rids[rid];
+        std::fill(d.begin(), d.end(), 0);
+        std::copy(m.begin() + 6, m.begin() + 6 + n, d.begin());
+        respond(0x8002, 0);
+    }
+    // FD89: header word 0 is the record stride in bytes, then 64-byte records.
+    std::vector<uint8_t> scanRecords() const {
+        std::vector<uint8_t> v;
+        const bool hit = (get(rids.at(0xfce5), 0) & 0x20) && get(rids.at(0xfc00), 0) != 0;
+        add(v, 64); add(v, 0);
+        if(!hit) return v;
+        std::vector<uint8_t> r(64, 0);
+        put(r, 0, 6); put(r, 2, 27); put(r, 4, 80);
+        std::memcpy(&r[6], kBssid, 6);
+        put(r, 12, 100); put(r, 14, 1); put(r, 16, 5);
+        std::memcpy(&r[18], "Frond", 5);
+        const uint8_t rates[4] = {0x82, 0x84, 0x8b, 0x96};
+        std::memcpy(&r[50], rates, 4);
+        put(r, 60, 110);
+        v.insert(v.end(), r.begin(), r.end());
+        return v;
+    }
+    void readRid(uint16_t rid) {
+        std::vector<uint8_t> d;
+        bool known = true;
+        const bool adhoc = get(rids[0xfc00], 0) == 0;
+        switch(rid) {
+            case 0xfc01: d.assign(mac.begin(), mac.end()); break;
+            case 0xfd41:
+                d.assign(34, 0);
+                if(connected_) {
+                    const auto& s = rids[0xfc02];
+                    const unsigned len = std::min<unsigned>(get(s, 0), 32);
+                    if(adhoc && len) { put(d, 0, uint16_t(len)); std::memcpy(&d[2], &s[2], len); }
+                    else { put(d, 0, 5); std::memcpy(&d[2], "Frond", 5); }
+                }
+                break;
+            case 0xfd42: d.assign(6, 0); if(connected_) std::memcpy(d.data(), kBssid, 6); break;
+            case 0xfd43: d.assign(6, 0); if(connected_) { put(d, 0, 92); put(d, 2, 154); put(d, 4, 27); } break;
+            case 0xfd44: d.assign(2, 0); if(connected_) put(d, 0, 8); break;
+            case 0xfdc1: d.assign(2, 0); if(connected_) put(d, 0, adhoc ? get(rids[0xfc03], 0) : 6); break;
+            case 0xfd89: d = scanRecords(); break;
+            default:
+                if(find(rid)) d = rids[rid]; else known = false;
+        }
+        std::vector<uint8_t> m;
+        add(m, 0x8003);
+        if(!known) { add(m, 1); add(m, rid); push(std::move(m)); return; }  // an empty record
+        add(m, uint16_t(1 + d.size() / 2)); add(m, rid);
+        m.insert(m.end(), d.begin(), d.end());
+        push(std::move(m));
+    }
+    // 802.3 with SNAP to Ethernet II. The length at +58 is 8 plus the payload.
+    void transmit(const std::vector<uint8_t>& m) {
+        const size_t n = (m[58] << 8) | m[59];
+        static const uint8_t snap[6] = {0xaa, 0xaa, 0x03, 0, 0, 0};
+        if(!enabled_ || n - 8 > 1500 || std::memcmp(&m[60], snap, 6)) { ++txDropped_; return; }
+        std::vector<uint8_t> f(m.begin() + 46, m.begin() + 58);
+        f.insert(f.end(), m.begin() + 66, m.end());
+        ++txFrames_;
+        if(txSink) txSink(f);
+    }
+
+    template<class Reply, class Packet> Reply packetImpl(const Packet& p) {
+        using Result = decltype(Reply{}.result);
+        auto reply = [&](Result r) { return Reply{r, p.toggle, {}}; };
+        if(p.lowSpeed || p.address != address) return reply(Result::noAnswer);
+        if(p.endpoint) {
+            if(!configuration) return reply(Result::stall);
+            if(p.endpoint == 1 && p.direction == 2) {
+                // The data toggle follows the host's, so a repeated configuration keeps it.
+                if(haltIn) return reply(Result::stall);
+                if(!p.requested || p.requested > 64) { haltIn = true; return reply(Result::stall); }
+                if(fifo.empty()) return reply(Result::nak);
+                Message& m = fifo.front();
+                const size_t n = std::min<size_t>(std::min<size_t>(64, p.requested), m.bytes.size() - m.pos);
+                std::vector<uint8_t> out(m.bytes.begin() + m.pos, m.bytes.begin() + m.pos + n);
+                m.pos += n;
+                if(m.pos == m.bytes.size()) popFront();
+                return Reply{Result::ack, p.toggle, std::move(out)};
+            }
+            if(p.endpoint == 2 && p.direction == 1) {
+                if(haltOut) return reply(Result::stall);
+                if(p.bytes.size() != p.requested || p.requested > 64) { haltOut = true; return reply(Result::stall); }
+                if(p.toggle != outToggle) return reply(Result::ack);  // repeat of an accepted packet
+                if(!feed(p.bytes, p.bytes.size() < 64)) { haltOut = true; return reply(Result::stall); }
+                outToggle = !outToggle;
+                return reply(Result::ack);
+            }
+            return reply(Result::stall);
+        }
+        if(p.direction == 0) {
+            if(p.toggle || p.requested != 8 || p.bytes.size() != 8) return reply(Result::noAnswer);
+            phase = Phase::stall; pending = Action::none; data.clear(); cached.clear(); haveCache = false;
+            offset = 0; controlToggle = true;
+            try { setup(p.bytes); } catch(...) { phase = Phase::stall; }
+            return reply(Result::ack);
+        }
+        if(phase == Phase::stall) return reply(Result::stall);
+        if(p.direction == 2 && haveCache && p.toggle == cacheToggle) {
+            if(cached.size() > p.requested) return reply(Result::stall);
+            return Reply{Result::ack, p.toggle, cached};
+        }
+        if(phase == Phase::read && p.direction == 2 && p.toggle == controlToggle) {
+            const size_t n = std::min<size_t>(64, data.size() - offset);
+            if(p.requested < n) return reply(Result::stall);
+            cached.assign(data.begin() + offset, data.begin() + offset + n);
+            cacheToggle = p.toggle; haveCache = true; offset += n; controlToggle = !controlToggle;
+            if(n < 64 || (offset == data.size() && !needZlp)) phase = Phase::statusOut;
+            return Reply{Result::ack, p.toggle, cached};
+        }
+        if((phase == Phase::statusOut || phase == Phase::doneOut) && p.direction == 1 &&
+           p.toggle && !p.requested && p.bytes.empty()) {
+            phase = Phase::doneOut; return reply(Result::ack);
+        }
+        if(phase == Phase::statusIn && p.direction == 2 && p.toggle && p.requested == 0) {
+            apply(); phase = Phase::doneIn; cached.clear(); cacheToggle = true; haveCache = true;
+            return reply(Result::ack);
+        }
+        phase = Phase::stall; return reply(Result::stall);
+    }
+
+    void apply() {
+        switch(pending) {
+            case Action::address: address = value; break;
+            case Action::configure:
+                // The same configuration again keeps the bulk toggles, as the Dana's bus driver expects.
+                if(value != configuration) {
+                    configuration = value; haltIn = haltOut = false; outToggle = false;
+                    fifo.clear(); queuedRx = queuedBytes = 0; acc.clear(); skip = 0;
+                }
+                break;
+            case Action::interface: haltIn = haltOut = false; outToggle = false; acc.clear(); skip = 0; break;
+            case Action::halt: (index == 0x81 ? haltIn : haltOut) = true; break;
+            case Action::clear:
+                if(index == 0x81) haltIn = false;
+                else { haltOut = false; outToggle = false; acc.clear(); skip = 0; }
+                break;
+            default: break;
+        }
+        pending = Action::none;
+    }
+    static bool endpointKnown(unsigned i) { return i == 0x81 || i == 0x02; }
+    void setup(const std::vector<uint8_t>& b) {
+        const unsigned type = b[0], r = b[1], v = b[2] | (b[3] << 8), i = b[4] | (b[5] << 8), len = b[6] | (b[7] << 8);
+        value = v; index = i;
+        bool ok = false;
+        if(type == 0x80 && r == 6 && i == 0) {
+            if(v == 0x100) {
+                data = {18, 1, 0x10, 0x01, 0, 0, 0, 64, 0x5e, 0x04, 0x6e, 0x00, 0x00, 0x01, 0, 0, 0, 1}; ok = true;
+            }
+            if(v == 0x200) {
+                data = {9, 2, 32, 0, 1, 1, 0, 0x80, 0xfa,
+                        9, 4, 0, 0, 2, 0xff, 0xff, 0xff, 0,
+                        7, 5, 0x81, 2, 64, 0, 0,
+                        7, 5, 0x02, 2, 64, 0, 0};
+                ok = true;
+            }
+        } else if(type == 0 && r == 5 && v < 128 && !i && !len && !configuration) {
+            pending = Action::address; ok = true;
+        } else if(type == 0 && r == 9 && v <= 1 && !i && !len && address) {
+            pending = Action::configure; ok = true;
+        } else if(type == 0x80 && r == 8 && !v && !i && len == 1 && address) {
+            data = {uint8_t(configuration)}; ok = true;
+        } else if(type == 0x81 && r == 10 && !v && !i && len == 1 && configuration) {
+            data = {0}; ok = true;
+        } else if(type == 1 && r == 11 && !v && !i && !len && configuration) {
+            pending = Action::interface; ok = true;
+        } else if(r == 0 && !v && len == 2 &&
+                  ((type == 0x80 && !i) || (type == 0x81 && !i && configuration) ||
+                   (type == 0x82 && (i == 0 || i == 0x80 || (configuration && endpointKnown(i)))))) {
+            data = {uint8_t(type == 0x82 && ((i == 0x81 && haltIn) || (i == 0x02 && haltOut))), 0}; ok = true;
+        } else if(type == 2 && (r == 1 || r == 3) && !v && !len && configuration && endpointKnown(i)) {
+            pending = r == 1 ? Action::clear : Action::halt; ok = true;
+        }
+        if(!ok) return;
+        if(type & 0x80) {
+            if(data.size() > len) data.resize(len);
+            needZlp = data.size() < len && data.size() % 64 == 0;
+            phase = len ? Phase::read : Phase::statusOut;
+        } else phase = Phase::statusIn;
+    }
+};
