+inline SiblingStatus checkSdSibling(const std::filesystem::path& path, const Media& card) {
+    std::ifstream in(path, std::ios::binary);
+    uint8_t header[frondSdFile::headerBytes];
+    if (!in || !in.read(reinterpret_cast<char*>(header), sizeof(header))) return SiblingStatus::malformed;
+    uint64_t payloadBytes = 0;
+    uint32_t crc = 0;
+    if (!frondSdFile::parseHeader(header, payloadBytes, crc)) return SiblingStatus::malformed;
+    in.seekg(0, std::ios::end);
+    const auto n = in.tellg();
+    if (n < 0 || uint64_t(n) != frondSdFile::headerBytes + payloadBytes) return SiblingStatus::malformed;
+    if (payloadBytes != card.physicalSize || card.logicalSize != card.physicalSize)
+        return SiblingStatus::mismatch;
+    in.seekg(frondSdFile::headerBytes);
+    uint32_t got = 0;
+    uint8_t chunk[65536];
+    uint64_t left = payloadBytes;
+    while (left) {
+        const auto want = std::min(left, uint64_t(sizeof(chunk)));
+        if (!in.read(reinterpret_cast<char*>(chunk), std::streamsize(want))) return SiblingStatus::malformed;
+        got = mz_crc32(got, chunk, static_cast<size_t>(want));
+        left -= want;
+    }
+    return got == crc ? SiblingStatus::ok : SiblingStatus::malformed;
+}
