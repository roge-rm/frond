@@ -0,0 +1,59 @@
+#ifndef FROND_IR_IRPHONE_H
+#define FROND_IR_IRPHONE_H
+
+// A mobile phone with a data modem, reached over infrared: the IrLAP secondary, IrLMP, IAS,
+// Tiny TP and IrCOMM, with the IrCOMM port joined to a HayesModem whose calls go to a
+// ModemLine. The core feeds it the guest's IR transmitter bytes (Write), drains its receiver
+// bytes (Read) and calls Service between slices. Single-threaded; time is guest nanoseconds.
+
+#include <cstddef>
+#include <cstdint>
+
+#include "Ias.h"
+#include "IrComm.h"
+#include "IrLap.h"
+#include "IrLmp.h"
+#include "modem/HayesModem.h"
+
+namespace frondIr {
+
+class IrPhone : private IrCommPort {
+   public:
+    struct Options {
+        IrLap::Options lap;
+        frondModem::HayesModem::Options modem;
+    };
+
+    explicit IrPhone(frondModem::ModemLine& line);
+    IrPhone(frondModem::ModemLine& line, Options options);
+
+    void Write(const uint8_t* data, size_t size, uint64_t now) { lap.Receive(data, size, now); }
+    size_t Read(uint8_t* data, size_t max, uint64_t now) { return lap.Read(data, max, now); }
+    size_t Available(uint64_t now) const { return lap.Available(now); }
+    void Service(uint64_t now);
+    // After a session load: no link, no call.
+    void Drop(uint64_t now) { lap.Drop(now); }
+
+    const IrLap& Lap() const { return lap; }
+    const IrComm& Comm() const { return comm; }
+    const IasServer& Ias() const { return ias; }
+    const frondModem::HayesModem& Modem() const { return modem; }
+
+   private:
+    void Opened(uint64_t now) override;
+    void Closed(uint64_t now) override;
+    void FromGuest(const uint8_t* data, size_t size, uint64_t now) override;
+    size_t ToGuest(uint8_t* data, size_t max, uint64_t now) override;
+    void GuestLines(bool dtr, bool rts, uint64_t now) override;
+    uint8_t Lines(uint64_t now) override;
+
+    frondModem::HayesModem modem;
+    IrLmp lmp;
+    IrLap lap;
+    IasServer ias;
+    IrComm comm;
+};
+
+}  // namespace frondIr
+
+#endif
diff --git a/src/common/ir/Sir.cpp b/src/common/ir/Sir.cpp
new file mode 100644
index 0000000..962a200
--- /dev/null
+++ b/src/common/ir/Sir.cpp
@@ -0,0 +1,76 @@
+#include "Sir.h"
+
+namespace frondIr {
+
+namespace {
+
+constexpr uint8_t xbof = 0xff, bof = 0xc0, eof = 0xc1, escape = 0x7d;
+
+void Put(uint8_t byte, std::vector<uint8_t>& out) {
+    if (byte == bof || byte == eof || byte == escape) {
+        out.push_back(escape);
+        out.push_back(byte ^ 0x20);
+    } else {
+        out.push_back(byte);
+    }
+}
+
+}  // namespace
+
+uint16_t Fcs16(const uint8_t* data, size_t size, uint16_t fcs) {
+    for (size_t i = 0; i < size; ++i) {
+        fcs ^= data[i];
+        for (int bit = 0; bit < 8; ++bit) fcs = (fcs & 1) ? (fcs >> 1) ^ 0x8408 : fcs >> 1;
+    }
+    return fcs;
+}
+
+void SirWrap(const uint8_t* frame, size_t size, unsigned extraBofs, std::vector<uint8_t>& out) {
+    out.insert(out.end(), extraBofs, xbof);
+    out.push_back(bof);
+    for (size_t i = 0; i < size; ++i) Put(frame[i], out);
+    const uint16_t fcs = ~Fcs16(frame, size);
+    Put(fcs & 0xff, out);
+    Put(fcs >> 8, out);
+    out.push_back(eof);
+}
+
+bool SirUnwrapper::Feed(uint8_t byte) {
+    if (byte == bof) {
+        // A BOF inside a frame starts it over; several BOFs in a row are allowed.
+        inFrame = true;
+        escaped = false;
+        frame.clear();
+        return false;
+    }
+    if (!inFrame) return false;
+    if (byte == eof) {
+        inFrame = false;
+        if (escaped || frame.size() < 4 || Fcs16(frame.data(), frame.size()) != fcsGood) {
+            ++bad;
+            return false;
+        }
+        done.assign(frame.begin(), frame.end() - 2);
+        return true;
+    }
+    if (byte == escape) {
+        escaped = true;
+        return false;
+    }
+    if (escaped) byte ^= 0x20;
+    escaped = false;
+    if (frame.size() >= maxFrame) {
+        ++bad;
+        inFrame = false;
+        return false;
+    }
+    frame.push_back(byte);
+    return false;
+}
+
+void SirUnwrapper::Reset() {
+    inFrame = escaped = false;
+    frame.clear();
+}
+
+}  // namespace frondIr
diff --git a/src/common/ir/Sir.h b/src/common/ir/Sir.h
new file mode 100644
index 0000000..c1d1d48
--- /dev/null
+++ b/src/common/ir/Sir.h
@@ -0,0 +1,48 @@
+#ifndef FROND_IR_SIR_H
+#define FROND_IR_SIR_H
+
+// SIR framing for IrLAP (IrDA Physical Layer 1.4, section 5): extra BOFs (0xff), BOF (0xc0),
+// the frame with 0xc0, 0xc1 and 0x7d escaped as 0x7d then the byte xor 0x20, the FCS-16 low
+// byte first, then EOF (0xc1).
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+namespace frondIr {
+
+using Bytes = std::vector<uint8_t>;
+
+// CRC-CCITT as IrLAP uses it, starting at 0xffff. A frame with its FCS gives fcsGood.
+uint16_t Fcs16(const uint8_t* data, size_t size, uint16_t fcs = 0xffff);
+constexpr uint16_t fcsGood = 0xf0b8;
+
+// Appends one wrapped frame (address, control and information, no FCS) to out.
+void SirWrap(const uint8_t* frame, size_t size, unsigned extraBofs, std::vector<uint8_t>& out);
+inline void SirWrap(const Bytes& frame, unsigned extraBofs, std::vector<uint8_t>& out) {
+    SirWrap(frame.data(), frame.size(), extraBofs, out);
+}
+
+// Takes raw SIR bytes and gives whole frames with a good FCS, without the FCS.
+class SirUnwrapper {
+   public:
+    // The largest frame taken: 2048 bytes of information, address, control and FCS.
+    static constexpr size_t maxFrame = 2048 + 4;
+
+    // True when byte ended a good frame, which is then in Frame().
+    bool Feed(uint8_t byte);
+    const Bytes& Frame() const { return done; }
+    // Frames dropped for a bad FCS, a short frame or one too long.
+    unsigned BadFrames() const { return bad; }
+    void Reset();
+
+   private:
+    bool inFrame{false}, escaped{false};
+    Bytes frame, done;
+    unsigned bad{0};
+};
+
+}  // namespace frondIr
+
+#endif
diff --git a/src/common/ir/TinyTp.cpp b/src/common/ir/TinyTp.cpp
new file mode 100644
index 0000000..8f7c90e
--- /dev/null
+++ b/src/common/ir/TinyTp.cpp
@@ -0,0 +1,115 @@
+#include "TinyTp.h"
+
+#include <algorithm>
+
+namespace frondIr {
+
+namespace {
+
+// First byte of each PDU: more-to-come (data) or parameters-present (connect), then credit.
+constexpr uint8_t flagBit = 0x80, creditMask = 0x7f;
+constexpr uint8_t piMaxSdu = 0x01;
+// Reassembled SDUs past this are dropped.
+constexpr size_t reassemblyLimit = 4096;
+// I frames queued at IrLAP before Tiny TP holds back, so a poll isn't flooded.
+constexpr size_t lapBacklog = 7;
+
+}  // namespace
+
+TinyTp::TinyTp(IrLmp& lmp, uint8_t lsap, TinyTpUser& user) : lmp(lmp), lsap(lsap), user(user) {
+    lmp.Bind(lsap, *this);
+}
+
+size_t TinyTp::MaxSdu() const {
+    const size_t pdu = lmp.MaxData() - 1;
+    return guestMaxSdu ? std::min(pdu, guestMaxSdu) : pdu;
+}
+
+void TinyTp::Send(Bytes sdu) { queue.push_back(std::move(sdu)); }
+
+bool TinyTp::Connect(const Bytes& data, Bytes& reply, uint64_t now) {
+    if (data.empty()) return false;
+    sendCredit = data[0] & creditMask;
+    guestMaxSdu = 0;
+    size_t i = 1;
+    if (data[0] & flagBit) {
+        // Parameters: their length, then PI, PL, PV; only MaxSduSize is defined.
+        const size_t length = i < data.size() ? data[i++] : 0;
+        const size_t end = std::min(data.size(), i + length);
+        while (i + 2 <= end) {
+            const uint8_t pi = data[i], pl = data[i + 1];
+            if (i + 2 + pl > end) break;
+            if (pi == piMaxSdu) {
+                size_t value = 0;
+                for (size_t k = 0; k < pl; ++k) value = value << 8 | data[i + 2 + k];
+                guestMaxSdu = value;
+            }
+            i += 2 + pl;
+        }
+        i = end;
+    }
+    Bytes userReply;
+    if (!user.Connect(Bytes(data.begin() + std::min(i, data.size()), data.end()), userReply, now)) return false;
+    remoteCredit = initialCredit;
+    freeCredit = 0;
+    queue.clear();
+    reassembly.clear();
+    // We send no parameters, so the guest's SDUs should fit one PDU; segmented ones are
+    // reassembled anyway.
+    reply.push_back(uint8_t(initialCredit));
+    reply.insert(reply.end(), userReply.begin(), userReply.end());
+    return true;
+}
+
+void TinyTp::Data(const Bytes& data, uint64_t now) {
+    if (data.empty()) return;
+    sendCredit = std::min(127u, sendCredit + (data[0] & creditMask));
+    // A PDU with no user data is a credit update and uses no credit.
+    if (data.size() == 1) return;
+    if (remoteCredit) --remoteCredit;
+    ++freeCredit;
+    reassembly.insert(reassembly.end(), data.begin() + 1, data.end());
+    if (reassembly.size() > reassemblyLimit) {
+        reassembly.clear();
+        return;
+    }
+    if (data[0] & flagBit) return;
+    Bytes sdu;
+    sdu.swap(reassembly);
+    user.Data(sdu, now);
+}
+
+void TinyTp::Disconnect(uint64_t now) {
+    queue.clear();
+    reassembly.clear();
+    sendCredit = remoteCredit = freeCredit = 0;
+    user.Disconnect(now);
+}
+
+void TinyTp::Pump(uint64_t now) {
+    user.Pump(now);
+    Flush();
+}
+
+void TinyTp::Flush() {
+    while (!queue.empty() && sendCredit && lmp.Queued() < lapBacklog) {
+        const uint8_t give = uint8_t(std::min(freeCredit, 127u));
+        Bytes pdu{give};
+        pdu.insert(pdu.end(), queue.front().begin(), queue.front().end());
+        queue.pop_front();
+        --sendCredit;
+        freeCredit -= give;
+        remoteCredit += give;
+        lmp.Send(lsap, pdu.data(), pdu.size());
+    }
+    // With nothing to carry it, freed credit goes in a dataless PDU once the guest runs low.
+    if (freeCredit && remoteCredit <= initialCredit / 2) {
+        const uint8_t give = uint8_t(std::min(freeCredit, 127u));
+        const Bytes pdu{give};
+        freeCredit -= give;
+        remoteCredit += give;
+        lmp.Send(lsap, pdu.data(), pdu.size());
+    }
+}
+
+}  // namespace frondIr
diff --git a/src/common/ir/TinyTp.h b/src/common/ir/TinyTp.h
new file mode 100644
index 0000000..ccd079a
--- /dev/null
+++ b/src/common/ir/TinyTp.h
@@ -0,0 +1,62 @@
+#ifndef FROND_IR_TINYTP_H
+#define FROND_IR_TINYTP_H
+
+// Tiny TP (IrDA TinyTP 1.1) on an IrLMP LSAP: credit flow control and reassembly of segmented
+// SDUs from the guest. Our own SDUs are never segmented.
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+#include "IrLmp.h"
+
+namespace frondIr {
+
+class TinyTpUser {
+   public:
+    virtual ~TinyTpUser() = default;
+    // The guest's connect user data (after Tiny TP's parameters); reply is ours.
+    virtual bool Connect(const Bytes& data, Bytes& reply, uint64_t now) = 0;
+    virtual void Data(const Bytes& sdu, uint64_t now) = 0;
+    virtual void Disconnect(uint64_t now) = 0;
+    // Room to send: queue SDUs with Send.
+    virtual void Pump(uint64_t now) {}
+};
+
+class TinyTp : public LmService {
+   public:
+    // Credit we give at the start and keep topped up: SDUs the guest may send unanswered.
+    static constexpr unsigned initialCredit = 7;
+
+    TinyTp(IrLmp& lmp, uint8_t lsap, TinyTpUser& user);
+
+    // Queues an SDU of at most MaxSdu() bytes; it goes when the guest gives credit.
+    void Send(Bytes sdu);
+    size_t MaxSdu() const;
+    // SDUs waiting for credit.
+    size_t Queued() const { return queue.size(); }
+    unsigned SendCredit() const { return sendCredit; }
+    bool Connected() const { return lmp.Connected(lsap); }
+    void Disconnect(uint8_t reason, uint64_t now) { lmp.Disconnect(lsap, reason, now); }
+
+    bool Connect(const Bytes& data, Bytes& reply, uint64_t now) override;
+    void Data(const Bytes& data, uint64_t now) override;
+    void Disconnect(uint64_t now) override;
+    void Pump(uint64_t now) override;
+
+   private:
+    void Flush();
+
+    IrLmp& lmp;
+    uint8_t lsap;
+    TinyTpUser& user;
+    // Credit the guest gave us, credit we gave it and haven't seen used, and credit freed since.
+    unsigned sendCredit{0}, remoteCredit{0}, freeCredit{0};
+    size_t guestMaxSdu{0};
+    std::deque<Bytes> queue;
+    Bytes reassembly;
+};
+
+}  // namespace frondIr
+
+#endif
