+    for (int i = 0; i < 8; i++) boot[54 + i] = type[i];
+    boot[510] = 0x55; boot[511] = 0xaa;
+    for (unsigned fat = 0; fat < 2; fat++) {
+        auto* data = image.data() + (start + 1 + fat * fatSectors) * 512;
