+    for (int i = 0; i < 8; i++) boot[3 + i] = oem[i];
+    put16(boot + 11, 512); boot[13] = cluster; put16(boot + 14, 1);
+    boot[16] = 2; put16(boot + 17, 512);
+    if (sectors < 65536) put16(boot + 19, sectors); else put32(boot + 32, sectors);
